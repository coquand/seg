-- CPostBox.seg (L9): the open box over [m] * Y for a poset Y with a
-- height and a sieve QY (POSTNIKOV-INFORMAL.md, the second inverse
-- homotopy), for any type B with face-uniform fillers at the end e.
--
--   a0 W g        the lid at s = e, a map [m] * Y -> i*B
--   Ev W g b j    the end data on [m] * QY (a partial line)
--   F y           (m = m' + 1) the sides: lines over the faces [m'] * Y
--
-- BoxS (m = m' + 1) builds the side with CPostBdry.BS and fills with
-- CBoxFill; BoxZ (m = 0) has the end data only.  Outputs: the filled
-- line Thf with Thf-e (the lid), Thf-E (the end data) and Thf-face.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module PBs = CPosBase[a] ;
module SP = PBs.SP ;
module EZ = CBoxEZ[a] ;
module BD = CPostBdry[a, l] ;
module S1m = CPostStep1[a, l] ;

------------------------------------------------------------------------
-- m = m' + 1

module BoxS (G : PP.PCtx) (B : PP.PTy[G]) (e : El Iv)
  (fill : (N : Nat) -> CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].FillTy N)
  (sides : (N : Nat) (b : CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].Prob N)
           (W : Nat) (f : Hom (lin W) (lin N)) (i : CDeltaBase[a].DS.Lands W N b.2.pQ f)
           -> Id (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.EI W)
                 (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.E.act W N f
                    (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].fillE N (fill N) b))
                 (b.2.pv W f i))
  (face : (N' : Nat) (b : CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].Prob (suc N'))
          (y : Nat) (hy : IsT (leb y (suc N')))
          -> Id (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.EI N')
                (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.E.act N' (suc N') (dl N' y)
                   (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].fillE (suc N') (fill (suc N')) b))
                (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].fillE N' (fill N')
                   (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].resP N' (suc N') (dl N' y) b)))
  (m' : Nat) (Y : Ob) (htY : El Y -> Nat) (BY : Nat) (hBY : (y : El Y) -> IsT (leb (htY y) BY))
  (hmY : (y y' : El Y) -> IsT (le Y y.1 y'.1) -> IsT (leb (htY y) (htY y')))
  (hiY : (y y' : El Y) -> IsT (le Y y.1 y'.1) -> Id Nat (htY y) (htY y') -> Id Tree y.1 y'.1)
  (QY : SP.Phi Y) (xf : W0.Ix (G.ob (lin (suc m'))))
  (a0 : (W : Nat) -> Hom (lin W) (prodP (lin (suc m')) Y) -> PB.GPre[l].TyL[G, B].EI (lin W))
  (a0p : (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Y))
         -> Id (W0.Ix (G.ob (lin W))) (a0 W g).1 (G.act (lin W) (prodP (lin (suc m')) Y) g (G.act (prodP (lin (suc m')) Y) (lin (suc m')) (pr1 (lin (suc m')) Y) xf)))
  (a0n : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin (suc m')) Y))
         -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (a0 W g)) (a0 V (compH (lin V) (lin W) (prodP (lin (suc m')) Y) g h)))
  (F : (y : Nat) -> IsT (leb y (suc m')) -> (W : Nat) -> Hom (lin W) (prodP (lin m') Y) -> Hom (lin W) Iv
       -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Fp : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (prodP (lin m') Y)) (j : Hom (lin W) Iv)
        -> Id (W0.Ix (G.ob (lin W))) (F y hy W g j).1
              (G.act (lin W) (prodP (lin m') Y) g (G.act (prodP (lin m') Y) (prodP (lin (suc m')) Y) (BD.BG[m', Y].dY y)
                 (G.act (prodP (lin (suc m')) Y) (lin (suc m')) (pr1 (lin (suc m')) Y) xf))))
  (Fn : (y : Nat) (hy : IsT (leb y (suc m'))) (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin m') Y)) (j : Hom (lin W) Iv)
        -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (F y hy W g j))
              (F y hy V (compH (lin V) (lin W) (prodP (lin m') Y) g h) (compH (lin V) (lin W) Iv j h)))
  (Ev : (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Y)) -> SP.Lands (lin W) (prodP (lin (suc m')) Y) (BD.BG[m', Y].endS QY) g
        -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Evp : (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Y)) (b : SP.Lands (lin W) (prodP (lin (suc m')) Y) (BD.BG[m', Y].endS QY) g)
         (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob (lin W))) (Ev W g b j).1
           (G.act (lin W) (prodP (lin (suc m')) Y) g (G.act (prodP (lin (suc m')) Y) (lin (suc m')) (pr1 (lin (suc m')) Y) xf)))
  (Evn : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin (suc m')) Y))
         (b : SP.Lands (lin W) (prodP (lin (suc m')) Y) (BD.BG[m', Y].endS QY) g)
         (b' : SP.Lands (lin V) (prodP (lin (suc m')) Y) (BD.BG[m', Y].endS QY) (compH (lin V) (lin W) (prodP (lin (suc m')) Y) g h))
         (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (Ev W g b j))
               (Ev V (compH (lin V) (lin W) (prodP (lin (suc m')) Y) g h) b' (compH (lin V) (lin W) Iv j h)))
  (FF : (y z : Nat) (hy : IsT (leb y (suc m'))) (hz : IsT (leb z (suc m'))) (lt : IsT (ltb y z))
        (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Y))
        (msy : Miss (lin W) m' y (BD.BG[m', Y].p1g W g)) (msz : Miss (lin W) m' z (BD.BG[m', Y].p1g W g)) (j : Hom (lin W) Iv)
        -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (F y hy W (BD.BG[m', Y].gy y W g) j) (F z hz W (BD.BG[m', Y].gy z W g) j))
  (FE : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Y))
        (ms : Miss (lin W) m' y (BD.BG[m', Y].p1g W g)) (b : SP.Lands (lin W) (prodP (lin (suc m')) Y) (BD.BG[m', Y].endS QY) g)
        (j : Hom (lin W) Iv)
        -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (F y hy W (BD.BG[m', Y].gy y W g) j) (Ev W g b j))
  (aF : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Y)) (ms : Miss (lin W) m' y (BD.BG[m', Y].p1g W g))
        -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (F y hy W (BD.BG[m', Y].gy y W g) (constH (lin W) Iv e)) (a0 W g))
  (aE : (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Y)) (b : SP.Lands (lin W) (prodP (lin (suc m')) Y) (BD.BG[m', Y].endS QY) g)
        -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (Ev W g b (constH (lin W) Iv e)) (a0 W g)) {
  m : Nat = suc m' ;
  module TB = PB.GPre[l].TyL[G, B] ;
  module BG = BD.BG[m', Y] ;
  X : Ob = BG.X ;
  Xf : Ob = BG.Xf ;
  xX : W0.Ix (G.ob X) = G.act X (lin m) (pr1 (lin m) Y) xf ;
  module HM = EZ.HLin[m] ;
  module HP = EZ.HProd[lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, Y, htY, BY, hBY, hmY, hiY] ;

  module BSm = BD.BS[G, B, m', Y, QY, xX, F, Fp, Fn, Ev, Evp, Evn, FF, FE] ;
  module LidM = BSm.Lid[e, a0, aF, aE] ;

  module Bx = CBoxFill[a, l].BF[G, B, e, fill, sides, face,
    X, HP.ht, HP.B, HP.hB, HP.hm, HP.hi, xX, a0, a0p, a0n, BSm.Q, BSm.sv, BSm.svp, BSm.svn, LidM.sve] ;

  Thf (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv) : TB.EI (lin W) = Bx.Fv W g j ;

  Thf-p (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv) : Id (W0.Ix (G.ob (lin W))) (Thf W g j).1 (G.act (lin W) X g xX) = Bx.Fp W g j ;

  Thf-n (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X) (j : Hom (lin W) Iv)
    : Id (TB.EI (lin V)) (TB.E.act (lin V) (lin W) h (Thf W g j)) (Thf V (compH (lin V) (lin W) X g h) (compH (lin V) (lin W) Iv j h)) =
    Bx.Fn V W h g j ;

  Thf-e (W : Nat) (g : Hom (lin W) X) : Id (TB.EI (lin W)) (Thf W g (constH (lin W) Iv e)) (a0 W g) = Bx.Fe W g ;

  Thf-E (W : Nat) (g : Hom (lin W) X) (b : SP.Lands (lin W) X (BG.endS QY) g) (j : Hom (lin W) Iv)
    : Id (TB.EI (lin W)) (Thf W g j) (Ev W g b j) =
    transH (Bx.Fs W g (SP.lands-union-r (lin W) X BG.facesS (BG.endS QY) g b) j)
           (BSm.sv-E W g (SP.lands-union-r (lin W) X BG.facesS (BG.endS QY) g b) b j) ;

  -- the face y of g, read in [m'] * Y
  pr1gy (y W : Nat) (g : Hom (lin W) X)
    : Id (Hom (lin W) (lin m')) (compH (lin W) Xf (lin m') (pr1 (lin m') Y) (BG.gy y W g)) (compH (lin W) (lin m) (lin m') (dgH m' y) (BG.p1g W g)) =
    pr1-pair (lin m') Y (lin W) (compH (lin W) (lin m) (lin m') (dgH m' y) (BG.p1g W g)) (BG.p2g W g) ;

  pr2gy (y W : Nat) (g : Hom (lin W) X) : Id (Hom (lin W) Y) (compH (lin W) Xf Y (pr2 (lin m') Y) (BG.gy y W g)) (BG.p2g W g) =
    pr2-pair (lin m') Y (lin W) (compH (lin W) (lin m) (lin m') (dgH m' y) (BG.p1g W g)) (BG.p2g W g) ;

  -- on the face y it is F y
  Thf-face (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) Xf) (j : Hom (lin W) Iv)
    : Id (TB.EI (lin W)) (Thf W (compH (lin W) Xf X (BG.dY y) g) j) (F y hy W g j) =
    transH (Bx.Fs W gd li j)
      (transH (BSm.sv-F y hy W gd li ms j)
              (apH (\ k -> F y hy W k j)
                 (BD.pair-ext (lin m') Y (lin W) (BG.gy y W gd) g
                    (transH (pr1gy y W gd)
                      (transH (apH (compH (lin W) (lin m) (lin m') (dgH m' y)) p1d)
                        (transH (symH (comp-assoc (lin W) (lin m') (lin m) (lin m') (dgH m' y) (dl m' y) (compH (lin W) Xf (lin m') (pr1 (lin m') Y) g)))
                          (transH (apH (\ k -> compH (lin W) (lin m') (lin m') k (compH (lin W) Xf (lin m') (pr1 (lin m') Y) g))
                                     (hom-eq (lin m') (lin m') _ _ (pw-dg-dl m' y hy)))
                                  (comp-idl (lin W) (lin m') (compH (lin W) Xf (lin m') (pr1 (lin m') Y) g))))))
                    (transH (pr2gy y W gd)
                      (transH (symH (comp-assoc (lin W) Xf X Y (pr2 (lin m) Y) (BG.dY y) g))
                              (apH (\ k -> compH (lin W) Xf Y k g) (BG.pr2-dY y)))))))
   where { gd : Hom (lin W) X = compH (lin W) Xf X (BG.dY y) g ;
           p1d : Id (Hom (lin W) (lin m)) (BG.p1g W gd) (compH (lin W) (lin m') (lin m) (dl m' y) (compH (lin W) Xf (lin m') (pr1 (lin m') Y) g)) =
             transH (symH (comp-assoc (lin W) Xf X (lin m) (pr1 (lin m) Y) (BG.dY y) g))
               (transH (apH (\ k -> compH (lin W) Xf (lin m) k g) (BG.pr1-dY y))
                       (comp-assoc (lin W) Xf (lin m') (lin m) (dl m' y) (pr1 (lin m') Y) g)) ;
           ms : Miss (lin W) m' y (BG.p1g W gd) =
             substH {Hom (lin W) (lin m)} (\ k -> Miss (lin W) m' y k) (symH p1d) (S1m.dl-miss m' y W (compH (lin W) Xf (lin m') (pr1 (lin m') Y) g)) ;
           li : SP.Lands (lin W) X BSm.Q gd = SP.lands-union-l (lin W) X BG.facesS (BG.endS QY) gd (BG.in-faces W gd y hy ms) ; } ;

  opaque Thf-E ; opaque Thf-face ;
} ;

------------------------------------------------------------------------
-- m = 0: the box has the end data only

module BoxZ (G : PP.PCtx) (B : PP.PTy[G]) (e : El Iv)
  (fill : (N : Nat) -> CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].FillTy N)
  (sides : (N : Nat) (b : CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].Prob N)
           (W : Nat) (f : Hom (lin W) (lin N)) (i : CDeltaBase[a].DS.Lands W N b.2.pQ f)
           -> Id (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.EI W)
                 (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.E.act W N f
                    (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].fillE N (fill N) b))
                 (b.2.pv W f i))
  (face : (N' : Nat) (b : CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].Prob (suc N'))
          (y : Nat) (hy : IsT (leb y (suc N')))
          -> Id (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.EI N')
                (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.E.act N' (suc N') (dl N' y)
                   (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].fillE (suc N') (fill (suc N')) b))
                (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].fillE N' (fill N')
                   (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].resP N' (suc N') (dl N' y) b)))
  (Y : Ob) (htY : El Y -> Nat) (BY : Nat) (hBY : (y : El Y) -> IsT (leb (htY y) BY))
  (hmY : (y y' : El Y) -> IsT (le Y y.1 y'.1) -> IsT (leb (htY y) (htY y')))
  (hiY : (y y' : El Y) -> IsT (le Y y.1 y'.1) -> Id Nat (htY y) (htY y') -> Id Tree y.1 y'.1)
  (QY : SP.Phi Y) (xf : W0.Ix (G.ob (lin zero)))
  (a0 : (W : Nat) -> Hom (lin W) (prodP (lin zero) Y) -> PB.GPre[l].TyL[G, B].EI (lin W))
  (a0p : (W : Nat) (g : Hom (lin W) (prodP (lin zero) Y))
         -> Id (W0.Ix (G.ob (lin W))) (a0 W g).1 (G.act (lin W) (prodP (lin zero) Y) g (G.act (prodP (lin zero) Y) (lin zero) (pr1 (lin zero) Y) xf)))
  (a0n : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin zero) Y))
         -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (a0 W g)) (a0 V (compH (lin V) (lin W) (prodP (lin zero) Y) g h)))
  (Ev : (W : Nat) (g : Hom (lin W) (prodP (lin zero) Y)) -> SP.Lands (lin W) (prodP (lin zero) Y) (SP.pre (prodP (lin zero) Y) Y (pr2 (lin zero) Y) QY) g
        -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Evp : (W : Nat) (g : Hom (lin W) (prodP (lin zero) Y)) (b : SP.Lands (lin W) (prodP (lin zero) Y) (SP.pre (prodP (lin zero) Y) Y (pr2 (lin zero) Y) QY) g)
         (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob (lin W))) (Ev W g b j).1
           (G.act (lin W) (prodP (lin zero) Y) g (G.act (prodP (lin zero) Y) (lin zero) (pr1 (lin zero) Y) xf)))
  (Evn : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin zero) Y))
         (b : SP.Lands (lin W) (prodP (lin zero) Y) (SP.pre (prodP (lin zero) Y) Y (pr2 (lin zero) Y) QY) g)
         (b' : SP.Lands (lin V) (prodP (lin zero) Y) (SP.pre (prodP (lin zero) Y) Y (pr2 (lin zero) Y) QY) (compH (lin V) (lin W) (prodP (lin zero) Y) g h))
         (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (Ev W g b j))
               (Ev V (compH (lin V) (lin W) (prodP (lin zero) Y) g h) b' (compH (lin V) (lin W) Iv j h)))
  (aE : (W : Nat) (g : Hom (lin W) (prodP (lin zero) Y)) (b : SP.Lands (lin W) (prodP (lin zero) Y) (SP.pre (prodP (lin zero) Y) Y (pr2 (lin zero) Y) QY) g)
        -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (Ev W g b (constH (lin W) Iv e)) (a0 W g)) {
  module TB = PB.GPre[l].TyL[G, B] ;
  X : Ob = prodP (lin zero) Y ;
  xX : W0.Ix (G.ob X) = G.act X (lin zero) (pr1 (lin zero) Y) xf ;
  endS : SP.Phi X = SP.pre X Y (pr2 (lin zero) Y) QY ;
  module HM = EZ.HLin[zero] ;
  module HP = EZ.HProd[lin zero, HM.ht, zero, HM.hB, HM.hm, HM.hi, Y, htY, BY, hBY, hmY, hiY] ;

  module Bx = CBoxFill[a, l].BF[G, B, e, fill, sides, face,
    X, HP.ht, HP.B, HP.hB, HP.hm, HP.hi, xX, a0, a0p, a0n, endS, Ev, Evp, Evn, aE] ;

  Thf (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv) : TB.EI (lin W) = Bx.Fv W g j ;

  Thf-p (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv) : Id (W0.Ix (G.ob (lin W))) (Thf W g j).1 (G.act (lin W) X g xX) = Bx.Fp W g j ;

  Thf-n (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X) (j : Hom (lin W) Iv)
    : Id (TB.EI (lin V)) (TB.E.act (lin V) (lin W) h (Thf W g j)) (Thf V (compH (lin V) (lin W) X g h) (compH (lin V) (lin W) Iv j h)) =
    Bx.Fn V W h g j ;

  Thf-e (W : Nat) (g : Hom (lin W) X) : Id (TB.EI (lin W)) (Thf W g (constH (lin W) Iv e)) (a0 W g) = Bx.Fe W g ;

  Thf-E (W : Nat) (g : Hom (lin W) X) (b : SP.Lands (lin W) X endS g) (j : Hom (lin W) Iv)
    : Id (TB.EI (lin W)) (Thf W g j) (Ev W g b j) = Bx.Fs W g b j ;
} ;
