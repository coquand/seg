-- Ext.seg: MODEL/Poset/Ext.agda, part 1 (Ext2.seg .. Ext4.seg continue it).
-- Extension of a partial map with codomain A (sumcoll2 Lemma 6).
--
-- Data: A over G, a cofibration psi over G, B over G|psi (= resCtx) and
-- alpha : B -> A|psi (a PMap, A|psi = subTy A inclR).
--
-- Ext(alpha)(X , rho) is decided by the Bool  full X rho :
--   true  : B (X , (rho , p))
--   false : the pairs (a , b) with a in A(X , rho) and b a family over the
--           maps f : W -> X with full W (rho f), valued in the total
--           presheaf EB of B, natural, with alpha (b f) = a f (an equation
--           in EA).
--
-- This part: the codes of the pairs (with the opaque formers of VCode) and
-- the opaque interface of Pairs: pa, pb (pbF), pal, pnatF, pairs-eq,
-- mkPairs (+ -a, -b), code-pa/pb.  Agda's `opaque unfolding X` lemmas are
-- stated before X is made opaque; the opaque line closes the interface.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open Constr[a] ;
open Simp[a] ;
open BoxBase[a] ;
module PR = PreL[a, a] ;
open PR.PS ;
module FibM = Fib[a, a] ;
open VCode[a] ;
module CF = Cofib[a] ;
open Equiv[a] ;

-- transport back along an equation of codes
symId (U0 U1 : W0.V) (P : Id W0.V U0 U1) (v : W0.Ix U1) (w : W0.Ix U0) (e : Id (W0.Ix U1) (substIx U0 U1 P w) v)
  : Id (W0.Ix U0) (substIx U1 U0 (symH P) v) w =
  idJ W0.V U0 (\ U2 P2 -> (v2 : W0.Ix U2) -> Id (W0.Ix U2) (substIx U0 U2 P2 w) v2 -> Id (W0.Ix U0) (substIx U2 U0 (symH P2) v2) w)
    (\ v2 e2 -> symH e2) U1 P v e ;

module ExtDef (G : PCtx) (A : PTy[G]) (psi : CF.Cof[G]) {
  open CF.CofL[G, psi] ;

  G' : PCtx = resCtx ;

  A' : PTy[G'] = subTy G' G A inclR ;

  module TA = PR.TyL[G, A] ;
  module TA' = PR.TyL[G', A'] ;

  EA : PCtx = TA.E ;
  EA' : PCtx = TA'.E ;

  toEA (W : Ob) (w : TA'.EI W) : TA.EI W = (w.1.1, w.2) ;

  toEA-act (Y X : Ob) (h : Hom Y X) (w : TA'.EI X) : Id (TA.EI Y) (toEA Y (EA'.act Y X h w)) (EA.act Y X h (toEA X w)) =
    refl (EA.act Y X h (toEA X w)) ;

  toEA-inj (W : Ob) (w w' : TA'.EI W) (P : Id (TA.EI W) (toEA W w) (toEA W w')) : Id (TA'.EI W) w w' =
    idJ (W0.Ix (G.ob W)) w.1.1
      (\ r2 e2 -> (q2 : IsT (full W r2)) (a2 : TA.T W r2) -> Id (TA.EI W) (w.1.1, w.2) (r2, a2) -> Id (TA'.EI W) w ((r2, q2), a2))
      (\ q2 a2 P2 ->
         transH {TA'.EI W} {w} {((w.1.1, q2), w.2)} {((w.1.1, q2), a2)}
           (apH {IsT (full W w.1.1)} {TA'.EI W} (\ z -> ((w.1.1, z), w.2)) (isProp-IsT' (full W w.1.1) w.1.2 q2))
           (apH {TA.T W w.1.1} {TA'.EI W} (\ v -> ((w.1.1, q2), v)) (TA.pr-inj W w.1.1 w.2 a2 P2)))
      w'.1.1 (apH (\ z -> z.1) P) w'.1.2 w'.2 P ;

  module ExtB (B : PTy[G']) (al : PMap[G', B, A']) {
    module TB = PR.TyL[G', B] ;
    module KB = FibM.Kit[G', B] ;
    module KA' = FibM.Kit[G', A'] ;

    EB : PCtx = TB.E ;

    ------------------------------------------------------------------
    -- Pairs

    -- The codes only mention FIBRES of A and B (never the total
    -- presheaves, which mention the base context), so that they are
    -- stable under substitution on the nose.

    -- the point of G|psi along f
    ptf (X : Ob) (rho : W0.Ix (G.ob X)) (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho))) : W0.Ix (G'.ob W) =
      (G.act W X f rho, q) ;

    -- the codes use the opaque former PiO3 (VCode) with flat families
    famDom (X : Ob) (rho : W0.Ix (G.ob X)) (W : Ob) (f : Hom W X) : W0.V = IsTV (full W (G.act W X f rho)) ;

    famB3 (X : Ob) (rho : W0.Ix (G.ob X)) (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho))) : W0.V =
      B.tob W (ptf X rho W f q) ;

    famV (X : Ob) (rho : W0.Ix (G.ob X)) : W0.V = PiO3 obV (\ W -> homV W X) (famDom X rho) (famB3 X rho) ;

    Fam (X : Ob) (rho : W0.Ix (G.ob X)) : U a = W0.Ix (famV X rho) ;

    famAt (X : Ob) (rho : W0.Ix (G.ob X)) (b : Fam X rho) (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho)))
      : TB.T W (ptf X rho W f q) = app3 {obV} {\ W1 -> homV W1 X} {famDom X rho} {famB3 X rho} b W f q ;

    famLam (X : Ob) (rho : W0.Ix (G.ob X)) (F : (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho))) -> TB.T W (ptf X rho W f q))
      : Fam X rho = lam3 {obV} {\ W1 -> homV W1 X} {famDom X rho} {famB3 X rho} F ;

    famAt-lam (X : Ob) (rho : W0.Ix (G.ob X)) (F : (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho))) -> TB.T W (ptf X rho W f q))
      (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho)))
      : Id (TB.T W (ptf X rho W f q)) (famAt X rho (famLam X rho F) W f q) (F W f q) =
      app3-lam3 {obV} {\ W1 -> homV W1 X} {famDom X rho} {famB3 X rho} F W f q ;

    famExt (X : Ob) (rho : W0.Ix (G.ob X)) (b b' : Fam X rho)
      (P : (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho))) -> Id (TB.T W (ptf X rho W f q)) (famAt X rho b W f q) (famAt X rho b' W f q))
      : Id (Fam X rho) b b' = PiO3-ext {obV} {\ W1 -> homV W1 X} {famDom X rho} {famB3 X rho} b b' P ;

    opaque famAt-lam ; opaque famExt ;

    -- alpha of a value of B, as a value of A
    alF (W : Ob) (z : W0.Ix (G'.ob W)) (b : TB.T W z) : TA.T W z.1 = KA'.fromE W z (al.mE W (z, b)) (al.mpt W (z, b)) ;

    alF-E (W : Ob) (z : W0.Ix (G'.ob W)) (b : TB.T W z) : Id (TA.EI W) (z.1, alF W z b) (toEA W (al.mE W (z, b))) =
      apH (toEA W) (KA'.fromE-eq W z (al.mE W (z, b)) (al.mpt W (z, b))) ;

    alB3 (X : Ob) (rho : W0.Ix (G.ob X)) (u : TA.T X rho) (b : Fam X rho) (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho))) : W0.V =
      IdO (A.tob W (G.act W X f rho)) (alF W (ptf X rho W f q) (famAt X rho b W f q))
          (A.tact W X f rho (G.act W X f rho) (refl (G.act W X f rho)) u) ;

    alV (X : Ob) (rho : W0.Ix (G.ob X)) (u : TA.T X rho) (b : Fam X rho) : W0.V =
      PiO3 obV (\ W -> homV W X) (famDom X rho) (alB3 X rho u b) ;

    AlTy (X : Ob) (rho : W0.Ix (G.ob X)) (u : TA.T X rho) (b : Fam X rho) (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho))) : U a =
      Id (TA.T W (G.act W X f rho)) (alF W (ptf X rho W f q) (famAt X rho b W f q)) (A.tact W X f rho (G.act W X f rho) (refl (G.act W X f rho)) u) ;

    alAt (X : Ob) (rho : W0.Ix (G.ob X)) (u : TA.T X rho) (b : Fam X rho) (c : W0.Ix (alV X rho u b))
      (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho))) : AlTy X rho u b W f q =
      idO-out {A.tob W (G.act W X f rho)} {alF W (ptf X rho W f q) (famAt X rho b W f q)}
              {A.tact W X f rho (G.act W X f rho) (refl (G.act W X f rho)) u}
        (app3 {obV} {\ W1 -> homV W1 X} {famDom X rho} {alB3 X rho u b} c W f q) ;

    alLam (X : Ob) (rho : W0.Ix (G.ob X)) (u : TA.T X rho) (b : Fam X rho)
      (F : (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho))) -> AlTy X rho u b W f q) : W0.Ix (alV X rho u b) =
      lam3 {obV} {\ W1 -> homV W1 X} {famDom X rho} {alB3 X rho u b}
        (\ W f q -> idO-in {A.tob W (G.act W X f rho)} {alF W (ptf X rho W f q) (famAt X rho b W f q)}
                           {A.tact W X f rho (G.act W X f rho) (refl (G.act W X f rho)) u} (F W f q)) ;

    alProp (X : Ob) (rho : W0.Ix (G.ob X)) (u : TA.T X rho) (b : Fam X rho) : isProp (W0.Ix (alV X rho u b)) =
      PiO3-prop {obV} {\ W1 -> homV W1 X} {famDom X rho} {alB3 X rho u b}
        (\ W f q -> IdO-prop {A.tob W (G.act W X f rho)} {alF W (ptf X rho W f q) (famAt X rho b W f q)}
                             {A.tact W X f rho (G.act W X f rho) (refl (G.act W X f rho)) u}) ;

    opaque alProp ;

    -- the action of G|psi on the points ptf
    ptfE (X : Ob) (rho : W0.Ix (G.ob X)) (W' W : Ob) (chi : Hom W' W) (f : Hom W X)
      (q : IsT (full W (G.act W X f rho))) (q' : IsT (full W' (G.act W' X (compH W' W X f chi) rho)))
      : Id (W0.Ix (G'.ob W')) (G'.act W' W chi (ptf X rho W f q)) (ptf X rho W' (compH W' W X f chi) q') =
      res-eq W' (G'.act W' W chi (ptf X rho W f q)) (ptf X rho W' (compH W' W X f chi) q') (symH (G.act-o W' W X f chi rho)) ;

    -- the same along an equation f o chi = f2 (the naturality code
    -- quantifies over f2: a composite Hom inside a fibre code makes every
    -- comparison of such codes unfold compH)
    ptfEq (X : Ob) (rho : W0.Ix (G.ob X)) (W' W : Ob) (chi : Hom W' W) (f : Hom W X) (q : IsT (full W (G.act W X f rho)))
      (f2 : Hom W' X) (E : Id (Hom W' X) (compH W' W X f chi) f2) (q2 : IsT (full W' (G.act W' X f2 rho)))
      : Id (W0.Ix (G'.ob W')) (G'.act W' W chi (ptf X rho W f q)) (ptf X rho W' f2 q2) =
      res-eq W' (G'.act W' W chi (ptf X rho W f q)) (ptf X rho W' f2 q2)
        (transH (symH (G.act-o W' W X f chi rho)) (apH (\ k -> G.act W' X k rho) E)) ;

    homEqV (X : Ob) (W' W : Ob) (chi : Hom W' W) (f : Hom W X) (f2 : Hom W' X) : W0.V = IdO (homV W' X) (compH W' W X f chi) f2 ;

    natB7 (X : Ob) (rho : W0.Ix (G.ob X)) (b : Fam X rho) (W' W : Ob) (chi : Hom W' W) (f : Hom W X)
      (q : IsT (full W (G.act W X f rho))) (f2 : Hom W' X) (e : W0.Ix (homEqV X W' W chi f f2)) (q2 : IsT (full W' (G.act W' X f2 rho))) : W0.V =
      IdO (B.tob W' (ptf X rho W' f2 q2))
          (B.tact W' W chi (ptf X rho W f q) (ptf X rho W' f2 q2)
             (ptfEq X rho W' W chi f q f2 (idO-out {homV W' X} {compH W' W X f chi} {f2} e) q2) (famAt X rho b W f q))
          (famAt X rho b W' f2 q2) ;

    natD (X : Ob) (rho : W0.Ix (G.ob X)) (b : Fam X rho) (W' W : Ob) (chi : Hom W' W) (f : Hom W X)
      (q : IsT (full W (G.act W X f rho))) (f2 : Hom W' X) : W0.V =
      PiO (homEqV X W' W chi f f2) (\ e -> PiO (famDom X rho W' f2) (natB7 X rho b W' W chi f q f2 e)) ;

    natC (X : Ob) (rho : W0.Ix (G.ob X)) (b : Fam X rho) (W' W : Ob) (chi : Hom W' W) : W0.V =
      PiO3 (homV W X) (famDom X rho W) (\ f q -> homV W' X) (natD X rho b W' W chi) ;

    natFV (X : Ob) (rho : W0.Ix (G.ob X)) (b : Fam X rho) : W0.V =
      PiO3 obV (\ W' -> obV) (\ W' W -> homV W' W) (natC X rho b) ;

    NatTy (X : Ob) (rho : W0.Ix (G.ob X)) (b : Fam X rho) (W' W : Ob) (chi : Hom W' W) (f : Hom W X)
      (q : IsT (full W (G.act W X f rho))) (f2 : Hom W' X) (E : Id (Hom W' X) (compH W' W X f chi) f2)
      (q2 : IsT (full W' (G.act W' X f2 rho))) : U a =
      Id (TB.T W' (ptf X rho W' f2 q2))
         (B.tact W' W chi (ptf X rho W f q) (ptf X rho W' f2 q2) (ptfEq X rho W' W chi f q f2 E q2) (famAt X rho b W f q))
         (famAt X rho b W' f2 q2) ;

    natAt (X : Ob) (rho : W0.Ix (G.ob X)) (b : Fam X rho) (n : W0.Ix (natFV X rho b))
      (W' W : Ob) (chi : Hom W' W) (f : Hom W X) (q : IsT (full W (G.act W X f rho)))
      (f2 : Hom W' X) (e : W0.Ix (homEqV X W' W chi f f2)) (q2 : IsT (full W' (G.act W' X f2 rho)))
      : NatTy X rho b W' W chi f q f2 (idO-out {homV W' X} {compH W' W X f chi} {f2} e) q2 =
      idO-out {B.tob W' (ptf X rho W' f2 q2)}
              {B.tact W' W chi (ptf X rho W f q) (ptf X rho W' f2 q2)
                 (ptfEq X rho W' W chi f q f2 (idO-out {homV W' X} {compH W' W X f chi} {f2} e) q2) (famAt X rho b W f q)}
              {famAt X rho b W' f2 q2}
        (appO {famDom X rho W' f2} {natB7 X rho b W' W chi f q f2 e}
          (appO {homEqV X W' W chi f f2} {\ e1 -> PiO (famDom X rho W' f2) (natB7 X rho b W' W chi f q f2 e1)}
            (app3 {homV W X} {famDom X rho W} {\ f1 q1 -> homV W' X} {natD X rho b W' W chi}
               (app3 {obV} {\ W1' -> obV} {\ W1' W1 -> homV W1' W1} {natC X rho b} n W' W chi) f q f2) e) q2) ;

    natLam (X : Ob) (rho : W0.Ix (G.ob X)) (b : Fam X rho)
      (F : (W' W : Ob) (chi : Hom W' W) (f : Hom W X) (q : IsT (full W (G.act W X f rho)))
           (f2 : Hom W' X) (e : W0.Ix (homEqV X W' W chi f f2)) (q2 : IsT (full W' (G.act W' X f2 rho)))
           -> NatTy X rho b W' W chi f q f2 (idO-out {homV W' X} {compH W' W X f chi} {f2} e) q2)
      : W0.Ix (natFV X rho b) =
      lam3 {obV} {\ W1' -> obV} {\ W1' W1 -> homV W1' W1} {natC X rho b} (\ W' W chi ->
        lam3 {homV W X} {famDom X rho W} {\ f1 q1 -> homV W' X} {natD X rho b W' W chi}
          (\ f q f2 -> lamO {homEqV X W' W chi f f2} {\ e1 -> PiO (famDom X rho W' f2) (natB7 X rho b W' W chi f q f2 e1)}
             (\ e -> lamO {famDom X rho W' f2} {natB7 X rho b W' W chi f q f2 e}
                (\ q2 -> idO-in {B.tob W' (ptf X rho W' f2 q2)}
                                {B.tact W' W chi (ptf X rho W f q) (ptf X rho W' f2 q2)
                                   (ptfEq X rho W' W chi f q f2 (idO-out {homV W' X} {compH W' W X f chi} {f2} e) q2) (famAt X rho b W f q)}
                                {famAt X rho b W' f2 q2} (F W' W chi f q f2 e q2))))) ;

    natProp (X : Ob) (rho : W0.Ix (G.ob X)) (b : Fam X rho) : isProp (W0.Ix (natFV X rho b)) =
      PiO3-prop {obV} {\ W1' -> obV} {\ W1' W1 -> homV W1' W1} {natC X rho b} (\ W' W chi ->
        PiO3-prop {homV W X} {famDom X rho W} {\ f1 q1 -> homV W' X} {natD X rho b W' W chi}
          (\ f q f2 -> PiO-prop {homEqV X W' W chi f f2} {\ e1 -> PiO (famDom X rho W' f2) (natB7 X rho b W' W chi f q f2 e1)}
             (\ e -> PiO-prop {famDom X rho W' f2} {natB7 X rho b W' W chi f q f2 e}
                (\ q2 -> IdO-prop {B.tob W' (ptf X rho W' f2 q2)}
                                  {B.tact W' W chi (ptf X rho W f q) (ptf X rho W' f2 q2)
                                     (ptfEq X rho W' W chi f q f2 (idO-out {homV W' X} {compH W' W X f chi} {f2} e) q2) (famAt X rho b W f q)}
                                  {famAt X rho b W' f2 q2})))) ;

    opaque natProp ;

    -- the pairs: a , b , alpha b = a f , b natural
    pcB2 (X : Ob) (rho : W0.Ix (G.ob X)) (u : TA.T X rho) (b : Fam X rho) : W0.V = SigO (alV X rho u b) (\ z -> natFV X rho b) ;

    pcB1 (X : Ob) (rho : W0.Ix (G.ob X)) (u : TA.T X rho) : W0.V = SigO (famV X rho) (pcB2 X rho u) ;

    pairsCode (X : Ob) (rho : W0.Ix (G.ob X)) : W0.V = SigO (A.tob X rho) (pcB1 X rho) ;

    -- Pairs is OPAQUE (below): comparing two Pairs types otherwise unfolds
    -- the nested fibre codes.  Interface: pa, pbF/pb, pal, pnatF, pairs-eq,
    -- mkPairs (+ -a, -b); code-pa/pb for the raw code.
    Pairs (X : Ob) (rho : W0.Ix (G.ob X)) : U a = W0.Ix (pairsCode X rho) ;

    Pairs-def (X : Ob) (rho : W0.Ix (G.ob X)) : Id (U a) (Pairs X rho) (W0.Ix (pairsCode X rho)) = refl (Pairs X rho) ;

    pairsF (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) : W0.V = W0.ev (pairsCode X rho) u ;

    pairsInj (X : Ob) (rho : W0.Ix (G.ob X)) : W0.Inj (Pairs X rho) (pairsF X rho) =
      \ u u' P -> W0.emb-inj (Pairs X rho) (W0.elt (pairsCode X rho).1) (W0.embV (pairsCode X rho)) u u' P ;

    pairsV (X : Ob) (rho : W0.Ix (G.ob X)) : W0.V = W0.mkV (Pairs X rho) (pairsF X rho) (pairsInj X rho) ;

    -- the bridge to the raw code (propositional; see VCode)
    pairsV-code (X : Ob) (rho : W0.Ix (G.ob X)) : Id W0.V (pairsV X rho) (pairsCode X rho) = mkV-ev (pairsCode X rho) (pairsInj X rho) ;

    ------------------------------------------------------------------
    -- Pairs read in the total presheaves

    pa (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) : TA.T X rho = fstO {A.tob X rho} {pcB1 X rho} u ;

    pfam (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) : Fam X rho =
      fstO {famV X rho} {pcB2 X rho (pa X rho u)} (sndO {A.tob X rho} {pcB1 X rho} u) ;

    pbF (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho)))
      : TB.T W (ptf X rho W f q) = famAt X rho (pfam X rho u) W f q ;

    pb (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho))) : TB.EI W =
      (ptf X rho W f q, pbF X rho u W f q) ;

    pbpt (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho)))
      : Id (W0.Ix (G'.ob W)) (pb X rho u W f q).1 (G.act W X f rho, q) = refl (G.act W X f rho, q) ;

    -- the second and third components of a pair
    pr2 (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) : W0.Ix (pcB2 X rho (pa X rho u) (pfam X rho u)) =
      sndO {famV X rho} {pcB2 X rho (pa X rho u)} (sndO {A.tob X rho} {pcB1 X rho} u) ;

    pal (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho)))
      : Id (TA.EI W) (toEA W (al.mE W (pb X rho u W f q))) (EA.act W X f (rho, pa X rho u)) =
      transH (symH (alF-E W (ptf X rho W f q) (pbF X rho u W f q)))
             (apH {TA.T W (G.act W X f rho)} {TA.EI W} (\ v -> (G.act W X f rho, v))
                (alAt X rho (pa X rho u) (pfam X rho u)
                   (fstO {alV X rho (pa X rho u) (pfam X rho u)} {\ z -> natFV X rho (pfam X rho u)} (pr2 X rho u)) W f q)) ;

    pnatF (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) (W' W : Ob) (chi : Hom W' W) (f : Hom W X)
      (q : IsT (full W (G.act W X f rho))) (q' : IsT (full W' (G.act W' X (compH W' W X f chi) rho)))
      : Id (TB.EI W') (EB.act W' W chi (pb X rho u W f q)) (pb X rho u W' (compH W' W X f chi) q') =
      transH (TB.pr-tact W' W chi (ptf X rho W f q) (ptf X rho W' (compH W' W X f chi) q')
                (ptfEq X rho W' W chi f q (compH W' W X f chi)
                   (idO-out {homV W' X} {compH W' W X f chi} {compH W' W X f chi}
                      (idO-in {homV W' X} {compH W' W X f chi} {compH W' W X f chi} (refl (compH W' W X f chi)))) q')
                (pbF X rho u W f q))
             (apH {TB.T W' (ptf X rho W' (compH W' W X f chi) q')} {TB.EI W'} (\ v -> (ptf X rho W' (compH W' W X f chi) q', v))
                (natAt X rho (pfam X rho u)
                   (sndO {alV X rho (pa X rho u) (pfam X rho u)} {\ z -> natFV X rho (pfam X rho u)} (pr2 X rho u))
                   W' W chi f q (compH W' W X f chi)
                   (idO-in {homV W' X} {compH W' W X f chi} {compH W' W X f chi} (refl (compH W' W X f chi))) q')) ;

    -- the components of a pair, read in the raw code (both directions)
    code-pa (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho)
      : Id (TA.T X rho) (fstO {A.tob X rho} {pcB1 X rho} (substIx (pairsV X rho) (pairsCode X rho) (pairsV-code X rho) u)) (pa X rho u) =
      apH (fstO {A.tob X rho} {pcB1 X rho}) (subst-mkV-ev (pairsCode X rho) (pairsInj X rho) (pairsV-code X rho) u) ;

    code-pb (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho)))
      : Id (TB.T W (ptf X rho W f q))
           (famAt X rho (fstO {famV X rho} {pcB2 X rho (fstO {A.tob X rho} {pcB1 X rho} (substIx (pairsV X rho) (pairsCode X rho) (pairsV-code X rho) u))}
                          (sndO {A.tob X rho} {pcB1 X rho} (substIx (pairsV X rho) (pairsCode X rho) (pairsV-code X rho) u))) W f q)
           (pbF X rho u W f q) =
      apH {W0.Ix (pairsCode X rho)} {TB.T W (ptf X rho W f q)}
        (\ z -> famAt X rho (fstO {famV X rho} {pcB2 X rho (fstO {A.tob X rho} {pcB1 X rho} z)} (sndO {A.tob X rho} {pcB1 X rho} z)) W f q)
        (subst-mkV-ev (pairsCode X rho) (pairsInj X rho) (pairsV-code X rho) u) ;

    code-pa' (X : Ob) (rho : W0.Ix (G.ob X)) (v : W0.Ix (pairsCode X rho))
      : Id (TA.T X rho) (pa X rho (substIx (pairsCode X rho) (pairsV X rho) (symH (pairsV-code X rho)) v)) (fstO {A.tob X rho} {pcB1 X rho} v) =
      apH (fstO {A.tob X rho} {pcB1 X rho})
        (symId (pairsV X rho) (pairsCode X rho) (pairsV-code X rho) v v (subst-mkV-ev (pairsCode X rho) (pairsInj X rho) (pairsV-code X rho) v)) ;

    code-pb' (X : Ob) (rho : W0.Ix (G.ob X)) (v : W0.Ix (pairsCode X rho)) (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho)))
      : Id (TB.T W (ptf X rho W f q)) (pbF X rho (substIx (pairsCode X rho) (pairsV X rho) (symH (pairsV-code X rho)) v) W f q)
           (famAt X rho (fstO {famV X rho} {pcB2 X rho (fstO {A.tob X rho} {pcB1 X rho} v)} (sndO {A.tob X rho} {pcB1 X rho} v)) W f q) =
      apH {W0.Ix (pairsCode X rho)} {TB.T W (ptf X rho W f q)}
        (\ z -> famAt X rho (fstO {famV X rho} {pcB2 X rho (fstO {A.tob X rho} {pcB1 X rho} z)} (sndO {A.tob X rho} {pcB1 X rho} z)) W f q)
        (symId (pairsV X rho) (pairsCode X rho) (pairsV-code X rho) v v (subst-mkV-ev (pairsCode X rho) (pairsInj X rho) (pairsV-code X rho) v)) ;

    -- the point of a family value
    famPt (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho)))
      : Id (W0.Ix (G'.ob W)) (pb X rho u W f q).1 (G.act W X f rho, q) = refl (G.act W X f rho, q) ;

    pairsAux (X : Ob) (rho : W0.Ix (G.ob X)) (u u' : TA.T X rho) (P : Id (TA.T X rho) u u')
      (r : W0.Ix (pcB1 X rho u)) (r' : W0.Ix (pcB1 X rho u'))
      (Pr : Id (Fam X rho) (fstO {famV X rho} {pcB2 X rho u} r) (fstO {famV X rho} {pcB2 X rho u'} r'))
      : Id (W0.Ix (pcB1 X rho u')) (subst (TA.T X rho) (\ z -> W0.Ix (pcB1 X rho z)) u u' P r) r' =
      idJ (TA.T X rho) u
        (\ u2 P2 -> (r2 : W0.Ix (pcB1 X rho u2)) -> Id (Fam X rho) (fstO {famV X rho} {pcB2 X rho u} r) (fstO {famV X rho} {pcB2 X rho u2} r2)
           -> Id (W0.Ix (pcB1 X rho u2)) (subst (TA.T X rho) (\ z -> W0.Ix (pcB1 X rho z)) u u2 P2 r) r2)
        (\ r2 Pr2 ->
           SigO-ext {famV X rho} {pcB2 X rho u} r r2 Pr2
             (SigO-prop {alV X rho u (fstO {famV X rho} {pcB2 X rho u} r2)} {\ z -> natFV X rho (fstO {famV X rho} {pcB2 X rho u} r2)}
                (alProp X rho u (fstO {famV X rho} {pcB2 X rho u} r2)) (\ z -> natProp X rho (fstO {famV X rho} {pcB2 X rho u} r2))
                (subst (Fam X rho) (\ z -> W0.Ix (pcB2 X rho u z)) (fstO {famV X rho} {pcB2 X rho u} r) (fstO {famV X rho} {pcB2 X rho u} r2) Pr2
                       (sndO {famV X rho} {pcB2 X rho u} r))
                (sndO {famV X rho} {pcB2 X rho u} r2)))
        u' P r' Pr ;

    pairs-eq (X : Ob) (rho : W0.Ix (G.ob X)) (u u' : Pairs X rho) (Pa : Id (TA.T X rho) (pa X rho u) (pa X rho u'))
      (eb : (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho))) -> Id (TB.EI W) (pb X rho u W f q) (pb X rho u' W f q))
      : Id (Pairs X rho) u u' =
      SigO-ext {A.tob X rho} {pcB1 X rho} u u' Pa
        (pairsAux X rho (pa X rho u) (pa X rho u') Pa (sndO {A.tob X rho} {pcB1 X rho} u) (sndO {A.tob X rho} {pcB1 X rho} u')
           (famExt X rho (pfam X rho u) (pfam X rho u')
              (\ W f q -> TB.pr-inj W (ptf X rho W f q) (pbF X rho u W f q) (pbF X rho u' W f q) (eb W f q)))) ;

    -- pairs from data in the total presheaves
    BETy (X : Ob) (rho : W0.Ix (G.ob X)) : U a = (W : Ob) (f : Hom W X) -> IsT (full W (G.act W X f rho)) -> TB.EI W ;

    BptTy (X : Ob) (rho : W0.Ix (G.ob X)) (bE : BETy X rho) : U a =
      (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho))) -> Id (W0.Ix (G'.ob W)) (bE W f q).1 (G.act W X f rho, q) ;

    BalTy (X : Ob) (rho : W0.Ix (G.ob X)) (u : TA.T X rho) (bE : BETy X rho) : U a =
      (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho))) -> Id (TA.EI W) (toEA W (al.mE W (bE W f q))) (EA.act W X f (rho, u)) ;

    BnatTy (X : Ob) (rho : W0.Ix (G.ob X)) (bE : BETy X rho) : U a =
      (W' W : Ob) (chi : Hom W' W) (f : Hom W X) (q : IsT (full W (G.act W X f rho)))
      (q' : IsT (full W' (G.act W' X (compH W' W X f chi) rho)))
      -> Id (TB.EI W') (EB.act W' W chi (bE W f q)) (bE W' (compH W' W X f chi) q') ;

    module MP (X : Ob) (rho : W0.Ix (G.ob X)) (u : TA.T X rho) (bE : BETy X rho) (bpt : BptTy X rho bE)
      (bal : BalTy X rho u bE) (bnat : BnatTy X rho bE) {

      bR (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho))) : TB.T W (ptf X rho W f q) =
        KB.fromE W (ptf X rho W f q) (bE W f q) (bpt W f q) ;

      alP : W0.Ix (alV X rho u (famLam X rho bR)) = alLam X rho u (famLam X rho bR) (\ W f q ->
        transH (apH (alF W (ptf X rho W f q)) (famAt-lam X rho bR W f q))
         (TA.pr-inj W (G.act W X f rho) (alF W (ptf X rho W f q) (bR W f q)) (A.tact W X f rho (G.act W X f rho) (refl (G.act W X f rho)) u)
           (transH (alF-E W (ptf X rho W f q) (bR W f q))
            (transH (apH (\ z -> toEA W (al.mE W z)) (KB.fromE-eq W (ptf X rho W f q) (bE W f q) (bpt W f q)))
                    (bal W f q))))) ;

      natPg (W' W : Ob) (chi : Hom W' W) (f : Hom W X) (q : IsT (full W (G.act W X f rho)))
        (f2 : Hom W' X) (E : Id (Hom W' X) (compH W' W X f chi) f2) (q2 : IsT (full W' (G.act W' X f2 rho)))
        : NatTy X rho (famLam X rho bR) W' W chi f q f2 E q2 =
        idJ (Hom W' X) (compH W' W X f chi)
          (\ f3 E3 -> (q3 : IsT (full W' (G.act W' X f3 rho))) -> NatTy X rho (famLam X rho bR) W' W chi f q f3 E3 q3)
          (\ q3 ->
             transH (apH (B.tact W' W chi (ptf X rho W f q) (ptf X rho W' (compH W' W X f chi) q3)
                            (ptfEq X rho W' W chi f q (compH W' W X f chi) (refl (compH W' W X f chi)) q3))
                         (famAt-lam X rho bR W f q))
              (transH (TB.pr-inj W' (ptf X rho W' (compH W' W X f chi) q3)
                         (B.tact W' W chi (ptf X rho W f q) (ptf X rho W' (compH W' W X f chi) q3)
                            (ptfEq X rho W' W chi f q (compH W' W X f chi) (refl (compH W' W X f chi)) q3) (bR W f q))
                         (bR W' (compH W' W X f chi) q3)
                 (transH (symH (TB.pr-tact W' W chi (ptf X rho W f q) (ptf X rho W' (compH W' W X f chi) q3)
                                  (ptfEq X rho W' W chi f q (compH W' W X f chi) (refl (compH W' W X f chi)) q3) (bR W f q)))
                  (transH (apH (EB.act W' W chi) (KB.fromE-eq W (ptf X rho W f q) (bE W f q) (bpt W f q)))
                   (transH (bnat W' W chi f q q3)
                           (symH (KB.fromE-eq W' (ptf X rho W' (compH W' W X f chi) q3) (bE W' (compH W' W X f chi) q3)
                                    (bpt W' (compH W' W X f chi) q3)))))))
                      (symH (famAt-lam X rho bR W' (compH W' W X f chi) q3))))
          f2 E q2 ;

      natP : W0.Ix (natFV X rho (famLam X rho bR)) = natLam X rho (famLam X rho bR)
        (\ W' W chi f q f2 e q2 -> natPg W' W chi f q f2 (idO-out {homV W' X} {compH W' W X f chi} {f2} e) q2) ;

      res : Pairs X rho =
        pairO {A.tob X rho} {pcB1 X rho} u
          (pairO {famV X rho} {pcB2 X rho u} (famLam X rho bR)
            (pairO {alV X rho u (famLam X rho bR)} {\ z -> natFV X rho (famLam X rho bR)} alP natP)) ;

      res-a : Id (TA.T X rho) (pa X rho res) u =
        fstO-pairO {A.tob X rho} {pcB1 X rho} u
          (pairO {famV X rho} {pcB2 X rho u} (famLam X rho bR)
            (pairO {alV X rho u (famLam X rho bR)} {\ z -> natFV X rho (famLam X rho bR)} alP natP)) ;

      rr : W0.Ix (pcB1 X rho u) =
        pairO {famV X rho} {pcB2 X rho u} (famLam X rho bR)
          (pairO {alV X rho u (famLam X rho bR)} {\ z -> natFV X rho (famLam X rho bR)} alP natP) ;

      res-b (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho))) : Id (TB.EI W) (pb X rho res W f q) (bE W f q) =
        trans (TB.EI W) (pb X rho res W f q) (ptf X rho W f q, famAt X rho (fstO {famV X rho} {pcB2 X rho u} rr) W f q) (bE W f q)
         (apH {Fam X rho} {TB.EI W} (\ z -> (ptf X rho W f q, famAt X rho z W f q)) (fst2-pairO {A.tob X rho} {famV X rho} {pcB2 X rho} u rr))
         (trans (TB.EI W) (ptf X rho W f q, famAt X rho (fstO {famV X rho} {pcB2 X rho u} rr) W f q)
                          (ptf X rho W f q, famAt X rho (famLam X rho bR) W f q) (bE W f q)
           (apH {Fam X rho} {TB.EI W} (\ z -> (ptf X rho W f q, famAt X rho z W f q))
                (fstO-pairO {famV X rho} {pcB2 X rho u} (famLam X rho bR)
                   (pairO {alV X rho u (famLam X rho bR)} {\ z -> natFV X rho (famLam X rho bR)} alP natP)))
           (trans (TB.EI W) (ptf X rho W f q, famAt X rho (famLam X rho bR) W f q) (ptf X rho W f q, bR W f q) (bE W f q)
             (apH {TB.T W (ptf X rho W f q)} {TB.EI W} (\ v -> (ptf X rho W f q, v)) (famAt-lam X rho bR W f q))
             (KB.fromE-eq W (ptf X rho W f q) (bE W f q) (bpt W f q)))) ;
    } ;

    mkPairs (X : Ob) (rho : W0.Ix (G.ob X)) (u : TA.T X rho) (bE : BETy X rho) (bpt : BptTy X rho bE)
      (bal : BalTy X rho u bE) (bnat : BnatTy X rho bE) : Pairs X rho = MP[X, rho, u, bE, bpt, bal, bnat].res ;

    mkPairs-a (X : Ob) (rho : W0.Ix (G.ob X)) (u : TA.T X rho) (bE : BETy X rho) (bpt : BptTy X rho bE)
      (bal : BalTy X rho u bE) (bnat : BnatTy X rho bE) : Id (TA.T X rho) (pa X rho (mkPairs X rho u bE bpt bal bnat)) u =
      MP[X, rho, u, bE, bpt, bal, bnat].res-a ;

    mkPairs-b (X : Ob) (rho : W0.Ix (G.ob X)) (u : TA.T X rho) (bE : BETy X rho) (bpt : BptTy X rho bE)
      (bal : BalTy X rho u bE) (bnat : BnatTy X rho bE) (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho)))
      : Id (TB.EI W) (pb X rho (mkPairs X rho u bE bpt bal bnat) W f q) (bE W f q) =
      MP[X, rho, u, bE, bpt, bal, bnat].res-b W f q ;

    opaque Pairs ; opaque Pairs-def ; opaque pairsF ; opaque pairsInj ; opaque pairsV-code ;
    opaque pa ; opaque pfam ; opaque pbF ; opaque pr2 ; opaque pal ; opaque pnatF ;
    opaque code-pa ; opaque code-pb ; opaque code-pa' ; opaque code-pb' ; opaque pairsAux ; opaque pairs-eq ;
    opaque mkPairs ; opaque mkPairs-a ; opaque mkPairs-b ;
  } ;
} ;
