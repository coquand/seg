-- GUaOp1.seg (inside IvBase, any base): the univalence operation, step U1:
-- the gluing data of a problem.  For F : U0 X and a partial element p of
-- UaTy over F (sides Q_l with values (B_l , al_l , e_l) over F f):
--   psi      the cofibration over y X generated by the sides: at f, the
--            sieves pre f Q_l (natural by pre-comp)
--   D        its extent
--   sel      a side containing a full f (full-id; any one: pcs)
--   kap      the side's value at f, a point of Q4; kapnat by pnat and pcs
--   G2       the glued (B , A , al , eqOn) over D (GUaGlue2)
--   cFeq     the F component of kap at f is F along f (ppt)

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon ;
open Encode[a, a+] ;
open Trees[a] ;
open Arith[a] ;
module GP = GCofib[a] ;
module GE1 = GFibE[a+] ;

module U1 (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (cE : GE1.FE[GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Comp)
  (eE : GE1.FE[GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].ESIC cE)
  (X : Ob) (F : GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 X)
  (p : GCofib[a+].Partials[GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx,
                           GUnivEq.UaU[Cl, clSub, clSub-id, clSub-o, encCl].UaTy].Partial[X, F]) {
  module UA = GUnivEq.UaU[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UU = UA.UU ;

  psiQ (W : Ob) (f : Hom W X) (l : Fin p.pr) : Phi W = pre W X f (p.ps l).pQ ;

  psiN (Y W : Ob) (h : Hom Y W) (f : Hom W X) (l : Fin p.pr)
    : Id (Phi Y) (psiQ Y ((yP X).act Y W h f) l) (pre Y W h (psiQ W f l)) =
    symH (pre-comp Y W X h f (p.ps l).pQ) ;

  psi : GP.Cof[yP X] = GP.mkCof (yP X) p.pr psiQ psiN ;

  module CL = GP.CofL[yP X, psi] ;

  D : PCtx = CL.resCtx ;

  -- a side containing a full point
  sel (W : Ob) (x : W0.Ix (D.ob W)) : (l : Fin p.pr) * Lands W X (p.ps l).pQ x.1 =
    ((CL.full-id W x.1 x.2).1,
     lands-eq W X (p.ps (CL.full-id W x.1 x.2).1).pQ (compH W W X x.1 (idH W)) x.1 (comp-idr W X x.1)
       (lands-pre W W X x.1 (p.ps (CL.full-id W x.1 x.2).1).pQ (idH W) (CL.full-id W x.1 x.2).2)) ;

  kap (W : Ob) (x : W0.Ix (D.ob W)) : UA.Q4 W = (p.ps (sel W x).1).pv W x.1 (sel W x).2 ;

  kapnat (Y' Y : Ob) (h : Hom Y' Y) (x : W0.Ix (D.ob Y)) : Id (UA.Q4 Y') (kap Y' (D.act Y' Y h x)) (UA.q4Act Y' Y (yH Y' Y h) (kap Y x)) =
    transH (p.pcs (sel Y' (D.act Y' Y h x)).1 (sel Y x).1 Y' (compH Y' Y X x.1 h) (sel Y' (D.act Y' Y h x)).2
              (lands-comp Y' Y X (p.ps (sel Y x).1).pQ x.1 h (sel Y x).2))
      (symH ((p.ps (sel Y x).1).pnat Y' Y h x.1 (sel Y x).2 (lands-comp Y' Y X (p.ps (sel Y x).1).pQ x.1 h (sel Y x).2))) ;

  -- F's component of the glued data is F along f
  cFeq (W : Ob) (x : W0.Ix (D.ob W)) : Id (UU.U0 W) (kap W x).1 (UU.uAct W X x.1 F) =
    (p.ps (sel W x).1).ppt W x.1 (sel W x).2 ;

  opaque kapnat ;

  module G2 = GUaGlue2.Glue2[Cl, clSub, clSub-id, clSub-o, encCl, cE, eE, D, kap, kapnat] ;
} ;
