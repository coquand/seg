-- DGlueCl.seg: the classifier of Ext(alpha) on Delta (the glue
-- classifier), by cases on psi as Ext itself is (Thierry, 2026-10-15).
-- At a horn problem h at rho:
--
--   full rho     B's own horn operation hB, at the horn data read in B
--                (toB), its filler read back in Ext (fromB)
--   not full     fibToHorn of Ext's composition (DFibToHornSub.toCl)
--
--   clExt          the classifier, a horn operation on ExtT
--   clExt-full     on psi it is hB (the filler is fromB of hB's filler)
--   clExt-nfull    off psi it is toCl of Ext's composition
--
-- The substitution law is DGlueClSub.
--
-- General (ClT): a classifier along an equation of types Q : T2 = T1, as
-- a pointwise statement St (the fillers agree through the transport of
-- points along Q) <-> an Id in Sigma (toSig / ofSig; PTy is a set).
--
-- Constructive.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Axioms[a+].FunExtLemmas[fe @(a+)] ;
module W0 = V[a] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module DBm = DeltaBase[a] ;
module DB = DBm.DB ;
module DS = DBm.DS ;
module PR = DB.GPre[a] ;
open PR.PS ;
module GP = DB.GCofib[a] ;
module DCl = DeltaClassifier[a] ;
module DHm = DeltaHorn[a] ;
open DB.GLine[a] ;
open Constr[a] ;


------------------------------------------------------------------------
-- classifiers along an equation of types

module TrT (D : PCtx) (T2 : PTy[D]) {
  module H2 = DHornFib[a, a].DH[D, T2] ;

  trE (W : Nat) (T : PTy[D]) (Q : Id (PTy[D]) T2 T) (w : PR.TyL[D, T2].EI W) : PR.TyL[D, T].EI W =
    subst (PTy[D]) (\ T' -> PR.TyL[D, T'].EI W) T2 T Q w ;

  trH (T : PTy[D]) (Q : Id (PTy[D]) T2 T) (m k : Nat) (rho : W0.Ix (D.ob (suc m))) (h : H2.HornData m k rho)
    : DHornFib[a, a].DH[D, T].HornData m k rho =
    subst (PTy[D]) (\ T' -> DHornFib[a, a].DH[D, T'].HornData m k rho) T2 T Q h ;

  -- transport keeps the point
  trE-pt (W : Nat) (T : PTy[D]) (Q : Id (PTy[D]) T2 T) (w : PR.TyL[D, T2].EI W) : Id (W0.Ix (D.ob W)) (trE W T Q w).1 w.1 =
    idJ (PTy[D]) T2 (\ T' Q' -> Id (W0.Ix (D.ob W)) (trE W T' Q' w).1 w.1) (refl w.1) T Q ;

  -- the values of transported horn data
  trH-v (T : PTy[D]) (Q : Id (PTy[D]) T2 T) (m k : Nat) (rho : W0.Ix (D.ob (suc m))) (h : H2.HornData m k rho)
    (W : Nat) (f : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (DHm.hornS m k) f)
    : Id (PR.TyL[D, T].EI W) ((trH T Q m k rho h).1 W f i) (trE W T Q (h.1 W f i)) =
    idJ (PTy[D]) T2 (\ T' Q' -> Id (PR.TyL[D, T'].EI W) ((trH T' Q' m k rho h).1 W f i) (trE W T' Q' (h.1 W f i)))
      (refl (h.1 W f i)) T Q ;

  -- transport moves the fibre component along the objects part
  trE-v (W : Nat) (T : PTy[D]) (Q : Id (PTy[D]) T2 T) (x : W0.Ix (D.ob W)) (b : W0.Ix (T2.tob W x))
    : Id (PR.TyL[D, T].EI W) (trE W T Q (x, b))
         (x, subst W0.V (\ z -> W0.Ix z) (T2.tob W x) (T.tob W x) (apH {PTy[D]} {W0.V} (\ T' -> T'.tob W x) Q) b) =
    idJ (PTy[D]) T2
      (\ T' Q' -> Id (PR.TyL[D, T'].EI W) (trE W T' Q' (x, b))
         (x, subst W0.V (\ z -> W0.Ix z) (T2.tob W x) (T'.tob W x) (apH {PTy[D]} {W0.V} (\ T'' -> T''.tob W x) Q') b))
      (refl (x, b)) T Q ;

  opaque trE-pt ; opaque trH-v ; opaque trE-v ;
} ;

module ClT (D : PCtx) (T2 : PTy[D]) (c2 : DCl.ClD D T2) {
  module H2 = DHornFib[a, a].DH[D, T2] ;
  module TR = TrT[D, T2] ;

  St (T : PTy[D]) (c : DCl.ClD D T) (Q : Id (PTy[D]) T2 T) : U a+ =
    (m k : Nat) (hk : IsT (leb k (suc m))) (rho : W0.Ix (D.ob (suc m))) (h : H2.HornData m k rho)
    -> Id (PR.TyL[D, T].EI (suc m)) (TR.trE (suc m) T Q (rho, (c2 m k hk rho h).1)) (rho, (c m k hk rho (TR.trH T Q m k rho h)).1) ;

  toSig (T : PTy[D]) (Q : Id (PTy[D]) T2 T) (c : DCl.ClD D T) (H : St T c Q)
    : Id ((A' : PTy[D]) * DCl.ClD D A') (T, c) (T2, c2) =
    idJ (PTy[D]) T2 (\ T' Q' -> (c' : DCl.ClD D T') -> St T' c' Q' -> Id ((A' : PTy[D]) * DCl.ClD D A') (T', c') (T2, c2))
      (\ c' H' -> DCl.FExt[D, T2].base c' c2 (\ m k hk rho v pp pnA pnB ->
          transH (apH {H2.HornData m k rho} {W0.Ix (T2.tob (suc m) rho)} (\ hd -> (c' m k hk rho hd).1)
                    (DCl.FExt[D, T2].hd-eq m k rho (v, (pp, pnA)) (v, (pp, pnB)) (refl v)))
                 (symH (PR.TyL[D, T2].pr-inj (suc m) rho (c2 m k hk rho (v, (pp, pnB))).1 (c' m k hk rho (v, (pp, pnB))).1
                          (H' m k hk rho (v, (pp, pnB)))))))
      T Q c H ;

  ofSig (T : PTy[D]) (c : DCl.ClD D T) (R : Id ((A' : PTy[D]) * DCl.ClD D A') (T2, c2) (T, c)) (Q : Id (PTy[D]) T2 T) : St T c Q =
    idJ ((A' : PTy[D]) * DCl.ClD D A') (T2, c2)
      (\ z R' -> (Q' : Id (PTy[D]) T2 z.1) -> Id (Id (PTy[D]) T2 z.1) (apH {(A' : PTy[D]) * DCl.ClD D A'} {PTy[D]} (\ y -> y.1) R') Q'
                 -> St z.1 z.2 Q')
      (\ Q' pf -> idJ (Id (PTy[D]) T2 T2) (refl T2) (\ Q'' pf' -> St T2 c2 Q'')
                    (\ m k hk rho h -> refl (rho, (c2 m k hk rho h).1)) Q' pf)
      (T, c) R Q (isSet-PTy D T2 T (apH {(A' : PTy[D]) * DCl.ClD D A'} {PTy[D]} (\ y -> y.1) R) Q) ;

  opaque toSig ; opaque ofSig ;
} ;

module GC (G : PCtx) (A : PTy[G]) (psi : GP.Cof[G]) (B : PTy[GP.CofL[G, psi].resCtx])
  (al : PMap[GP.CofL[G, psi].resCtx, B, subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR])
  (hB : DCl.ClD GP.CofL[G, psi].resCtx B)
  (cE : DB.GFibE[a].FE[G, DB.GExt2.ExtB2[G, A, psi, B, al].ExtT].Comp)
  (eE : DB.GFibE[a].FE[G, DB.GExt2.ExtB2[G, A, psi, B, al].ExtT].ESIC cE) {
  open GP.CofL[G, psi] ;
  module X3 = DB.GExt3.ExtB3[G, A, psi, B, al] ;
  module E2 = DB.GExt2.ExtB2[G, A, psi, B, al] ;
  FE : DB.GFibE[a].FibEL G = (E2.ExtT, (cE, eE)) ;
  module HX = DHornFib[a, a].DH[G, E2.ExtT] ;
  module HB = DHornFib[a, a].DH[resCtx, B] ;
  module TX = PR.TyL[G, E2.ExtT] ;
  module TB = PR.TyL[resCtx, B] ;

  ----------------------------------------------------------------------
  -- at a full point: the horn data read in B, and the filler read back

  module Full (m k : Nat) (hk : IsT (leb k (suc m))) (rho : W0.Ix (G.ob (suc m))) (p : IsT (full (suc m) rho))
    (h : HX.HornData m k rho) {
    pW (W : Nat) (f : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (DHm.hornS m k) f) : IsT (full W (h.1 W f i).1) =
      full-eq W (G.act W (suc m) f rho) (h.1 W f i).1 (symH (h.2.1 W f i)) (full-act W (suc m) f rho p) ;

    bv (W : Nat) (f : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (DHm.hornS m k) f) : TB.EI W =
      X3.toB W (h.1 W f i) (pW W f i) ;

    bpp : GP.Partials[resCtx, B].PptTy (suc m) (rho, p) (DHm.hornS m k) bv =
      \ W f i -> res-eq W (bv W f i).1 (resCtx.act W (suc m) f (rho, p)) (h.2.1 W f i) ;

    -- fullness at a restricted value
    pA (W' W : Nat) (chi : Hom (lin W') (lin W)) (f : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (DHm.hornS m k) f)
      (i' : DS.Lands W' (suc m) (DHm.hornS m k) (compH (lin W') (lin W) (lin (suc m)) f chi))
      : IsT (full W' (TX.E.act W' W chi (h.1 W f i)).1) =
      full-eq W' (h.1 W' (compH (lin W') (lin W) (lin (suc m)) f chi) i').1 (TX.E.act W' W chi (h.1 W f i)).1
        (symH (apH (\ z -> z.1) (h.2.2 W' W chi f i i'))) (pW W' (compH (lin W') (lin W) (lin (suc m)) f chi) i') ;

    bpn : GP.Partials[resCtx, B].PnTy (suc m) (DHm.hornS m k) bv =
      \ W' W chi f i i' ->
        transH (symH (X3.toB-act W' W chi (h.1 W f i) (pW W f i) (pA W' W chi f i i')))
               (X3.toB-cong W' (TX.E.act W' W chi (h.1 W f i)) (h.1 W' (compH (lin W') (lin W) (lin (suc m)) f chi) i') (h.2.2 W' W chi f i i')
                  (pA W' W chi f i i') (pW W' (compH (lin W') (lin W) (lin (suc m)) f chi) i')) ;

    hd : HB.HornData m k (rho, p) = (bv, (bpp, bpn)) ;

    r : HB.Ext m k (rho, p) hd = hB m k hk (rho, p) hd ;

    w : TB.EI (suc m) = ((rho, p), r.1) ;

    res : HX.Ext m k rho h =
      ((X3.fromB (suc m) w).2,
       \ W f i -> transH (X3.actX-B W (suc m) f w)
                    (transH (apH (X3.fromB W) (r.2 W f i)) (X3.fromB-toB W (h.1 W f i) (pW W f i)))) ;

    -- the filler is fromB of hB's filler
    res-E : Id (TX.EI (suc m)) (rho, res.1) (X3.fromB (suc m) w) = refl (X3.fromB (suc m) w) ;

    opaque res ;
  } ;

  -- by cases on full
  caseF (m k : Nat) (hk : IsT (leb k (suc m))) (rho : W0.Ix (G.ob (suc m))) (h : HX.HornData m k rho)
    : (c : Bool) -> Id Bool (full (suc m) rho) c -> HX.Ext m k rho h = split {
    true -> \ e -> Full[m, k, hk, rho, e, h].res ;
    false -> \ e -> DFibToHornSub[a].toCl G FE m k hk rho h } ;

  clExt : DCl.ClD G E2.ExtT = \ m k hk rho h -> caseF m k hk rho h (full (suc m) rho) (refl (full (suc m) rho)) ;

  ----------------------------------------------------------------------
  -- the two cases

  cf-full (m k : Nat) (hk : IsT (leb k (suc m))) (rho : W0.Ix (G.ob (suc m))) (h : HX.HornData m k rho) (p : IsT (full (suc m) rho))
    : (c : Bool) (e : Id Bool (full (suc m) rho) c) -> Id (HX.Ext m k rho h) (caseF m k hk rho h c e) Full[m, k, hk, rho, p, h].res = split {
    true -> \ e -> apH (\ q -> Full[m, k, hk, rho, q, h].res) (isProp-IsT' (full (suc m) rho) e p) ;
    false -> \ e -> absurd _ (false-true (transH (symH e) p)) } ;

  cf-nfull (m k : Nat) (hk : IsT (leb k (suc m))) (rho : W0.Ix (G.ob (suc m))) (h : HX.HornData m k rho)
    (np : Id Bool (full (suc m) rho) false)
    : (c : Bool) (e : Id Bool (full (suc m) rho) c) -> Id (HX.Ext m k rho h) (caseF m k hk rho h c e) (DFibToHornSub[a].toCl G FE m k hk rho h) = split {
    true -> \ e -> absurd _ (false-true (transH (symH np) e)) ;
    false -> \ e -> refl (DFibToHornSub[a].toCl G FE m k hk rho h) } ;

  clExt-full (m k : Nat) (hk : IsT (leb k (suc m))) (rho : W0.Ix (G.ob (suc m))) (p : IsT (full (suc m) rho)) (h : HX.HornData m k rho)
    : Id (HX.Ext m k rho h) (clExt m k hk rho h) Full[m, k, hk, rho, p, h].res =
    cf-full m k hk rho h p (full (suc m) rho) (refl (full (suc m) rho)) ;

  clExt-nfull (m k : Nat) (hk : IsT (leb k (suc m))) (rho : W0.Ix (G.ob (suc m))) (np : Id Bool (full (suc m) rho) false) (h : HX.HornData m k rho)
    : Id (HX.Ext m k rho h) (clExt m k hk rho h) (DFibToHornSub[a].toCl G FE m k hk rho h) =
    cf-nfull m k hk rho h np (full (suc m) rho) (refl (full (suc m) rho)) ;

  opaque clExt ;
} ;

