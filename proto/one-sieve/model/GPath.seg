-- GPath.seg (inside IvBase): path types in line form, over any base.
--
-- Path A a b at (X , x) is a natural family in the total presheaf of A
--     u (W , f : W -> X , i : W -> Iv)  over  x f,
-- with end points a and b at i = e0 and i = e1: the presheaf exponential
-- by the representable y(Iv) (no product in the base is used), restricted
-- by the end conditions.  Its elements are read in E, as lines in E
-- (GFam.FC[E]) with point conditions.
--
--   PathEnds    the end points a, b read in E (aE, bE, natural)
--   PathE       the type for ANY natural end families aE, bE in E (Path A a b
--               is PathE at PathEnds; the homotopy fibre of a map is PathE
--               with ends alpha b and the point, GEquiv)
--   PathP       the type, with its action (precomposition) and laws
--   path-eq     a path is determined by its values
--   end0g/end1g the end conditions at every (W , f)

level lv ;
constraint a <= lv ;
open Base ;
open Prelude[lv+] ;
open Paths[lv+] ;
open Axioms[lv+].FunExtLemmas[fe @(lv+)] ;
module W0 = V[lv] ;
open Trees[a] ;
open Arith[a] ;
module GPR = GPre[lv] ;
open GPR.PS ;
open GLine[lv] ;

-- the two ends of the interval in direction dd are disjoint
disjD : (dd : Bool) (W : Ob) (g : Hom W Iv) (i : Lands W Iv (ptS (src dd)) g) (i' : Lands W Iv (ptS (tgt dd)) g) -> Empty = split {
  true -> \ W g i i' -> pt-disj W g i i' ;
  false -> \ W g i i' -> pt-disj W g i' i } ;

-- the end points of a path between two elements a, b of A, read in E
module PathEnds (G : PCtx) (A : PTy[G]) (a b : PEl[G, A]) {
  module TA = GPR.TyL[G, A] ;

  aE (W : Ob) (y : W0.Ix (G.ob W)) : TA.EI W = (y, a.eob W y) ;
  bE (W : Ob) (y : W0.Ix (G.ob W)) : TA.EI W = (y, b.eob W y) ;

  -- a and b commute with the action, read in E
  aE-act (W X : Ob) (f : Hom W X) (x : W0.Ix (G.ob X)) : Id (TA.EI W) (TA.E.act W X f (aE X x)) (aE W (G.act W X f x)) =
    transH (TA.pr-tact W X f x (G.act W X f x) (refl (G.act W X f x)) (a.eob X x))
      (apH {W0.Ix (A.tob W (G.act W X f x))} {TA.EI W} (\ v -> (G.act W X f x, v)) (a.enat W X f x (G.act W X f x) (refl (G.act W X f x)))) ;
  bE-act (W X : Ob) (f : Hom W X) (x : W0.Ix (G.ob X)) : Id (TA.EI W) (TA.E.act W X f (bE X x)) (bE W (G.act W X f x)) =
    transH (TA.pr-tact W X f x (G.act W X f x) (refl (G.act W X f x)) (b.eob X x))
      (apH {W0.Ix (A.tob W (G.act W X f x))} {TA.EI W} (\ v -> (G.act W X f x, v)) (b.enat W X f x (G.act W X f x) (refl (G.act W X f x)))) ;
} ;

-- paths over a line: G a context, A a type over a context H, and s a
-- family of points of H: at y in G(X), a point s X y W f i of H(W) for
-- every generalised point (f , i) of X, with s (y h) (f , i) = s y (h f , i)
-- (sN; no naturality in (f , i) is needed for the type).  At y a path is a
-- natural family of elements of A, read in E,
--     u (W , f : W -> X , i : W -> Iv)  over  s y (f , i),
-- from aE y to bE y (natural families in E).  The point may move with the
-- path coordinate i (a path over a line).  The ends are at src dd and
-- tgt dd (dd = true: from e0 to e1).  PathE below is the instance dd = true,
-- s y (f , i) = sx (y f): a path over a base point.
module PathOverE (G H : PCtx) (A : PTy[H]) (dd : Bool)
  (s : (X : Ob) -> W0.Ix (G.ob X) -> (W : Ob) -> Hom W X -> Hom W Iv -> W0.Ix (H.ob W))
  (sN : (J I : Ob) (h : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I h x) y)
        (W : Ob) (f : Hom W J) (i : Hom W Iv) -> Id (W0.Ix (H.ob W)) (s I x W (compH W J I h f) i) (s J y W f i))
  (aE bE : (W : Ob) -> W0.Ix (G.ob W) -> GPR.TyL[H, A].EI W)
  (aE-act : (W X : Ob) (f : Hom W X) (x : W0.Ix (G.ob X))
            -> Id (GPR.TyL[H, A].EI W) (GPR.TyL[H, A].E.act W X f (aE X x)) (aE W (G.act W X f x)))
  (bE-act : (W X : Ob) (f : Hom W X) (x : W0.Ix (G.ob X))
            -> Id (GPR.TyL[H, A].EI W) (GPR.TyL[H, A].E.act W X f (bE X x)) (bE W (G.act W X f x))) {
  module FM = GFam[lv] ;
  module TA = GPR.TyL[H, A] ;
  module GL = GPR.PshL[G] ;
  module FE = FM.FC[TA.E] ;

  aE-eq (W : Ob) (y y' : W0.Ix (G.ob W)) (q : Id (W0.Ix (G.ob W)) y y') : Id (TA.EI W) (aE W y) (aE W y') =
    apH (aE W) q ;
  bE-eq (W : Ob) (y y' : W0.Ix (G.ob W)) (q : Id (W0.Ix (G.ob W)) y y') : Id (TA.EI W) (bE W y) (bE W y') =
    apH (bE W) q ;

  ----------------------------------------------------------------------
  -- the codes

  ptV (X : Ob) (x : W0.Ix (G.ob X)) (L : W0.Ix (FE.ob X)) : W0.V =
    FM.piO (\ W -> FM.piH W X (\ f -> FM.piH W Iv (\ i -> W0.IdV (H.ob W) (L.1 W f i).1 (s X x W f i)))) ;

  e0V (X : Ob) (x : W0.Ix (G.ob X)) (L : W0.Ix (FE.ob X)) : W0.V = W0.IdV (TA.E.ob X) (L.1 X (idH X) (ptH X (src dd))) (aE X x) ;
  e1V (X : Ob) (x : W0.Ix (G.ob X)) (L : W0.Ix (FE.ob X)) : W0.V = W0.IdV (TA.E.ob X) (L.1 X (idH X) (ptH X (tgt dd))) (bE X x) ;

  condV (X : Ob) (x : W0.Ix (G.ob X)) (L : W0.Ix (FE.ob X)) : W0.V =
    W0.SigV (ptV X x L) (\ z -> W0.SigV (e0V X x L) (\ z' -> e1V X x L)) ;

  tobP (X : Ob) (x : W0.Ix (G.ob X)) : W0.V = W0.SigV (FE.ob X) (condV X x) ;

  -- the conditions are a proposition
  cond-prop (X : Ob) (x : W0.Ix (G.ob X)) (L : W0.Ix (FE.ob X)) : isProp (W0.Ix (condV X x L)) =
    isProp-Sigma (W0.Ix (ptV X x L)) (\ z -> W0.Ix (W0.SigV (e0V X x L) (\ z' -> e1V X x L)))
      (isProp-Pi Ob (\ W -> (f : Hom W X) (i : Hom W Iv) -> Id (W0.Ix (H.ob W)) (L.1 W f i).1 (s X x W f i)) (\ W ->
       isProp-Pi (Hom W X) (\ f -> (i : Hom W Iv) -> Id (W0.Ix (H.ob W)) (L.1 W f i).1 (s X x W f i)) (\ f ->
       isProp-Pi (Hom W Iv) (\ i -> Id (W0.Ix (H.ob W)) (L.1 W f i).1 (s X x W f i)) (\ i ->
         W0.isSetIx (H.ob W) (L.1 W f i).1 (s X x W f i)))))
      (\ z -> isProp-Sigma (W0.Ix (e0V X x L)) (\ z' -> W0.Ix (e1V X x L))
         (W0.isSetIx (TA.E.ob X) (L.1 X (idH X) (ptH X (src dd))) (aE X x))
         (\ z' -> W0.isSetIx (TA.E.ob X) (L.1 X (idH X) (ptH X (tgt dd))) (bE X x))) ;

  -- a path is determined by its values
  path-eq (X : Ob) (x : W0.Ix (G.ob X)) (u v : W0.Ix (tobP X x))
    (q : (W : Ob) (f : Hom W X) (i : Hom W Iv) -> Id (TA.EI W) (u.1.1 W f i) (v.1.1 W f i)) : Id (W0.Ix (tobP X x)) u v =
    Sigma-path (W0.Ix (FE.ob X)) (\ L -> W0.Ix (condV X x L)) u.1 v.1 u.2 v.2 (FE.fam-eq X u.1 v.1 q)
      (cond-prop X x v.1 _ v.2) ;

  -- the end conditions at every (W , f)
  end0g (X : Ob) (x : W0.Ix (G.ob X)) (u : W0.Ix (tobP X x)) (W : Ob) (f : Hom W X)
    : Id (TA.EI W) (u.1.1 W f (ptH W (src dd))) (aE W (G.act W X f x)) =
    calc (TA.EI W) {
        u.1.1 W f (ptH W (src dd))
      =< apH (\ k -> u.1.1 W k (ptH W (src dd))) (symH (comp-idl W X f)) >
        u.1.1 W (compH W X X (idH X) f) (ptH W (src dd))
      =< apH (\ k -> u.1.1 W (compH W X X (idH X) f) k) (symH (ptH-nat W X f (src dd))) >
        u.1.1 W (compH W X X (idH X) f) (compH W X Iv (ptH X (src dd)) f)
      =< symH (u.1.2 W X f (idH X) (ptH X (src dd))) >
        TA.E.act W X f (u.1.1 X (idH X) (ptH X (src dd)))
      =< apH (TA.E.act W X f) u.2.2.1 >
        TA.E.act W X f (aE X x)
      =< aE-act W X f x >
        aE W (G.act W X f x) } ;

  end1g (X : Ob) (x : W0.Ix (G.ob X)) (u : W0.Ix (tobP X x)) (W : Ob) (f : Hom W X)
    : Id (TA.EI W) (u.1.1 W f (ptH W (tgt dd))) (bE W (G.act W X f x)) =
    calc (TA.EI W) {
        u.1.1 W f (ptH W (tgt dd))
      =< apH (\ k -> u.1.1 W k (ptH W (tgt dd))) (symH (comp-idl W X f)) >
        u.1.1 W (compH W X X (idH X) f) (ptH W (tgt dd))
      =< apH (\ k -> u.1.1 W (compH W X X (idH X) f) k) (symH (ptH-nat W X f (tgt dd))) >
        u.1.1 W (compH W X X (idH X) f) (compH W X Iv (ptH X (tgt dd)) f)
      =< symH (u.1.2 W X f (idH X) (ptH X (tgt dd))) >
        TA.E.act W X f (u.1.1 X (idH X) (ptH X (tgt dd)))
      =< apH (TA.E.act W X f) u.2.2.2 >
        TA.E.act W X f (bE X x)
      =< bE-act W X f x >
        bE W (G.act W X f x) } ;

  -- a path from a family in E with its conditions
  mkPath (X : Ob) (x : W0.Ix (G.ob X)) (t : (W : Ob) -> Hom W X -> Hom W Iv -> TA.EI W)
    (tn : (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
          -> Id (TA.EI V) (TA.E.act V W g (t W f i)) (t V (compH V W X f g) (compH V W Iv i g)))
    (tp : (W : Ob) (f : Hom W X) (i : Hom W Iv) -> Id (W0.Ix (H.ob W)) (t W f i).1 (s X x W f i))
    (t0 : Id (TA.EI X) (t X (idH X) (ptH X (src dd))) (aE X x)) (t1 : Id (TA.EI X) (t X (idH X) (ptH X (tgt dd))) (bE X x))
    : W0.Ix (tobP X x) = ((t, tn), (tp, (t0, t1))) ;

  ----------------------------------------------------------------------
  -- the action: precomposition

  module Act (J I : Ob) (h : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I h x) y)
    (u : W0.Ix (tobP I x)) {
    L : W0.Ix (FE.ob J) = FE.actF J I h u.1 ;

    pt (W : Ob) (f : Hom W J) (i : Hom W Iv) : Id (W0.Ix (H.ob W)) (s I x W (compH W J I h f) i) (s J y W f i) = sN J I h x y e W f i ;

    res : W0.Ix (tobP J y) =
      (L, (\ W f i -> transH (u.2.1 W (compH W J I h f) i) (pt W f i),
           (transH (end0g I x u J (compH J J I h (idH J)))
              (aE-eq J (G.act J I (compH J J I h (idH J)) x) y (transH (apH (\ k -> G.act J I k x) (comp-idr J I h)) e)),
            transH (end1g I x u J (compH J J I h (idH J)))
              (bE-eq J (G.act J I (compH J J I h (idH J)) x) y (transH (apH (\ k -> G.act J I k x) (comp-idr J I h)) e))))) ;
  } ;

  tactP : TactTy G tobP = \ J I h x y e u -> Act[J, I, h, x, y, e, u].res ;

  tactP-id : IdLaw G tobP tactP = \ I x e u ->
    path-eq I x (tactP I I (idH I) x x e u) u (\ W f i -> apH (\ k -> u.1.1 W k i) (comp-idl W I f)) ;

  tactP-o : OLaw G tobP tactP = \ K J I f g x y z e1 e2 e3 u ->
    path-eq K z (tactP K I (compH K J I f g) x z e3 u) (tactP K J g y z e2 (tactP J I f x y e1 u))
      (\ W f' i -> apH (\ k -> u.1.1 W k i) (comp-assoc W K J I f g f')) ;

  PathP : PTy[G] = mkTy G tobP tactP tactP-id tactP-o ;

  module TP = GPR.TyL[G, PathP] ;

  -- the values of a restricted path
  act-val (J I : Ob) (h : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I h x) y)
    (u : W0.Ix (tobP I x)) (W : Ob) (f : Hom W J) (i : Hom W Iv)
    : Id (TA.EI W) ((PathP.tact J I h x y e u).1.1 W f i) (u.1.1 W (compH W J I h f) i) =
    refl (u.1.1 W (compH W J I h f) i) ;

  -- an element of the total presheaf is determined by its point and values
  tp-ext (W : Ob) (z z' : TP.EI W) (q : Id (W0.Ix (G.ob W)) z.1 z'.1)
    (v : (V : Ob) (g : Hom V W) (j : Hom V Iv) -> Id (TA.EI V) (z.2.1.1 V g j) (z'.2.1.1 V g j)) : Id (TP.EI W) z z' =
    idJ (W0.Ix (G.ob W)) z.1
      (\ y2 q2 -> (w2 : W0.Ix (tobP W y2)) -> ((V : Ob) (g : Hom V W) (j : Hom V Iv) -> Id (TA.EI V) (z.2.1.1 V g j) (w2.1.1 V g j))
         -> Id (TP.EI W) z (y2, w2))
      (\ w2 v2 -> apH {W0.Ix (tobP W z.1)} {TP.EI W} (\ w -> (z.1, w)) (path-eq W z.1 z.2 w2 v2))
      z'.1 q z'.2 v ;

  opaque path-eq ; opaque end0g ; opaque end1g ;
} ;

-- paths over a base point: G a context, A a type over a context H, and
-- sx : G -> H a function on points (no naturality is needed).  At y in
-- G(X) a path is a natural family of elements of A, read in E,
--     u (W , f : W -> X , i : W -> Iv)  over  sx (y f),
-- from aE y to bE y (natural families in E over sx y).  Path A a b is the
-- instance H = G, sx = id, ends PathEnds; the homotopy fibre of a map
-- B -> A over D is the instance G = (x , a , b), H = D (GEquiv).  It is
-- PathOverE at s y (f , i) = sx (y f), member by member.
module PathE (G H : PCtx) (A : PTy[H]) (sx : (W : Ob) -> W0.Ix (G.ob W) -> W0.Ix (H.ob W))
  (aE bE : (W : Ob) -> W0.Ix (G.ob W) -> GPR.TyL[H, A].EI W)
  (aE-act : (W X : Ob) (f : Hom W X) (x : W0.Ix (G.ob X))
            -> Id (GPR.TyL[H, A].EI W) (GPR.TyL[H, A].E.act W X f (aE X x)) (aE W (G.act W X f x)))
  (bE-act : (W X : Ob) (f : Hom W X) (x : W0.Ix (G.ob X))
            -> Id (GPR.TyL[H, A].EI W) (GPR.TyL[H, A].E.act W X f (bE X x)) (bE W (G.act W X f x))) {
  module GL = GPR.PshL[G] ;

  -- x (h f) = (x h) f = y f
  sN (J I : Ob) (h : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I h x) y)
    (W : Ob) (f : Hom W J) (i : Hom W Iv) : Id (W0.Ix (H.ob W)) (sx W (G.act W I (compH W J I h f) x)) (sx W (G.act W J f y)) =
    apH (sx W) (transH (symH (GL.actC W J I h f x)) (apH (G.act W J f) e)) ;

  module PO = PathOverE[G, H, A, true, \ X x W f i -> sx W (G.act W X f x), sN, aE, bE, aE-act, bE-act] ;
  module FM = PO.FM ;
  module TA = PO.TA ;
  module FE = PO.FE ;

  aE-eq (W : Ob) (y y' : W0.Ix (G.ob W)) (q : Id (W0.Ix (G.ob W)) y y') : Id (TA.EI W) (aE W y) (aE W y') = PO.aE-eq W y y' q ;
  bE-eq (W : Ob) (y y' : W0.Ix (G.ob W)) (q : Id (W0.Ix (G.ob W)) y y') : Id (TA.EI W) (bE W y) (bE W y') = PO.bE-eq W y y' q ;
  ptV (X : Ob) (x : W0.Ix (G.ob X)) (L : W0.Ix (FE.ob X)) : W0.V = PO.ptV X x L ;
  e0V (X : Ob) (x : W0.Ix (G.ob X)) (L : W0.Ix (FE.ob X)) : W0.V = PO.e0V X x L ;
  e1V (X : Ob) (x : W0.Ix (G.ob X)) (L : W0.Ix (FE.ob X)) : W0.V = PO.e1V X x L ;
  condV (X : Ob) (x : W0.Ix (G.ob X)) (L : W0.Ix (FE.ob X)) : W0.V = PO.condV X x L ;
  tobP (X : Ob) (x : W0.Ix (G.ob X)) : W0.V = PO.tobP X x ;
  cond-prop (X : Ob) (x : W0.Ix (G.ob X)) (L : W0.Ix (FE.ob X)) : isProp (W0.Ix (condV X x L)) = PO.cond-prop X x L ;
  path-eq (X : Ob) (x : W0.Ix (G.ob X)) (u v : W0.Ix (tobP X x))
    (q : (W : Ob) (f : Hom W X) (i : Hom W Iv) -> Id (TA.EI W) (u.1.1 W f i) (v.1.1 W f i)) : Id (W0.Ix (tobP X x)) u v =
    PO.path-eq X x u v q ;
  end0g (X : Ob) (x : W0.Ix (G.ob X)) (u : W0.Ix (tobP X x)) (W : Ob) (f : Hom W X)
    : Id (TA.EI W) (u.1.1 W f (ptH W e0)) (aE W (G.act W X f x)) = PO.end0g X x u W f ;
  end1g (X : Ob) (x : W0.Ix (G.ob X)) (u : W0.Ix (tobP X x)) (W : Ob) (f : Hom W X)
    : Id (TA.EI W) (u.1.1 W f (ptH W e1)) (bE W (G.act W X f x)) = PO.end1g X x u W f ;
  mkPath (X : Ob) (x : W0.Ix (G.ob X)) (t : (W : Ob) -> Hom W X -> Hom W Iv -> TA.EI W)
    (tn : (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
          -> Id (TA.EI V) (TA.E.act V W g (t W f i)) (t V (compH V W X f g) (compH V W Iv i g)))
    (tp : (W : Ob) (f : Hom W X) (i : Hom W Iv) -> Id (W0.Ix (H.ob W)) (t W f i).1 (sx W (G.act W X f x)))
    (t0 : Id (TA.EI X) (t X (idH X) (ptH X e0)) (aE X x)) (t1 : Id (TA.EI X) (t X (idH X) (ptH X e1)) (bE X x))
    : W0.Ix (tobP X x) = PO.mkPath X x t tn tp t0 t1 ;
  tactP : TactTy G tobP = PO.tactP ;
  tactP-id : IdLaw G tobP tactP = PO.tactP-id ;
  tactP-o : OLaw G tobP tactP = PO.tactP-o ;
  PathP : PTy[G] = PO.PathP ;
  module TP = PO.TP ;
  act-val (J I : Ob) (h : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I h x) y)
    (u : W0.Ix (tobP I x)) (W : Ob) (f : Hom W J) (i : Hom W Iv)
    : Id (TA.EI W) ((PathP.tact J I h x y e u).1.1 W f i) (u.1.1 W (compH W J I h f) i) = PO.act-val J I h x y e u W f i ;
  tp-ext (W : Ob) (z z' : TP.EI W) (q : Id (W0.Ix (G.ob W)) z.1 z'.1)
    (v : (V : Ob) (g : Hom V W) (j : Hom V Iv) -> Id (TA.EI V) (z.2.1.1 V g j) (z'.2.1.1 V g j)) : Id (TP.EI W) z z' =
    PO.tp-ext W z z' q v ;
} ;
