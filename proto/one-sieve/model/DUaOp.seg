-- DUaOp.seg (inside Classical.Cl): the univalence operation of the
-- universe of Delta, the generic one (GUaOp9.UaOp, in DeltaForall.DFaU)
-- at DeltaClassifier.DU (cours6: Sigma (X : U) Equiv (X , A) is
-- contractible, uniformly and strictly):
--
--   cE, eE, kU*   El's fibrancy (DeltaElFib.elFibEL; its fillers, GFibFill)
--   tautCl        DTautCl (+ -sub), DTautYon (-yon)
--   glueCl        DGlueCl.GC.clExt (+ -sub: DGlueClSub)
--   clFullOp      DClFull.clFull at GUaOp4's data
--
--
-- Classical only through elFibEL (DeltaHornBox.decDeg).

level a ;
open Base ;
module DBm = DeltaBase[a] ;
module DB = DBm.DB ;
module DCl = DeltaClassifier[a] ;
module DU = DCl.DU ;
module YO = DB.GYon ;
module DF = DeltaForall[a].DFaU ;

elF : DB.GFibE[a+].FibEL DU.UCtx = DeltaElFib[a].elFibEL ;
cE : DB.GFibE[a+].FE[DU.UCtx, DU.EGen].Comp = elF.2.1 ;
eE : DB.GFibE[a+].FE[DU.UCtx, DU.EGen].ESIC cE = elF.2.2 ;

module FF = DBm.DCn.GFibFill[a+].FibFill[DU.UCtx, DU.EGen, cE, eE] ;
module TC = DTautCl[a].TA[cE, eE] ;
module TY = DTautYon[a].TY[cE, eE] ;

glueCl (G : DB.GPre[a].PS.PCtx) (A : DB.GPre[a].PS.PTy[G]) (psi : DB.GCofib[a].Cof[G]) (B : DB.GPre[a].PS.PTy[DB.GCofib[a].CofL[G, psi].resCtx])
  (al : DB.GLine[a].PMap[DB.GCofib[a].CofL[G, psi].resCtx, B, DB.GPre[a].PS.subTy DB.GCofib[a].CofL[G, psi].resCtx G A DB.GCofib[a].CofL[G, psi].inclR])
  (hB : DCl.ClD DB.GCofib[a].CofL[G, psi].resCtx B)
  (c : DB.GFibE[a].FE[G, DB.GExt2.ExtB2[G, A, psi, B, al].ExtT].Comp) (e : DB.GFibE[a].FE[G, DB.GExt2.ExtB2[G, A, psi, B, al].ExtT].ESIC c)
  : DCl.ClD G DB.GExt2.ExtB2[G, A, psi, B, al].ExtT = DGlueCl[a].GC[G, A, psi, B, al, hB, c, e].clExt ;

module UA = DF.GUaOp9.UaOp[DCl.ClD, DCl.clSubD, DCl.clSub-idD, DCl.clSub-oD, \ X A -> DCl.encClD (YO.yP X) A,
  cE, eE, FF.k0, FF.k1, FF.k0e, FF.k1e,
  TC.tautCl, glueCl,
  \ G A psi B al hB c e D' s psi' fullS c' e' FS -> DGlueClSub[a].GS[G, A, psi, B, al, hB, c, e, D', s, psi', fullS].Sb[c', e', FS].clExt-sub,
  TC.tautCl-sub, TY.tautCl-yon,
  \ X F p l0 il0 -> DClFull[a].CF[YO.yP X,
      DF.GUaOp4.U4[DCl.ClD, DCl.clSubD, DCl.clSub-idD, DCl.clSub-oD, \ X' A -> DCl.encClD (YO.yP X') A, cE, eE, FF.k0, FF.k1, FF.k0e, FF.k1e,
                   X, F, p, TC.tautCl, glueCl, l0, il0].O2.AX,
      DF.GUaOp4.U4[DCl.ClD, DCl.clSubD, DCl.clSub-idD, DCl.clSub-oD, \ X' A -> DCl.encClD (YO.yP X') A, cE, eE, FF.k0, FF.k1, FF.k0e, FF.k1e,
                   X, F, p, TC.tautCl, glueCl, l0, il0].O1.psi,
      DF.GUaOp4.U4[DCl.ClD, DCl.clSubD, DCl.clSub-idD, DCl.clSub-oD, \ X' A -> DCl.encClD (YO.yP X') A, cE, eE, FF.k0, FF.k1, FF.k0e, FF.k1e,
                   X, F, p, TC.tautCl, glueCl, l0, il0].G.B,
      DF.GUaOp4.U4[DCl.ClD, DCl.clSubD, DCl.clSub-idD, DCl.clSub-oD, \ X' A -> DCl.encClD (YO.yP X') A, cE, eE, FF.k0, FF.k1, FF.k0e, FF.k1e,
                   X, F, p, TC.tautCl, glueCl, l0, il0].O2.al',
      DF.GUaOp4.U4[DCl.ClD, DCl.clSubD, DCl.clSub-idD, DCl.clSub-oD, \ X' A -> DCl.encClD (YO.yP X') A, cE, eE, FF.k0, FF.k1, FF.k0e, FF.k1e,
                   X, F, p, TC.tautCl, glueCl, l0, il0].O3.hB,
      DF.GUaOp4.U4[DCl.ClD, DCl.clSubD, DCl.clSub-idD, DCl.clSub-oD, \ X' A -> DCl.encClD (YO.yP X') A, cE, eE, FF.k0, FF.k1, FF.k0e, FF.k1e,
                   X, F, p, TC.tautCl, glueCl, l0, il0].O2.EF.extFib.2.1,
      DF.GUaOp4.U4[DCl.ClD, DCl.clSubD, DCl.clSub-idD, DCl.clSub-oD, \ X' A -> DCl.encClD (YO.yP X') A, cE, eE, FF.k0, FF.k1, FF.k0e, FF.k1e,
                   X, F, p, TC.tautCl, glueCl, l0, il0].O2.EF.extFib.2.2,
      DF.GUaOp4.U4[DCl.ClD, DCl.clSubD, DCl.clSub-idD, DCl.clSub-oD, \ X' A -> DCl.encClD (YO.yP X') A, cE, eE, FF.k0, FF.k1, FF.k0e, FF.k1e,
                   X, F, p, TC.tautCl, glueCl, l0, il0].fl].clFull] ;

-- univalence of the universe of Delta
ua : DB.GCofib[a+].Partials[DU.UCtx, DB.GUnivEq.UaU[DCl.ClD, DCl.clSubD, DCl.clSub-idD, DCl.clSub-oD, \ X A -> DCl.encClD (YO.yP X) A].UaTy].ContrOp = UA.ua ;
