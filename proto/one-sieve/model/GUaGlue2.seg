-- GUaGlue2.seg (inside IvBase, any base): gluing along a classifying map,
-- part 2: the equivalence structure (step G3d of the univalence plan).
--
-- For x at Z, the glued triple along the Yoneda map of x is the local
-- triple of kap x (Tx = GSub, GCong by kapnat, GYonQ; GUaGlue1b); the local
-- equivalence structure of kap x, moved back along Tx, is L Z x.  The
-- coherence is an Id of data: along y h, L moves as kap does (kapnat), and
-- the action of the univalence type on data is eqDSub (q4Act).  GYonEq3
-- glues: eqOn, an equivalence structure (with KESI) on the glued map.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon ;
open Encode[a, a+] ;
open GLine[a] ;
module GE1 = GFibE[a+] ;
module GX = GEqExt[a] ;
module GL = GEqLaws[a] ;
module GY1 = GYonEq1 ;

-- a pair with a transported second component
pairTr (G : PCtx) (t t2 : GX.EqDat[G].Tri) (P : Id (GX.EqDat[G].Tri) t t2) (e2 : GX.EqDat[G].EqOn t2)
  : Id ((u : GX.EqDat[G].Tri) * GX.EqDat[G].EqOn u) (t, subst (GX.EqDat[G].Tri) (GX.EqDat[G].EqOn) t2 t (symH P) e2) (t2, e2) =
  idJ (GX.EqDat[G].Tri) t
    (\ t3 P3 -> (e3 : GX.EqDat[G].EqOn t3)
       -> Id ((u : GX.EqDat[G].Tri) * GX.EqDat[G].EqOn u) (t, subst (GX.EqDat[G].Tri) (GX.EqDat[G].EqOn) t3 t (symH P3) e3) (t3, e3))
    (\ e3 -> refl (t, e3)) t2 P e2 ;

opaque pairTr ;

module Glue2 (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (cE : GE1.FE[GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Comp)
  (eE : GE1.FE[GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].ESIC cE)
  (D : PCtx)
  (kap : (Y : Ob) -> W0.Ix (D.ob Y) -> GUnivEq.UaU[Cl, clSub, clSub-id, clSub-o, encCl].Q4 Y)
  (kapnat : (Y' Y : Ob) (h : Hom Y' Y) (x : W0.Ix (D.ob Y))
     -> Id (GUnivEq.UaU[Cl, clSub, clSub-id, clSub-o, encCl].Q4 Y') (kap Y' (D.act Y' Y h x))
           (GUnivEq.UaU[Cl, clSub, clSub-id, clSub-o, encCl].q4Act Y' Y (yH Y' Y h) (kap Y x))) {
  module UA = GUnivEq.UaU[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module G = GUaGlue1.Glue[Cl, clSub, clSub-id, clSub-o, encCl, cE, eE, D, kap, kapnat] ;
  module GLb = GUaGlue1b.GlueL[Cl, clSub, clSub-id, clSub-o, encCl, cE, eE] ;

  -- the local data of a point of the univalence type
  loc (Z : Ob) (q : UA.Q4 Z) : (u : GX.EqDat[yP Z].Tri) * GX.EqDat[yP Z].EqOn u = ((q.2.1.1, (q.1.1, q.2.2.1)), q.2.2.2) ;

  module Tx (Z : Ob) (x : W0.Ix (D.ob Z)) {
    module S = GLb.GSub[D, kap, kapnat, yP Z, yPt D Z x] ;
    module YQ = GLb.GYonQ[Z, kap Z x] ;
    module CG = GLb.GCong[yP Z, S.ks, S.ksnat, YQ.kq, YQ.kqnat, \ W f -> kapnat W Z f x] ;

    T : Id (GX.EqDat[yP Z].Tri) (GY1.triY D G.B G.A G.al Z x) (loc Z (kap Z x)).1 = transH S.P (transH CG.P YQ.P) ;

    L : GX.EqDat[yP Z].EqOn (GY1.triY D G.B G.A G.al Z x) =
      subst (GX.EqDat[yP Z].Tri) (GX.EqDat[yP Z].EqOn) (loc Z (kap Z x)).1 (GY1.triY D G.B G.A G.al Z x) (symH T) (loc Z (kap Z x)).2 ;

    Wx : Id ((u : GX.EqDat[yP Z].Tri) * GX.EqDat[yP Z].EqOn u) (GY1.triY D G.B G.A G.al Z x, L) (loc Z (kap Z x)) =
      pairTr (yP Z) (GY1.triY D G.B G.A G.al Z x) (loc Z (kap Z x)).1 T (loc Z (kap Z x)).2 ;
  } ;

  L (Z : Ob) (x : W0.Ix (D.ob Z)) : GX.EqDat[yP Z].EqOn (GY1.triY D G.B G.A G.al Z x) = Tx[Z, x].L ;

  coh (Z Z' : Ob) (h : Hom Z' Z) (x : W0.Ix (D.ob Z))
    : Id ((u : GX.EqDat[yP Z'].Tri) * GX.EqDat[yP Z'].EqOn u)
         (GL.eqDSub (yP Z') (yP Z) (yH Z' Z h) (GY1.triY D G.B G.A G.al Z x) (L Z x))
         (GY1.triY D G.B G.A G.al Z' (D.act Z' Z h x), L Z' (D.act Z' Z h x)) =
    transH (apH (\ z -> GL.eqDSub (yP Z') (yP Z) (yH Z' Z h) z.1 z.2) Tx[Z, x].Wx)
      (transH (apH (loc Z') (symH (kapnat Z' Z h x))) (symH Tx[Z', D.act Z' Z h x].Wx)) ;

  opaque coh ;

  module YE = GYonEq3.YE3[D, G.B, G.A, G.al, L, coh] ;

  eqOn : GX.EqDat[D].EqOn (G.B, (G.A, G.al)) = YE.eqOn ;
} ;
