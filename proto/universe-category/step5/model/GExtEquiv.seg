-- GExtEquiv.seg (inside IvBase, any base; line form of ExtEquiv.seg, part
-- 1).  ext(alpha) : Ext(alpha) -> A is an equivalence (half of sumcoll2
-- Theorem 7), from a line filler of A at e1 (kA : FibAt e1, family path
-- object) and an equivalence structure for alpha (GEquiv).  Fibres are the
-- generic ones (GEquiv.HFib: a path is a natural family over (f , i)).
--
-- Given w = (rho , a) in A and a partial element p of the fibre of ext
-- over w (sides Q_l):
--   * at each full f : W -> X, p f is translated into a partial element of
--     the fibre of alpha (toFA, Tr) and extended by eal: theta f   (kE);
--   * ONE partial line in A over the constant line at rho, with total end
--     w at e1, sides: the lines of p on Q_l and the lines of theta on the
--     generators cQ X rho k of psi rho; filled by kA  (GExtEquiv2);
--   * the result: (glue (a0 , t) , the filled line)   (GExtEquiv3).
-- No box over a cylinder (ExtKit) is needed.
--
-- This part: fibre elements of ext at full points as fibre elements of
-- alpha (toFA / fromFA), translated partial elements (Tr), and kE.

level lv ;
constraint a <= lv ;
open Base ;
open Prelude[lv+] ;
open Paths[lv+] ;
module W0 = V[lv] ;
open Trees[a] ;
open Arith[a] ;
module PR = GPre[lv] ;
open PR.PS ;
module GP = GCofib[lv] ;
open GLine[lv] ;

module ExtEq (G : PCtx) (A : PTy[G]) (psi : GP.Cof[G]) (B : PTy[GP.CofL[G, psi].resCtx])
  (al : PMap[GP.CofL[G, psi].resCtx, B, subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR])
  (kA : LineFibP[GFam[lv].famPath, G, A].FibAt e1)
  (eal : GEquiv[lv].EquivOp GP.CofL[G, psi].resCtx B (subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR) al) {
  open GP.CofL[G, psi] ;
  open GExt[lv].ExtDef[G, A, psi] ;
  open ExtB[B, al] ;
  open GExt2[lv].ExtB2[G, A, psi, B, al] ;
  open GExt3[lv].ExtB3[G, A, psi, B, al] ;
  open GExt4[lv].ExtB4[G, A, psi, B, al] ;

  module FX = GEquiv[lv].HFib[G, ExtT, A, extMap] ;
  module FA = GEquiv[lv].HFib[G', B, A', al] ;
  module PX = GP.Partials[EA, FX.FibT] ;
  module PA = GP.Partials[EA', FA.FibT] ;

  EFX : PCtx = FX.TF.E ;
  EFA : PCtx = FA.TF.E ;

  ----------------------------------------------------------------------
  -- Fibre elements of ext at full points are fibre elements of alpha

  -- a value of A over a full point, as a value of A'
  fullOf (W V : Ob) (f : Hom W V) (x : W0.Ix (G.ob V)) (q : IsT (full V x)) (z : TA.EI W)
    (zp : Id (W0.Ix (G.ob W)) z.1 (G.act W V f x)) : TA'.EI W =
    ((z.1, full-eq W (G.act W V f x) z.1 (symH zp) (full-act W V f x q)), z.2) ;

  -- the data of toFA
  tw (V : Ob) (v : FX.TF.EI V) (q : IsT (full V v.1.1)) : TA'.EI V = ((v.1.1, q), v.1.2) ;
  tb (V : Ob) (v : FX.TF.EI V) (q : IsT (full V v.1.1)) : TB.EI V = toB V (FX.fibB V v) q ;

  tt (V : Ob) (v : FX.TF.EI V) (q : IsT (full V v.1.1)) (W : Ob) (f : Hom W V) (i : Hom W Iv) : TA'.EI W =
    fullOf W V f v.1.1 q (FX.fibL V v W f i) (FX.fibL-pt V v W f i) ;

  ttn (V : Ob) (v : FX.TF.EI V) (q : IsT (full V v.1.1)) (V' W : Ob) (g : Hom V' W) (f : Hom W V) (i : Hom W Iv)
    : Id (TA'.EI V') (TA'.E.act V' W g (tt V v q W f i)) (tt V v q V' (compH V' W V f g) (compH V' W Iv i g)) =
    toEA-inj V' (TA'.E.act V' W g (tt V v q W f i)) (tt V v q V' (compH V' W V f g) (compH V' W Iv i g))
      (FX.fibL-nat V v V' W g f i) ;

  ttp (V : Ob) (v : FX.TF.EI V) (q : IsT (full V v.1.1)) (W : Ob) (f : Hom W V) (i : Hom W Iv)
    : Id (W0.Ix (G'.ob W)) (tt V v q W f i).1 (G'.act W V f (tw V v q).1) =
    res-eq W (tt V v q W f i).1 (G'.act W V f (tw V v q).1) (FX.fibL-pt V v W f i) ;

  tt0 (V : Ob) (v : FX.TF.EI V) (q : IsT (full V v.1.1))
    : Id (TA'.EI V) (tt V v q V (idH V) (ptH V e0)) (al.mE V ((tw V v q).1, (tb V v q).2)) =
    toEA-inj V (tt V v q V (idH V) (ptH V e0)) (al.mE V ((tw V v q).1, (tb V v q).2))
      (transH (FX.fibL-0 V v)
        (transH (apH (extE V) (symH (fromB-toB V (FX.fibB V v) q))) (extE-B V (tb V v q)))) ;

  tt1 (V : Ob) (v : FX.TF.EI V) (q : IsT (full V v.1.1)) : Id (TA'.EI V) (tt V v q V (idH V) (ptH V e1)) (tw V v q) =
    toEA-inj V (tt V v q V (idH V) (ptH V e1)) (tw V v q) (FX.fibL-1 V v) ;

  toFA (V : Ob) (v : FX.TF.EI V) (q : IsT (full V v.1.1)) : FA.TF.EI V =
    FA.mkFib V (tw V v q) (tb V v q).2 (tt V v q) (ttn V v q) (ttp V v q) (tt0 V v q) (tt1 V v q) ;

  -- the data of fromFA
  fw (V : Ob) (v' : FA.TF.EI V) : TA.EI V = toEA V v'.1 ;
  fb (V : Ob) (v' : FA.TF.EI V) : TX.EI V = fromB V (FA.fibB V v') ;

  ft (V : Ob) (v' : FA.TF.EI V) (W : Ob) (f : Hom W V) (i : Hom W Iv) : TA.EI W = toEA W (FA.fibL V v' W f i) ;

  ft0 (V : Ob) (v' : FA.TF.EI V) : Id (TA.EI V) (ft V v' V (idH V) (ptH V e0)) (extE V (fb V v')) =
    transH (apH (toEA V) (FA.fibL-0 V v')) (symH (extE-B V (FA.fibB V v'))) ;

  fromFA (V : Ob) (v' : FA.TF.EI V) : FX.TF.EI V =
    FX.mkFib V (fw V v') (fb V v').2 (ft V v') (\ V' W g f i -> apH (toEA V') (FA.fibL-nat V v' V' W g f i))
      (\ W f i -> apH (\ z -> z.1) (FA.fibL-pt V v' W f i)) (ft0 V v') (apH (toEA V) (FA.fibL-1 V v')) ;

  -- the characterisations
  toFA-pt (V : Ob) (v : FX.TF.EI V) (q : IsT (full V v.1.1)) : Id (TA.EI V) (toEA V (toFA V v q).1) v.1 = refl v.1 ;

  toFA-B (V : Ob) (v : FX.TF.EI V) (q : IsT (full V v.1.1)) : Id (TB.EI V) (FA.fibB V (toFA V v q)) (toB V (FX.fibB V v) q) =
    refl (toB V (FX.fibB V v) q) ;

  toFA-L (V : Ob) (v : FX.TF.EI V) (q : IsT (full V v.1.1)) (W : Ob) (f : Hom W V) (i : Hom W Iv)
    : Id (TA.EI W) (toEA W (FA.fibL V (toFA V v q) W f i)) (FX.fibL V v W f i) = refl (FX.fibL V v W f i) ;

  fromFA-pt (V : Ob) (v' : FA.TF.EI V) : Id (TA.EI V) (fromFA V v').1 (toEA V v'.1) = refl (toEA V v'.1) ;

  fromFA-B (V : Ob) (v' : FA.TF.EI V) : Id (TX.EI V) (FX.fibB V (fromFA V v')) (fromB V (FA.fibB V v')) =
    refl (fromB V (FA.fibB V v')) ;

  fromFA-L (V : Ob) (v' : FA.TF.EI V) (W : Ob) (f : Hom W V) (i : Hom W Iv)
    : Id (TA.EI W) (FX.fibL V (fromFA V v') W f i) (toEA W (FA.fibL V v' W f i)) = refl (toEA W (FA.fibL V v' W f i)) ;

  opaque toFA ; opaque fromFA ; opaque toFA-pt ; opaque toFA-B ; opaque toFA-L ;
  opaque fromFA-pt ; opaque fromFA-B ; opaque fromFA-L ;

  fromFA-toFA (V : Ob) (v : FX.TF.EI V) (q : IsT (full V v.1.1)) : Id (FX.TF.EI V) (fromFA V (toFA V v q)) v =
    FX.fibE-eq V (fromFA V (toFA V v q)) v (transH (fromFA-pt V (toFA V v q)) (toFA-pt V v q))
      (transH (fromFA-B V (toFA V v q)) (transH (apH (fromB V) (toFA-B V v q)) (fromB-toB V (FX.fibB V v) q)))
      (\ W f i -> transH (fromFA-L V (toFA V v q) W f i) (toFA-L V v q W f i)) ;

  fromFA-inj (V : Ob) (v v' : FA.TF.EI V) (P : Id (FX.TF.EI V) (fromFA V v) (fromFA V v')) : Id (FA.TF.EI V) v v' =
    FA.fibE-eq V v v'
      (toEA-inj V v.1 v'.1 (transH (symH (fromFA-pt V v)) (transH (apH (\ z -> z.1) P) (fromFA-pt V v'))))
      (fromB-inj V (FA.fibB V v) (FA.fibB V v') (transH (symH (fromFA-B V v)) (transH (apH (FX.fibB V) P) (fromFA-B V v'))))
      (\ W f i -> toEA-inj W (FA.fibL V v W f i) (FA.fibL V v' W f i)
         (transH (symH (fromFA-L V v W f i)) (transH (apH (\ z -> FX.fibL V z W f i) P) (fromFA-L V v' W f i)))) ;

  fromFA-nat (W V : Ob) (h : Hom W V) (v' : FA.TF.EI V)
    : Id (FX.TF.EI W) (fromFA W (EFA.act W V h v')) (EFX.act W V h (fromFA V v')) =
    FX.fibE-eq W (fromFA W (EFA.act W V h v')) (EFX.act W V h (fromFA V v'))
      (transH (fromFA-pt W (EFA.act W V h v')) (apH (EA.act W V h) (symH (fromFA-pt V v'))))
      (transH (fromFA-B W (EFA.act W V h v'))
       (transH (apH (fromB W) (FA.fibB-act W V h v'))
        (transH (symH (actX-B W V h (FA.fibB V v')))
         (transH (apH (EX.act W V h) (symH (fromFA-B V v'))) (symH (FX.fibB-act W V h (fromFA V v')))))))
      (\ W' f i -> transH (fromFA-L W (EFA.act W V h v') W' f i)
                     (transH (apH (toEA W') (FA.fibL-act W V h v' W' f i))
                       (transH (symH (fromFA-L V v' W' (compH W' W V h f) i))
                               (symH (FX.fibL-act W V h (fromFA V v') W' f i))))) ;

  toFA-nat (W V : Ob) (h : Hom W V) (v : FX.TF.EI V) (q : IsT (full V v.1.1)) (q' : IsT (full W (EFX.act W V h v).1.1))
    : Id (FA.TF.EI W) (toFA W (EFX.act W V h v) q') (EFA.act W V h (toFA V v q)) =
    fromFA-inj W (toFA W (EFX.act W V h v) q') (EFA.act W V h (toFA V v q))
      (transH (fromFA-toFA W (EFX.act W V h v) q')
       (transH (apH (EFX.act W V h) (symH (fromFA-toFA V v q))) (symH (fromFA-nat W V h (toFA V v q))))) ;

  opaque fromFA-toFA ; opaque fromFA-inj ; opaque fromFA-nat ; opaque toFA-nat ;

  toFA-cong (V : Ob) (v v' : FX.TF.EI V) (P : Id (FX.TF.EI V) v v') (q : IsT (full V v.1.1)) (q' : IsT (full V v'.1.1))
    : Id (FA.TF.EI V) (toFA V v q) (toFA V v' q') =
    idJ (FX.TF.EI V) v (\ v2 P2 -> (q2 : IsT (full V v2.1.1)) -> Id (FA.TF.EI V) (toFA V v q) (toFA V v2 q2))
      (\ q2 -> apH (toFA V v) (isProp-IsT' (full V v.1.1) q q2)) v' P q' ;

  ----------------------------------------------------------------------
  -- Translating partial elements

  -- the point of EA' over a full point of EA
  wq (W : Ob) (w : TA.EI W) (q : IsT (full W w.1)) : TA'.EI W = ((w.1, q), w.2) ;

  module Tr (W : Ob) (w : TA.EI W) (q : IsT (full W w.1)) {
    qv (s : PX.PSide[W, w]) (V : Ob) (g : Hom V W) (i : Lands V W s.pQ g) : IsT (full V (s.pv V g i).1.1) =
      full-eq V (G.act V W g w.1) (s.pv V g i).1.1 (symH (apH (\ z -> z.1) (s.ppt V g i))) (full-act V W g w.1 q) ;

    tppt (s : PX.PSide[W, w]) : PA.PptTy W (wq W w q) s.pQ (\ V g i -> toFA V (s.pv V g i) (qv s V g i)) = \ V g i ->
      toEA-inj V (toFA V (s.pv V g i) (qv s V g i)).1 (EA'.act V W g (wq W w q))
        (transH (toFA-pt V (s.pv V g i) (qv s V g i)) (s.ppt V g i)) ;

    tpnat (s : PX.PSide[W, w]) : PA.PnTy W s.pQ (\ V g i -> toFA V (s.pv V g i) (qv s V g i)) = \ V' V chi g i i' ->
      transH (symH (toFA-nat V' V chi (s.pv V g i) (qv s V g i) (full-act V' V chi (s.pv V g i).1.1 (qv s V g i))))
             (toFA-cong V' (EFX.act V' V chi (s.pv V g i)) (s.pv V' (compH V' V W g chi) i') (s.pnat V' V chi g i i')
                (full-act V' V chi (s.pv V g i).1.1 (qv s V g i)) (qv s V' (compH V' V W g chi) i')) ;

    tside (s : PX.PSide[W, w]) : PA.PSide[W, wq W w q] =
      new PA.PSide[W, wq W w q, s.pQ, \ V g i -> toFA V (s.pv V g i) (qv s V g i), tppt s, tpnat s] ;

    tpcs (p : PX.Partial[W, w]) : PA.PCsTy W (wq W w q) p.pr (\ l -> tside (p.ps l)) = \ l j V g i i' ->
      toFA-cong V ((p.ps l).pv V g i) ((p.ps j).pv V g i') (p.pcs l j V g i i') (qv (p.ps l) V g i) (qv (p.ps j) V g i') ;

    opaque tppt ; opaque tpnat ; opaque tpcs ;

    TrP (p : PX.Partial[W, w]) : PA.Partial[W, wq W w q] = new PA.Partial[W, wq W w q, p.pr, \ l -> tside (p.ps l), tpcs p] ;
  } ;

  -- the extension of a translated partial element, read in E
  kE (W : Ob) (w : TA.EI W) (q : IsT (full W w.1)) (p : PX.Partial[W, w]) : FA.TF.EI W =
    (wq W w q, eal.kop W (wq W w q) (Tr[W, w, q].TrP p)) ;

  -- kE only depends on the partial element
  kE-cong (W : Ob) (w w' : TA.EI W) (P : Id (TA.EI W) w w') (q : IsT (full W w.1)) (q' : IsT (full W w'.1))
    (p : PX.Partial[W, w]) (p' : PX.Partial[W, w'])
    (R : Id (PX.Partial[W, w']) (subst (TA.EI W) (\ z -> PX.Partial[W, z]) w w' P p) p')
    : Id (FA.TF.EI W) (kE W w q p) (kE W w' q' p') =
    idJ (TA.EI W) w
      (\ w2 P2 -> (q2 : IsT (full W w2.1)) (p2 : PX.Partial[W, w2])
         -> Id (PX.Partial[W, w2]) (subst (TA.EI W) (\ z -> PX.Partial[W, z]) w w2 P2 p) p2
         -> Id (FA.TF.EI W) (kE W w q p) (kE W w2 q2 p2))
      (\ q2 p2 R2 -> idJ (PX.Partial[W, w]) p (\ p3 R3 -> Id (FA.TF.EI W) (kE W w q p) (kE W w q2 p3))
          (apH (\ z -> kE W w z p) (isProp-IsT' (full W w.1) q q2)) p2 R2)
      w' P q' p' R ;

  module KAct (W' W : Ob) (chi : Hom W' W) (w : TA.EI W) (q : IsT (full W w.1)) (q' : IsT (full W' (EA.act W' W chi w).1))
    (p : PX.Partial[W, w]) {
    module T = Tr[W, w, q] ;
    module T' = Tr[W', EA.act W' W chi w, q'] ;
    module R = PX.RestrictP[W', W, chi, w] ;

    x : TA'.EI W' = EA'.act W' W chi (wq W w q) ;
    x' : TA'.EI W' = wq W' (EA.act W' W chi w) q' ;

    P : Id (TA'.EI W') x x' = toEA-inj W' x x' (refl (EA.act W' W chi w)) ;

    pr1 : PA.Partial[W', x] = PA.restrictP W' W chi (wq W w q) (T.TrP p) ;
    pr2 : PA.Partial[W', x'] = T'.TrP (PX.restrictP W' W chi w p) ;

    ev : PA.EVT W' x x' pr1 pr2.pr pr2.ps (refl p.pr) = \ l V g i i' ->
      toFA-cong V ((p.ps l).pv V (compH V W' W chi g) (lands-pre V W' W chi (p.ps l).pQ g i))
                  ((p.ps l).pv V (compH V W' W chi g) (lands-pre V W' W chi (p.ps l).pQ g i'))
        (PX.pv-irr W w (p.ps l) V (compH V W' W chi g)
           (lands-pre V W' W chi (p.ps l).pQ g i) (lands-pre V W' W chi (p.ps l).pQ g i'))
        (T.qv (p.ps l) V (compH V W' W chi g) (lands-pre V W' W chi (p.ps l).pQ g i))
        (T'.qv (R.rside (p.ps l)) V g i') ;

    res : Id (FA.TF.EI W') (EFA.act W' W chi (kE W w q p)) (kE W' (EA.act W' W chi w) q' (PX.restrictP W' W chi w p)) =
      transH (eal.kunif W' W chi (wq W w q) (T.TrP p))
             (PA.kop-cong eal W' x x' P pr1 pr2
                (PA.partExtH W' x x' P pr1 pr2 (refl p.pr) (\ l -> refl (pre W' W chi (p.ps l).pQ)) ev)) ;
  } ;

  -- kE is uniform
  kE-act (W' W : Ob) (chi : Hom W' W) (w : TA.EI W) (q : IsT (full W w.1)) (q' : IsT (full W' (EA.act W' W chi w).1))
    (p : PX.Partial[W, w])
    : Id (FA.TF.EI W') (EFA.act W' W chi (kE W w q p)) (kE W' (EA.act W' W chi w) q' (PX.restrictP W' W chi w p)) =
    KAct[W', W, chi, w, q, q', p].res ;

  -- a full side gives the value
  kE-full (W : Ob) (w : TA.EI W) (q : IsT (full W w.1)) (p : PX.Partial[W, w]) (l : Fin p.pr)
    (i : Lands W W (p.ps l).pQ (idH W))
    : Id (FA.TF.EI W) (kE W w q p) (toFA W ((p.ps l).pv W (idH W) i) (Tr[W, w, q].qv (p.ps l) W (idH W) i)) =
    PA.kfull eal W (wq W w q) (Tr[W, w, q].TrP p) l i ;

  opaque kE-cong ; opaque kE-act ; opaque kE-full ;
} ;
