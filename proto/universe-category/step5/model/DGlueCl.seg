-- DGlueCl.seg: the classifier of Ext(alpha) on Delta (the glue
-- classifier), by cases on psi as Ext itself is (Thierry, 2026-10-15).
-- At a horn problem h at rho:
--
--   full rho     B's own horn operation hB, at the horn data read in B
--                (toB), its filler read back in Ext (fromB)
--   not full     fibToHorn of Ext's composition (DFibToHornSub.toCl)
--
--   clExt          the classifier, a horn operation on ExtT
--   clExt-full     on psi it is hB (the filler is fromB of hB's filler)
--   clExt-nfull    off psi it is toCl of Ext's composition
--
-- Used once, at the universal glue data (DSmallCl.hBig, level a+).
--
-- At any level lz >= a (the universal glue data live at a+).  The
-- classifiers along an equation of types are DClT.
--
-- Constructive.

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
open Axioms[lz+].FunExtLemmas[fe @(lz+)] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module DBm = DeltaBase[a] ;
module DB = DBm.DB ;
module DS = DBm.DS ;
module PR = DB.GPre[lz] ;
open PR.PS ;
module GP = DB.GCofib[lz] ;
module DCl = DeltaClassifier[a] ;
module DHm = DeltaHorn[a] ;
open DB.GLine[lz] ;
open Constr[a] ;


module GC (G : PCtx) (A : PTy[G]) (psi : GP.Cof[G]) (B : PTy[GP.CofL[G, psi].resCtx])
  (al : PMap[GP.CofL[G, psi].resCtx, B, subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR])
  (hB : DHornFib[a, lz].DH[GP.CofL[G, psi].resCtx, B].isFib)
  (cE : DB.GFibE[lz].FE[G, DB.GExt2[lz].ExtB2[G, A, psi, B, al].ExtT].Comp)
  (eE : DB.GFibE[lz].FE[G, DB.GExt2[lz].ExtB2[G, A, psi, B, al].ExtT].ESIC cE) {
  open GP.CofL[G, psi] ;
  module X3 = DB.GExt3[lz].ExtB3[G, A, psi, B, al] ;
  module E2 = DB.GExt2[lz].ExtB2[G, A, psi, B, al] ;
  FE : DB.GFibE[lz].FibEL G = (E2.ExtT, (cE, eE)) ;
  module HX = DHornFib[a, lz].DH[G, E2.ExtT] ;
  module HB = DHornFib[a, lz].DH[resCtx, B] ;
  module TX = PR.TyL[G, E2.ExtT] ;
  module TB = PR.TyL[resCtx, B] ;

  ----------------------------------------------------------------------
  -- at a full point: the horn data read in B, and the filler read back

  module Full (m k : Nat) (hk : IsT (leb k (suc m))) (rho : W0.Ix (G.ob (suc m))) (p : IsT (full (suc m) rho))
    (h : HX.HornData m k rho) {
    pW (W : Nat) (f : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (DHm.hornS m k) f) : IsT (full W (h.1 W f i).1) =
      full-eq W (G.act W (suc m) f rho) (h.1 W f i).1 (symH (h.2.1 W f i)) (full-act W (suc m) f rho p) ;

    bv (W : Nat) (f : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (DHm.hornS m k) f) : TB.EI W =
      X3.toB W (h.1 W f i) (pW W f i) ;

    bpp : GP.Partials[resCtx, B].PptTy (suc m) (rho, p) (DHm.hornS m k) bv =
      \ W f i -> res-eq W (bv W f i).1 (resCtx.act W (suc m) f (rho, p)) (h.2.1 W f i) ;

    -- fullness at a restricted value
    pA (W' W : Nat) (chi : Hom (lin W') (lin W)) (f : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (DHm.hornS m k) f)
      (i' : DS.Lands W' (suc m) (DHm.hornS m k) (compH (lin W') (lin W) (lin (suc m)) f chi))
      : IsT (full W' (TX.E.act W' W chi (h.1 W f i)).1) =
      full-eq W' (h.1 W' (compH (lin W') (lin W) (lin (suc m)) f chi) i').1 (TX.E.act W' W chi (h.1 W f i)).1
        (symH (apH (\ z -> z.1) (h.2.2 W' W chi f i i'))) (pW W' (compH (lin W') (lin W) (lin (suc m)) f chi) i') ;

    bpn : GP.Partials[resCtx, B].PnTy (suc m) (DHm.hornS m k) bv =
      \ W' W chi f i i' ->
        transH (symH (X3.toB-act W' W chi (h.1 W f i) (pW W f i) (pA W' W chi f i i')))
               (X3.toB-cong W' (TX.E.act W' W chi (h.1 W f i)) (h.1 W' (compH (lin W') (lin W) (lin (suc m)) f chi) i') (h.2.2 W' W chi f i i')
                  (pA W' W chi f i i') (pW W' (compH (lin W') (lin W) (lin (suc m)) f chi) i')) ;

    hd : HB.HornData m k (rho, p) = (bv, (bpp, bpn)) ;

    r : HB.Ext m k (rho, p) hd = hB m k hk (rho, p) hd ;

    w : TB.EI (suc m) = ((rho, p), r.1) ;

    res : HX.Ext m k rho h =
      ((X3.fromB (suc m) w).2,
       \ W f i -> transH (X3.actX-B W (suc m) f w)
                    (transH (apH (X3.fromB W) (r.2 W f i)) (X3.fromB-toB W (h.1 W f i) (pW W f i)))) ;

    -- the filler is fromB of hB's filler
    res-E : Id (TX.EI (suc m)) (rho, res.1) (X3.fromB (suc m) w) = refl (X3.fromB (suc m) w) ;

    opaque res ;
  } ;

  -- by cases on full
  caseF (m k : Nat) (hk : IsT (leb k (suc m))) (rho : W0.Ix (G.ob (suc m))) (h : HX.HornData m k rho)
    : (c : Bool) -> Id Bool (full (suc m) rho) c -> HX.Ext m k rho h = split {
    true -> \ e -> Full[m, k, hk, rho, e, h].res ;
    false -> \ e -> DeltaRetr[a, lz].BoxToHorn[G, FE.1, FE.2.1.1, FE.2.1.2].isFib-of-comp m k hk rho h } ;

  clExt : HX.isFib = \ m k hk rho h -> caseF m k hk rho h (full (suc m) rho) (refl (full (suc m) rho)) ;

  ----------------------------------------------------------------------
  -- the two cases

  cf-full (m k : Nat) (hk : IsT (leb k (suc m))) (rho : W0.Ix (G.ob (suc m))) (h : HX.HornData m k rho) (p : IsT (full (suc m) rho))
    : (c : Bool) (e : Id Bool (full (suc m) rho) c) -> Id (HX.Ext m k rho h) (caseF m k hk rho h c e) Full[m, k, hk, rho, p, h].res = split {
    true -> \ e -> apH (\ q -> Full[m, k, hk, rho, q, h].res) (isProp-IsT' (full (suc m) rho) e p) ;
    false -> \ e -> absurd _ (false-true (transH (symH e) p)) } ;

  cf-nfull (m k : Nat) (hk : IsT (leb k (suc m))) (rho : W0.Ix (G.ob (suc m))) (h : HX.HornData m k rho)
    (np : Id Bool (full (suc m) rho) false)
    : (c : Bool) (e : Id Bool (full (suc m) rho) c) -> Id (HX.Ext m k rho h) (caseF m k hk rho h c e) (DeltaRetr[a, lz].BoxToHorn[G, FE.1, FE.2.1.1, FE.2.1.2].isFib-of-comp m k hk rho h) = split {
    true -> \ e -> absurd _ (false-true (transH (symH np) e)) ;
    false -> \ e -> refl (DeltaRetr[a, lz].BoxToHorn[G, FE.1, FE.2.1.1, FE.2.1.2].isFib-of-comp m k hk rho h) } ;

  clExt-full (m k : Nat) (hk : IsT (leb k (suc m))) (rho : W0.Ix (G.ob (suc m))) (p : IsT (full (suc m) rho)) (h : HX.HornData m k rho)
    : Id (HX.Ext m k rho h) (clExt m k hk rho h) Full[m, k, hk, rho, p, h].res =
    cf-full m k hk rho h p (full (suc m) rho) (refl (full (suc m) rho)) ;

  clExt-nfull (m k : Nat) (hk : IsT (leb k (suc m))) (rho : W0.Ix (G.ob (suc m))) (np : Id Bool (full (suc m) rho) false) (h : HX.HornData m k rho)
    : Id (HX.Ext m k rho h) (clExt m k hk rho h) (DeltaRetr[a, lz].BoxToHorn[G, FE.1, FE.2.1.1, FE.2.1.2].isFib-of-comp m k hk rho h) =
    cf-nfull m k hk rho h np (full (suc m) rho) (refl (full (suc m) rho)) ;

  opaque clExt ;
} ;

