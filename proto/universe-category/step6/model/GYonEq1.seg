-- GYonEq1.seg (inside IvBase, any base): equivalence structures glue
-- along the Yoneda maps of the points, part 1 (step G3d).
--
-- (B , A , al) over D.  For each point x of D at Z, a local equivalence
-- structure L Z x on the triple along sigma_x = yPt D Z x (triY), coherent
-- (coh: L at x h is eqDSub (y h) of L at x, an Id of data).  Then al has an
-- equivalence structure over D:
--   K1      L Z x moved to C[ls_x] (C the fibre type of al over E_A,
--           ls_x the lift of sigma_x) by FibIso and ContrRet
--   pull    a partial element of C at (x , a) is one of C[ls_x] at
--           u0 = (id , a)
--   kop     K1's extension at u0, read in E_C; kside from K1's
-- kunif (from coh) and KESI are in GYonEq2.

level lv ;
constraint a <= lv ;
open Base ;
open Prelude[lv+] ;
open Paths[lv+] ;
module W0 = V[lv] ;
open Trees[a] ;
open Arith[a] ;
module GPR = GPre[lv] ;
open GPR.PS ;
open GYon[lv] ;
open GLine[lv] ;
module GCF = GCofib[lv] ;
module GCE = GCofEsi[lv] ;
module GQ = GEquiv[lv] ;
module GSB = GEquivSub[lv] ;
module GSB2 = GEquivSub2[lv] ;
module GX = GEqExt[lv] ;
module GL = GEqLaws[lv] ;

-- the triple along the Yoneda map of x
triY (D : PCtx) (B A : PTy[D]) (al : PMap[D, B, A]) (Z : Ob) (x : W0.Ix (D.ob Z)) : GX.EqDat[yP Z].Tri =
  (subTy (yP Z) D B (yPt D Z x), (subTy (yP Z) D A (yPt D Z x), GSB.SubMap[yP Z, D, yPt D Z x, B, A, al].subMap)) ;

module YE (D : PCtx) (B A : PTy[D]) (al : PMap[D, B, A])
  (L : (Z : Ob) (x : W0.Ix (D.ob Z)) -> GX.EqDat[yP Z].EqOn (triY D B A al Z x))
  (coh : (Z Z' : Ob) (h : Hom Z' Z) (x : W0.Ix (D.ob Z))
     -> Id ((u : GX.EqDat[yP Z'].Tri) * GX.EqDat[yP Z'].EqOn u)
           (GL.eqDSub (yP Z') (yP Z) (yH Z' Z h) (triY D B A al Z x) (L Z x))
           (triY D B A al Z' (D.act Z' Z h x), L Z' (D.act Z' Z h x))) {
  module HG = GQ.HFib[D, B, A, al] ;
  module TC = GPR.TyL[HG.EA, HG.FibT] ;
  module TA = GPR.TyL[D, A] ;
  module P = GCF.Partials[HG.EA, HG.FibT] ;

  module Lx (Z : Ob) (x : W0.Ix (D.ob Z)) {
    sg : PSub[yP Z, D] = yPt D Z x ;
    module FI = GSB2.FibIso[yP Z, D, sg, B, A, al] ;
    module S = FI.SC ;
    module PS = GCF.Partials[FI.HD.EA, FI.C] ;

    module CR = GCF.ContrRet[FI.HD.EA, FI.HD.FibT, FI.C, FI.s', \ W v -> refl v.1, FI.snat, FI.r, \ W v -> refl v.1, FI.rnat, FI.sr, (L Z x).1] ;

    K1 : PS.ContrOp = CR.contr ;

    -- the point (id , a) over x, and its image (x , a)
    a0 (a : TA.T Z x) : W0.Ix (A.tob Z (D.act Z Z (idH Z) x)) = TA.coeT Z x (D.act Z Z (idH Z) x) (symH (D.act-id Z x)) a ;

    u0 (a : TA.T Z x) : W0.Ix (FI.HD.EA.ob Z) = (idH Z, a0 a) ;

    p0 (a : TA.T Z x) : Id (TA.EI Z) (FI.ls.nt Z (u0 a)) (x, a) =
      symH (TA.pr-coe Z x (D.act Z Z (idH Z) x) (symH (D.act-id Z x)) a) ;

    -- the point (x , a) f, as the lift of (id , a) f
    pf (a : TA.T Z x) (W : Ob) (f : Hom W Z)
      : Id (TA.EI W) (TA.E.act W Z f (x, a)) (FI.ls.nt W (FI.HD.EA.act W Z f (u0 a))) =
      transH (apH (TA.E.act W Z f) (symH (p0 a))) (symH (FI.ls.nt-nat W Z f (u0 a))) ;

    module Pl (a : TA.T Z x) {
      pv (s : P.PSide[Z, (x, a)]) (W : Ob) (f : Hom W Z) (i : Lands W Z s.pQ f) : S.TS.EI W =
        (FI.HD.EA.act W Z f (u0 a),
         TC.fromE W (FI.ls.nt W (FI.HD.EA.act W Z f (u0 a))) (s.pv W f i) (transH (s.ppt W f i) (pf a W f))) ;

      pv-E (s : P.PSide[Z, (x, a)]) (W : Ob) (f : Hom W Z) (i : Lands W Z s.pQ f) : Id (TC.EI W) (S.mV W (pv s W f i)) (s.pv W f i) =
        TC.fromE-eq W (FI.ls.nt W (FI.HD.EA.act W Z f (u0 a))) (s.pv W f i) (transH (s.ppt W f i) (pf a W f)) ;

      pside (s : P.PSide[Z, (x, a)]) : PS.PSide[Z, u0 a] =
        new PS.PSide[Z, u0 a, s.pQ, pv s,
          \ W f i -> refl (FI.HD.EA.act W Z f (u0 a)),
          \ W' W chi f i i' ->
            S.mV-inj W' (S.TS.E.act W' W chi (pv s W f i)) (pv s W' (compH W' W Z f chi) i')
              (symH (FI.HD.EA.act-o W' W Z f chi (u0 a)))
              (transH (S.mV-nat W' W chi (pv s W f i))
                (transH (apH (TC.E.act W' W chi) (pv-E s W f i))
                  (transH (s.pnat W' W chi f i i') (symH (pv-E s W' (compH W' W Z f chi) i')))))] ;

      pull (p : P.Partial[Z, (x, a)]) : PS.Partial[Z, u0 a] =
        new PS.Partial[Z, u0 a, p.pr, \ l -> pside (p.ps l),
          \ l j W f i i' -> S.mV-inj W (pv (p.ps l) W f i) (pv (p.ps j) W f i') (refl (FI.HD.EA.act W Z f (u0 a)))
             (transH (pv-E (p.ps l) W f i) (transH (p.pcs l j W f i i') (symH (pv-E (p.ps j) W f i'))))] ;

      kE (p : P.Partial[Z, (x, a)]) : TC.EI Z = S.mV Z (u0 a, K1.kop Z (u0 a) (pull p)) ;

      kop (p : P.Partial[Z, (x, a)]) : TC.T Z (x, a) = TC.fromE Z (x, a) (kE p) (p0 a) ;

      kop-E (p : P.Partial[Z, (x, a)]) : Id (TC.EI Z) ((x, a), kop p) (kE p) = TC.fromE-eq Z (x, a) (kE p) (p0 a) ;
    } ;
  } ;

  kop (Z : Ob) (w : TA.EI Z) (p : P.Partial[Z, w]) : TC.T Z w = Lx[Z, w.1].Pl[w.2].kop p ;

  kside (Z : Ob) (w : TA.EI Z) (p : P.Partial[Z, w]) (l : Fin p.pr) (W : Ob) (f : Hom W Z) (i : Lands W Z (p.ps l).pQ f)
    : Id (TC.EI W) (TC.E.act W Z f (w, kop Z w p)) ((p.ps l).pv W f i) =
    calc (TC.EI W) {
        TC.E.act W Z f (w, kop Z w p)
      =< apH (TC.E.act W Z f) (Lx[Z, w.1].Pl[w.2].kop-E p) >
        TC.E.act W Z f (Lx[Z, w.1].S.mV Z (Lx[Z, w.1].u0 w.2, Lx[Z, w.1].K1.kop Z (Lx[Z, w.1].u0 w.2) (Lx[Z, w.1].Pl[w.2].pull p)))
      =< symH (Lx[Z, w.1].S.mV-nat W Z f (Lx[Z, w.1].u0 w.2, Lx[Z, w.1].K1.kop Z (Lx[Z, w.1].u0 w.2) (Lx[Z, w.1].Pl[w.2].pull p))) >
        Lx[Z, w.1].S.mV W (Lx[Z, w.1].S.TS.E.act W Z f (Lx[Z, w.1].u0 w.2, Lx[Z, w.1].K1.kop Z (Lx[Z, w.1].u0 w.2) (Lx[Z, w.1].Pl[w.2].pull p)))
      =< apH (Lx[Z, w.1].S.mV W) (Lx[Z, w.1].K1.kside Z (Lx[Z, w.1].u0 w.2) (Lx[Z, w.1].Pl[w.2].pull p) l W f i) >
        Lx[Z, w.1].S.mV W (Lx[Z, w.1].Pl[w.2].pv (p.ps l) W f i)
      =< Lx[Z, w.1].Pl[w.2].pv-E (p.ps l) W f i >
        (p.ps l).pv W f i } ;
} ;
