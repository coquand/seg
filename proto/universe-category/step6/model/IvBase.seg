  -- with connections on the interval (G-S (1.2), (1.3)), as operations on
  -- maps into Iv:  cI i src = src,  cI i tgt = i,  cI src j = src,  cI tgt j = j
  module Cn {
    cI (d : Bool) (W : Ob) (i j : Hom W Iv) : Hom W Iv ;
    cI-nat (d : Bool) (V W : Ob) (g : Hom V W) (i j : Hom W Iv)
      : Id (Hom V Iv) (compH V W Iv (cI d W i j) g) (cI d V (compH V W Iv i g) (compH V W Iv j g)) ;
    cI-jsrc (d : Bool) (W : Ob) (i : Hom W Iv) : Id (Hom W Iv) (cI d W i (ptH W (src d))) (ptH W (src d)) ;
    cI-jtgt (d : Bool) (W : Ob) (i : Hom W Iv) : Id (Hom W Iv) (cI d W i (ptH W (tgt d))) i ;
    cI-isrc (d : Bool) (W : Ob) (j : Hom W Iv) : Id (Hom W Iv) (cI d W (ptH W (src d)) j) (ptH W (src d)) ;
    cI-itgt (d : Bool) (W : Ob) (j : Hom W Iv) : Id (Hom W Iv) (cI d W (ptH W (tgt d)) j) j ;

    import GConn ;
    import GFill ;
    import GFillFib ;
    import GPiFib ;
    import GFibFill ;
