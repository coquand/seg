    import GTE6 ;
    import GTE7 ;
    import GTE8 ;
    import GTE9 ;
    import GTE10 ;
    import GTE11 ;
    import GTE12 ;
    import GTE13 ;
    import GTE14 ;
    import GTE15 ;
    import GTE16 ;
    import GCompU1 ;
    import GCompU2 ;
    import GCompU3 ;
    import GCompU4 ;
    import GCompU5 ;
  } ;

  -- forall of a union of lines (instances: Constr.PFaU, DeltaForall.DFaU);
  -- after the line layer, so that the files nested in it see it
  module FaU {
    -- the length of the list depends only on the number of lines (posets:
    -- one sieve per line; Delta: one sieve), so restriction keeps it
    forallUn (k : Nat) : Nat ;
    forallU (X : Ob) (k : Nat) (Ls : Arith[a].Fin k -> PhiL X) : Arith[a].Fin (forallUn k) -> Phi X ;
    landsU-forall (W X : Ob) (k : Nat) (Ls : Arith[a].Fin k -> PhiL X) (f : Hom W X)
      (i : (l : Arith[a].Fin (forallUn k)) * Lands W X (forallU X k Ls l) f) : HoldsU X k Ls W f ;
    forallU-lands (W X : Ob) (k : Nat) (Ls : Arith[a].Fin k -> PhiL X) (f : Hom W X)
      (h : HoldsU X k Ls W f) : (l : Arith[a].Fin (forallUn k)) * Lands W X (forallU X k Ls l) f ;
    -- the list is stable under restriction: the restricted generators are
    -- the generators of the restricted lines (so the partial elements built
    -- on it restrict side by side; posets: forall-pre per line; Delta: one
    -- decidable sieve)
    forallU-pre (Y X : Ob) (h : Hom Y X) (k : Nat) (Ls : Arith[a].Fin k -> PhiL X) (l : Arith[a].Fin (forallUn k))
      : Id (Phi Y) (pre Y X h (forallU X k Ls l)) (forallU Y k (\ l' -> restrL Y X h (Ls l')) l) ;

    -- Theorem 7's composition (delta = forall of the union of psi)
    import GExtComp2 ;
    import GExtComp3 ;
    import GExtComp4 ;
