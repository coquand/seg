-- DeltaHornBox.seg (inside Classical.Cl): horn filling gives box filling on
-- Delta, uniformly, using excluded middle at ONE point.
--
-- THE CLASSICAL STEP (decDeg, the only use of lem in the model).  A filling
-- problem b at [N+1] (DStageA.Prob) is DEGENERATE along the elementary
-- degeneracy s_i when b = s_i^* (d_i^* b).  This is an equation between
-- partial elements of A, which is not decidable constructively; it is a
-- proposition (ProbRel: point and sides compared in sets), so lem decides
-- it.  Searching i = 0 .. N (firstDeg) tells whether b is degenerate, and
-- along which first s_i.
--
-- Why it is needed: the fillers of DFill (4a, constructive) are uniform
-- along the FACE maps only.  The normalised fillers (DeltaHornBox2) are
-- s_i^* (filler of d_i^* b) on degenerate problems, the 4a step on the
-- others; that is the Eilenberg-Zilber normalisation, done by recursion,
-- and it is what makes them uniform along the degeneracies too.  No choice
-- is made: the horn filling operation is a structure (DeltaHorn.isFib).

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
open Axioms[lz+].FunExtLemmas[fe @(lz+)] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open DLvl[a, lz] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open Constr[a] ;
open Simp[a] ;
module DBm = DeltaBase[a] ;
module DB = DBm.DB ;

module HB1 (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (e : El Iv) {
  module SAm = DStageA[a, lz].SA[G, A, e] ;
  open SAm ;

  ----------------------------------------------------------------------
  -- equality of problems, as a proposition

  ProbRel (M : Nat) (b b' : Prob M) : U lz =
    (P : Id (KA.TV.EI M) b.1 b'.1)
    * ((e : Id Nat b.2.pr b'.2.pr) * (KA.PT.EQT M b.1 b'.1 b.2 b'.2.pr b'.2.ps e * KA.PT.EVT M b.1 b'.1 b.2 b'.2.pr b'.2.ps e)) ;

  rel-id (M : Nat) (b b' : Prob M) (r : ProbRel M b b') : Id (Prob M) b b' =
    Sigma-path (KA.TV.EI M) (\ z -> KA.PT.Partial[M, z]) b.1 b'.1 b.2 b'.2 r.1
      (KA.PT.partExtH M b.1 b'.1 r.1 b.2 b'.2 r.2.1 r.2.2.1 r.2.2.2) ;

  id-rel (M : Nat) (b b' : Prob M) (E : Id (Prob M) b b') : ProbRel M b b' =
    idJ (Prob M) b (\ c E2 -> ProbRel M b c)
      (refl b.1, (refl b.2.pr, (\ l -> refl (b.2.ps l).pQ, \ l W f i i' -> KA.PT.pv-irr M b.1 (b.2.ps l) W f i i'))) b' E ;

  isProp-rel (M : Nat) (b b' : Prob M) : isProp (ProbRel M b b') =
    isProp-Sigma (Id (KA.TV.EI M) b.1 b'.1)
      (\ P -> (e : Id Nat b.2.pr b'.2.pr) * (KA.PT.EQT M b.1 b'.1 b.2 b'.2.pr b'.2.ps e * KA.PT.EVT M b.1 b'.1 b.2 b'.2.pr b'.2.ps e))
      (W0.isSetIx (KA.TV.E.ob M) b.1 b'.1)
      (\ P -> isProp-Sigma (Id Nat b.2.pr b'.2.pr)
         (\ e -> KA.PT.EQT M b.1 b'.1 b.2 b'.2.pr b'.2.ps e * KA.PT.EVT M b.1 b'.1 b.2 b'.2.pr b'.2.ps e)
         (isSet-Nat b.2.pr b'.2.pr)
         (\ e -> isProp-Sigma (KA.PT.EQT M b.1 b'.1 b.2 b'.2.pr b'.2.ps e) (\ q -> KA.PT.EVT M b.1 b'.1 b.2 b'.2.pr b'.2.ps e)
            (isProp-Pi (Fin b.2.pr) (\ l -> Id (DB.Phi M) (b.2.ps l).pQ (b'.2.ps (subst Nat (\ n -> Fin n) b.2.pr b'.2.pr e l)).pQ)
               (\ l -> DB.isSet-Phi M (b.2.ps l).pQ (b'.2.ps (subst Nat (\ n -> Fin n) b.2.pr b'.2.pr e l)).pQ))
            (\ q -> isProp-Pi (Fin b.2.pr) (\ l -> KA.PT.PvEq M (b.2.ps l).pQ (b'.2.ps (subst Nat (\ n -> Fin n) b.2.pr b'.2.pr e l)).pQ
                                                     (b.2.ps l).pv (b'.2.ps (subst Nat (\ n -> Fin n) b.2.pr b'.2.pr e l)).pv)
               (\ l -> isProp-Pi Nat (\ W -> (f : Hom (lin W) (lin M)) (i : DB.Lands W M (b.2.ps l).pQ f)
                                         (i' : DB.Lands W M (b'.2.ps (subst Nat (\ n -> Fin n) b.2.pr b'.2.pr e l)).pQ f)
                                         -> Id (KA.TS.EI W) ((b.2.ps l).pv W f i) ((b'.2.ps (subst Nat (\ n -> Fin n) b.2.pr b'.2.pr e l)).pv W f i'))
                 (\ W -> isProp-Pi (Hom (lin W) (lin M)) (\ f -> (i : DB.Lands W M (b.2.ps l).pQ f)
                                         (i' : DB.Lands W M (b'.2.ps (subst Nat (\ n -> Fin n) b.2.pr b'.2.pr e l)).pQ f)
                                         -> Id (KA.TS.EI W) ((b.2.ps l).pv W f i) ((b'.2.ps (subst Nat (\ n -> Fin n) b.2.pr b'.2.pr e l)).pv W f i'))
                   (\ f -> isProp-Pi (DB.Lands W M (b.2.ps l).pQ f) (\ i -> (i' : DB.Lands W M (b'.2.ps (subst Nat (\ n -> Fin n) b.2.pr b'.2.pr e l)).pQ f)
                                         -> Id (KA.TS.EI W) ((b.2.ps l).pv W f i) ((b'.2.ps (subst Nat (\ n -> Fin n) b.2.pr b'.2.pr e l)).pv W f i'))
                     (\ i -> isProp-Pi (DB.Lands W M (b'.2.ps (subst Nat (\ n -> Fin n) b.2.pr b'.2.pr e l)).pQ f)
                               (\ i' -> Id (KA.TS.EI W) ((b.2.ps l).pv W f i) ((b'.2.ps (subst Nat (\ n -> Fin n) b.2.pr b'.2.pr e l)).pv W f i'))
                       (\ i' -> W0.isSetIx (KA.TS.E.ob W) ((b.2.ps l).pv W f i) ((b'.2.ps (subst Nat (\ n -> Fin n) b.2.pr b'.2.pr e l)).pv W f i'))))))))) ;

  ----------------------------------------------------------------------
  -- degeneracy along s_i

  DegR (N : Nat) (b : Prob (suc N)) (i : Nat) : U lz =
    ProbRel (suc N) b (resP (suc N) N (dgH N i) (resP N (suc N) (dl N i) b)) ;

  -- THE CLASSICAL STEP: the only use of lem
  decDeg (N : Nat) (b : Prob (suc N)) (i : Nat) : Arith[lz].Plus (DegR N b i) (DegR N b i -> Empty) =
    lem @lz (DegR N b i) (isProp-rel (suc N) b (resP (suc N) N (dgH N i) (resP N (suc N) (dl N i) b))) ;

  -- the first i <= k along which b is degenerate (with its minimality), or none
  Found (N : Nat) (b : Prob (suc N)) (k : Nat) : U lz =
    PlusL ((i : Nat) * (IsT (leb i k) * (DegR N b i * ((i' : Nat) -> IsT (ltb i' i) -> DegR N b i' -> Empty))))
                  ((i : Nat) -> IsT (leb i k) -> DegR N b i -> Empty) ;

  search (N : Nat) (b : Prob (suc N)) : (k : Nat) -> Found N b k = split {
    zero -> z0 (decDeg N b zero) ;
    suc k -> sk k (search N b k) }
   where {
     z0 : Arith[lz].Plus (DegR N b zero) (DegR N b zero -> Empty) -> Found N b zero = split {
       inl d -> inlL (zero, (refl true, (d, \ i' lt d' -> absurd _ (false-true lt)))) ;
       inr n -> inrL (\ i hi d -> n (substH (\ x -> DegR N b x) (leb-zero i hi) d)) } ;
     sk (k : Nat) : Found N b k -> Found N b (suc k) = split {
       inlL w -> inlL (w.1, (leb-step w.1 k w.2.1, w.2.2)) ;
       inrL n -> sk2 k n (decDeg N b (suc k)) } ;
     sk2 (k : Nat) (n : (i : Nat) -> IsT (leb i k) -> DegR N b i -> Empty) : Arith[lz].Plus (DegR N b (suc k)) (DegR N b (suc k) -> Empty) -> Found N b (suc k) = split {
       inl d -> inlL (suc k, (leb-refl k, (d, \ i' lt d' -> n i' lt d'))) ;
       inr n' -> inrL (\ i hi d -> orE Empty (eqN i (suc k)) (leb i k) (leb-suc-split i k hi)
                                     (\ q -> n' (substH (\ x -> DegR N b x) (eqN-sound i (suc k) q) d))
                                     (\ q -> n i q d)) } ; } ;

  -- the decision, as the normalised fillers use it (DNormA.DegFound)
  toFound (N : Nat) (b : Prob (suc N)) : Found N b N -> DNormA[a, lz].NA[G, A, e].DegFound N b = split {
    inlL w -> inlL (w.1, (w.2.1, (rel-id (suc N) b _ w.2.2.1,
                    \ i' lt d -> w.2.2.2 i' lt (id-rel (suc N) b _ d)))) ;
    inrL n -> inrL (\ i hi d -> n i hi (id-rel (suc N) b _ d)) } ;

  deg (N : Nat) (b : Prob (suc N)) : DNormA[a, lz].NA[G, A, e].DegFound N b = toFound N b (search N b N) ;
} ;
