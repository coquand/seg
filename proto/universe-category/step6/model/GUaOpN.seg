-- GUaOpN.seg (inside IvBase.FaU, any base; Step 3): the univalence
-- operation from the universal datum U, as a contractibility structure on
-- the sides of UaTy (Sigma (X : U) Equiv (X , A) is contractible,
-- uniformly; lists of sides through their union, GCofOne.Wrap):
--   kop     U along the Yoneda map of d_p (GUaUniv.KP)
--   kunif   GUaUniv.KUn
--   kside   kunif along f, then kfull at the side restricted along f
--           (GUaKfull), which contains id
-- The classifier's parameters: smallCl, smallCl-sub, smallCl-full.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
open GLine[a] ;
module GE1 = GFibE[a+] ;

module UaN (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (cE : GE1.FE[GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Comp)
  (eE : GE1.FE[GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].ESIC cE)
  (kU0 : GLine[a+].LineFibP[GFam[a+].famPath, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].FibAt e0)
  (kU1 : GLine[a+].LineFibP[GFam[a+].famPath, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].FibAt e1)
  (kU0e : GCofEsi[a+].PartialsEsi[GLine[a+].EndKit[GFam[a+].famPath, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen, e0].TV.E,
            GLine[a+].EndKit[GFam[a+].famPath, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen, e0].SFm.SF].KESI kU0)
  (kU1e : GCofEsi[a+].PartialsEsi[GLine[a+].EndKit[GFam[a+].famPath, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen, e1].TV.E,
            GLine[a+].EndKit[GFam[a+].famPath, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen, e1].SFm.SF].KESI kU1)
  (smallCl : (D : PCtx) (al : GSmall.XSub[D, GExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr])
     -> Cl D (GSmall.xsub D GExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr GExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, kU0, kU1, kU0e, kU1e].SA al))
  (smallCl-sub : (D D' : PCtx) (t : PSub[D', D]) (al : GSmall.XSub[D, GExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr])
     -> Id ((T : PTy[D']) * Cl D' T)
           (subTy D' D (GSmall.xsub D GExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr GExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, kU0, kU1, kU0e, kU1e].SA al) t,
            clSub D' D t (GSmall.xsub D GExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr GExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, kU0, kU1, kU0e, kU1e].SA al) (smallCl D al))
           (GSmall.xsub D' GExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr GExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, kU0, kU1, kU0e, kU1e].SA
              (GSmall.xoS D' D GExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr al t),
            smallCl D' (GSmall.xoS D' D GExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr al t)))
  (smallCl-full : (X : Ob) (w : GExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].Pr X) (fu : IsT (GExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].CU.full X w))
     -> Id ((T : PTy[yP X]) * Cl (yP X) T)
           (GSmall.xsub (yP X) GExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr GExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, kU0, kU1, kU0e, kU1e].SA (GUaUniv.YD[Cl, clSub, clSub-id, clSub-o, encCl].yon X w),
            smallCl (yP X) (GUaUniv.YD[Cl, clSub, clSub-id, clSub-o, encCl].yon X w))
           (GExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].bmap.nt X (w, fu)))
  {
  module UA = GUnivEq.UaU[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UU = UA.UU ;
  module PPa = GCofib[a+].Partials[UU.UCtx, UA.UaTy] ;
  module TC = GPre[a+].TyL[UU.UCtx, UA.UaTy] ;

  kop (X : Ob) (F : UU.U0 X) (sd : PPa.PSide[X, F]) : UA.UaT0 X F =
    GUaUniv.KP[Cl, clSub, clSub-id, clSub-o, encCl, cE, eE, kU0, kU1, kU0e, kU1e, smallCl, smallCl-sub, X, F, sd].kop ;

  kunif (Y X : Ob) (h : Hom Y X) (F : UU.U0 X) (sd : PPa.PSide[X, F])
    : Id (TC.EI Y) (TC.E.act Y X h (F, kop X F sd)) (UU.uAct Y X h F, kop Y (UU.uAct Y X h F) (PPa.RestrictP[Y, X, h, F].rside sd)) =
    GUaUniv.KUn[Cl, clSub, clSub-id, clSub-o, encCl, cE, eE, kU0, kU1, kU0e, kU1e, smallCl, smallCl-sub, X, F, sd, Y, h].kunif ;

  -- the side at f contains the identity
  il0 (X : Ob) (F : UU.U0 X) (sd : PPa.PSide[X, F]) (W : Ob) (f : Hom W X) (i : Lands W X sd.pQ f)
    : Lands W W (pre W X f sd.pQ) (idH W) =
    pre-lands W W X f sd.pQ (idH W) (lands-eq W X sd.pQ f (compH W W X f (idH W)) (symH (comp-idr W X f)) i) ;

  kside (X : Ob) (F : UU.U0 X) (sd : PPa.PSide[X, F]) (W : Ob) (f : Hom W X) (i : Lands W X sd.pQ f)
    : Id (TC.EI W) (TC.E.act W X f (F, kop X F sd)) (sd.pv W f i) =
    transH (kunif W X f F sd)
      (transH (GUaKfull.KF[Cl, clSub, clSub-id, clSub-o, encCl, cE, eE, kU0, kU1, kU0e, kU1e, smallCl, smallCl-sub, smallCl-full,
                 W, UU.uAct W X f F, PPa.RestrictP[W, X, f, F].rside sd, il0 X F sd W f i].kfull)
              (PPa.pv-hom X F sd W (compH W W X f (idH W)) f (comp-idr W X f)
                 (lands-pre W W X f sd.pQ (idH W) (il0 X F sd W f i)) i)) ;

  -- univalence: Sigma (X : U) Equiv (X , A) is contractible, uniformly, on sides
  ua : PPa.ContrOp1 = new PPa.ContrOp1[kop, kside, kunif] ;
} ;
