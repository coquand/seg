-- GExtBig.seg (inside IvBase, any base; Step 2 probe): Ext of the universal
-- glue data, at level a+.  GDr is the presheaf of glue data with their
-- equivalence structures (GGlueE.GD1Ctx).  Over it:
--   AU     El along the A-component (EGen pulled back along pA)
--   psiU   the cofibration whose sieve at a point is the point's sieve
--   BU     El along the B-component at the identity (bmap)
--   alU    alpha at the identity
--   ExtBig Ext of these data (GExt2 at level a+)
-- AU and BU are EGen pulled back, so their fillers are El's pulled back.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;

module UB (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A)) {
  module UU = GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module DD = GGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module EE = GGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;

  ----------------------------------------------------------------------
  -- the glue data

  Pr (I : Ob) : U a+ = EE.GD1 I ;

  actR (J I : Ob) (h : Hom J I) (w : Pr I) : Pr J = EE.act1 J I h w ;

  actR-id (I : Ob) (w : Pr I) : Id (Pr I) (actR I I (idH I) w) w = EE.gd1-id I w ;

  actR-o (K J I : Ob) (h : Hom J I) (k : Hom K J) (w : Pr I) : Id (Pr K) (actR K I (compH K J I h k) w) (actR K J k (actR J I h w)) =
    EE.gd1-o K J I h k w ;

  GDr : L.PCtx = EE.GD1Ctx ;

  ----------------------------------------------------------------------
  -- the universal data

  pA : L.PSub[GDr, UU.UCtx] = new L.PSub[GDr, UU.UCtx, \ I w -> w.1, \ J I h w -> refl (UU.uAct J I h w.1)] ;

  AU : L.PTy[GDr] = L.subTy GDr UU.UCtx UU.EGen pA ;

  psiU : GCofib[a+].Cof[GDr] =
    GCofib[a+].mkCof GDr (suc zero) (\ X w l -> w.2.1) (\ Y X k w l -> refl (pre Y X k w.2.1)) ;

  module CU = GCofib[a+].CofL[GDr, psiU] ;

  -- at a full point, the identity is in the extent of the point's list
  qU (Y : Ob) (w : Pr Y) (fu : IsT (CU.full Y w)) : IsT (GGlueD.fl Y w.2.1 Y (idH Y)) =
    allS-complete Y (pre Y Y (idH Y) w.2.1)
      (lands-sub Y Y w.2.1 (pre Y Y (idH Y) w.2.1) (symH (pre-id Y w.2.1)) (idH Y) (CU.full-id Y w fu).2) ;

  opaque qU ;

  bE (Y' Y : Ob) (k : Hom Y' Y) : Id (Hom Y' Y) (compH Y' Y Y (idH Y) k) (compH Y' Y' Y k (idH Y')) =
    transH (comp-idl Y' Y k) (symH (comp-idr Y' Y k)) ;

  bmap : L.PSub[CU.resCtx, UU.UCtx] =
    new L.PSub[CU.resCtx, UU.UCtx, \ Y x -> x.1.2.2.1.1 Y (idH Y) (qU Y x.1 x.2),
      \ Y' Y k x -> symH (x.1.2.2.1.2.1 Y' Y k (idH Y) (qU Y x.1 x.2) (compH Y' Y' Y k (idH Y')) (bE Y' Y k)
                           (GGlueD.fl-pre Y' Y k x.1.2.1 Y' (idH Y') (qU Y' (CU.resCtx.act Y' Y k x).1 (CU.resCtx.act Y' Y k x).2)))] ;

  BU : L.PTy[CU.resCtx] = L.subTy CU.resCtx UU.UCtx UU.EGen bmap ;

  AU' : L.PTy[CU.resCtx] = L.subTy CU.resCtx GDr AU CU.inclR ;

  module TBU = LP.TyL[CU.resCtx, BU] ;
  module TAU = LP.TyL[CU.resCtx, AU'] ;

  -- transport along a loop of codes
  substLoop (Y : Ob) (F : UU.U0 Y) (p : Id (UU.U0 Y) F F) (z : W0.Ix (UU.fib0 Y F))
    : Id (W0.Ix (UU.fib0 Y F)) (subst (UU.U0 Y) (\ G' -> W0.Ix (UU.fib0 Y G')) F F p z) z =
    apH (\ q -> subst (UU.U0 Y) (\ G' -> W0.Ix (UU.fib0 Y G')) F F q z) (V1.isSetIx (UU.codeU Y) F F p (refl F)) ;

  alE (Y : Ob) (v : TBU.EI Y) : TAU.EI Y = (v.1, v.1.1.2.2.1.2.2.1 Y (idH Y) (qU Y v.1.1 v.1.2) v.2) ;

  module AN (Y' Y : Ob) (k : Hom Y' Y) (v : TBU.EI Y) {
    x : V1.Ix (CU.resCtx.ob Y) = v.1 ;
    x' : V1.Ix (CU.resCtx.ob Y') = CU.resCtx.act Y' Y k v.1 ;
    q : IsT (GGlueD.fl Y v.1.1.2.1 Y (idH Y)) = qU Y v.1.1 v.1.2 ;
    q' : IsT (GGlueD.fl Y v.1.1.2.1 Y' (compH Y' Y' Y k (idH Y'))) =
      GGlueD.fl-pre Y' Y k v.1.1.2.1 Y' (idH Y') (qU Y' x'.1 x'.2) ;
    F : UU.U0 Y = v.1.1.2.2.1.1 Y (idH Y) q ;
    F' : UU.U0 Y' = v.1.1.2.2.1.1 Y' (compH Y' Y' Y k (idH Y')) q' ;
    pb : Id (UU.U0 Y') (UU.uAct Y' Y k F) F' = v.1.1.2.2.1.2.1 Y' Y k (idH Y) q (compH Y' Y' Y k (idH Y')) (bE Y' Y k) q' ;
    A : UU.U0 Y = v.1.1.1 ;
    a0 : W0.Ix (A.1.tob Y (idH Y)) = v.1.1.2.2.1.2.2.1 Y (idH Y) q v.2 ;

    res : Id (TAU.EI Y') (alE Y' (TBU.E.act Y' Y k v)) (TAU.E.act Y' Y k (alE Y v)) =
      apH {W0.Ix (A.1.tob Y' (compH Y' Y' Y k (idH Y')))} {TAU.EI Y'} (\ z -> (x', z))
        (calc (W0.Ix (A.1.tob Y' (compH Y' Y' Y k (idH Y')))) {
            v.1.1.2.2.1.2.2.1 Y' (compH Y' Y' Y k (idH Y')) q' (BU.tact Y' Y k x x' (refl x') v.2)
          =< apH (v.1.1.2.2.1.2.2.1 Y' (compH Y' Y' Y k (idH Y')) q')
               (GSmall.tact-irr UU.UCtx UU.El Y' Y k F F' (L.ntEq CU.resCtx UU.UCtx bmap Y' Y k x x' (refl x')) pb v.2) >
            v.1.1.2.2.1.2.2.1 Y' (compH Y' Y' Y k (idH Y')) q' (UU.tactG Y' Y k F F' pb v.2)
          =< v.1.1.2.2.1.2.2.2 Y' Y k (idH Y) q (compH Y' Y' Y k (idH Y')) (bE Y' Y k) q' v.2 >
            A.1.tact Y' Y k (idH Y) (compH Y' Y' Y k (idH Y')) (bE Y' Y k) a0
          =< tact-irr (yP Y) A.1 Y' Y k (idH Y) (compH Y' Y' Y k (idH Y')) (bE Y' Y k) (UU.idf-eq Y' Y k) a0 >
            A.1.tact Y' Y k (idH Y) (compH Y' Y' Y k (idH Y')) (UU.idf-eq Y' Y k) a0
          =< symH (substLoop Y' (UU.uAct Y' Y k A) (L.ntEq GDr UU.UCtx pA Y' Y k x.1 x'.1 (L.ntEq CU.resCtx GDr CU.inclR Y' Y k x x' (refl x')))
                    (A.1.tact Y' Y k (idH Y) (compH Y' Y' Y k (idH Y')) (UU.idf-eq Y' Y k) a0)) >
            AU'.tact Y' Y k x x' (refl x') a0 }) ;
  } ;

  alU : GLine[a+].PMap[CU.resCtx, BU, AU'] = new GLine[a+].PMap[CU.resCtx, BU, AU', alE, \ Y v -> refl v.1, \ Y' Y k v -> AN[Y', Y, k, v].res] ;

  ExtBig : L.PTy[GDr] = GExt2[a+].ExtB2[GDr, AU, psiU, BU, alU].ExtT ;
} ;
