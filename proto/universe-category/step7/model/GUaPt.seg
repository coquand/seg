-- GUaPt.seg (inside IvBase, any base; Step 3 probe, M1): the glue data of
-- a univalence problem.  For F : U0 X and a side s of UaTy over F (one
-- sieve with a section; a list is presented by its union, GCofOne), a point
-- d_s of GD1 at stage X:
--
--   A , ph       F , s's sieve
--   kapR         on the restricted representable RC of the sieve, s's value
--   G2R          the glued (B , A , al , eqOn) over RC (GUaGlue2)
--   Po , H1A     the glued A is F restricted to RC, fibrewise (ElCong by
--                ppt, then Yoneda)
--   bd           B the side codes; al the side maps moved along Po
--   TP           the glued triple is the triple of d_p (GGlueE.Tr)
--   dP           (F , ph , bd , eqOn moved along TP); glueES

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
open GLine[a] ;
module GE1 = GFibE[a+] ;
module GX = GEqExt[a] ;
module GL = GEqLaws[a] ;

module Pt (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (cE : GE1.FE[GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Comp)
  (eE : GE1.FE[GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].ESIC cE)
  (X : Ob) (F : GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 X)
  (sd : GCofib[a+].Partials[GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx,
                           GUnivEq.UaU[Cl, clSub, clSub-id, clSub-o, encCl].UaTy].PSide[X, F]) {
  module UA = GUnivEq.UaU[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UU = UA.UU ;
  module EC = GElC.ElC[Cl, clSub, clSub-id, clSub-o, encCl, cE, eE] ;
  module GEm = GGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module DD = GEm.DD ;

  ph : Phi X = sd.pQ ;

  module R = GGlueE.RCm[X, ph] ;
  RC : PCtx = R.RC ;

  ----------------------------------------------------------------------
  -- the side's values on RC

  -- the map of x lands in the side's sieve
  lx (W : Ob) (x : W0.Ix (R.ob W)) : Lands W X ph x.1 = GUnivL.chiLands W X ph x.1 x.2 ;

  kapR (W : Ob) (x : W0.Ix (R.ob W)) : UA.Q4 W = sd.pv W x.1 (lx W x) ;

  kapnatR (Y' Y : Ob) (h : Hom Y' Y) (x : W0.Ix (R.ob Y)) : Id (UA.Q4 Y') (kapR Y' (R.act Y' Y h x)) (UA.q4Act Y' Y (yH Y' Y h) (kapR Y x)) =
    symH (sd.pnat Y' Y h x.1 (lx Y x) (lx Y' (R.act Y' Y h x))) ;

  cFeq (W : Ob) (x : W0.Ix (R.ob W)) : Id (UU.U0 W) (kapR W x).1 (UU.uAct W X x.1 F) = sd.ppt W x.1 (lx W x) ;

  opaque kapnatR ;

  module G2R = GUaGlue2.Glue2[Cl, clSub, clSub-id, clSub-o, encCl, cE, eE, RC, kapR, kapnatR] ;
  module G = G2R.G ;

  ----------------------------------------------------------------------
  -- the glued A is F restricted to RC, fibrewise

  cYnat (Y' Y : Ob) (h : Hom Y' Y) (g : Hom Y X) : Id (UU.U0 Y') (UU.uAct Y' X (compH Y' Y X g h) F) (UU.uAct Y' Y h (UU.uAct Y X g F)) =
    UU.uAct-o Y' Y X g h F ;

  module YN = EC.Yon[X, F, cYnat] ;

  cR (Y : Ob) (x : W0.Ix (R.ob Y)) : UU.U0 Y = YN.cY Y (R.inclRC.nt Y x) ;
  cRnat (Y' Y : Ob) (h : Hom Y' Y) (x : W0.Ix (R.ob Y)) : Id (UU.U0 Y') (cR Y' (R.act Y' Y h x)) (UU.uAct Y' Y h (cR Y x)) =
    transH (apH (YN.cY Y') (R.inclRC.nt-nat Y' Y h x)) (cYnat Y' Y h (R.inclRC.nt Y x)) ;

  module CC = EC.ElCong[RC, G.cF, cR, G.cnatF, cRnat, cFeq] ;

  At : PTy[RC] = subTy RC (yP X) F.1 R.inclRC ;

  Po (W : Ob) (x : W0.Ix (R.ob W)) : Id W0.V (G.A.tob W x) (At.tob W x) = transH (CC.Po W x) (YN.Po W x.1) ;

  substTr (u v w : W0.V) (P1 : Id W0.V u v) (P2 : Id W0.V v w) (z : W0.Ix u)
    : Id (W0.Ix w) (subst W0.V (\ t -> W0.Ix t) u w (transH P1 P2) z) (subst W0.V (\ t -> W0.Ix t) v w P2 (subst W0.V (\ t -> W0.Ix t) u v P1 z)) =
    idJ W0.V v (\ w2 P3 -> Id (W0.Ix w2) (subst W0.V (\ t -> W0.Ix t) u w2 (transH P1 P3) z) (subst W0.V (\ t -> W0.Ix t) v w2 P3 (subst W0.V (\ t -> W0.Ix t) u v P1 z)))
      (refl (subst W0.V (\ t -> W0.Ix t) u v P1 z)) w P2 ;

  H1A (J I : Ob) (f : Hom J I) (x : W0.Ix (R.ob I)) (y : W0.Ix (R.ob J)) (e : Id (W0.Ix (R.ob J)) (R.act J I f x) y)
    (a0 : W0.Ix (G.A.tob I x))
    : Id (W0.Ix (At.tob J y)) (subst W0.V (\ t -> W0.Ix t) (G.A.tob J y) (At.tob J y) (Po J y) (G.A.tact J I f x y e a0))
                             (At.tact J I f x y e (subst W0.V (\ t -> W0.Ix t) (G.A.tob I x) (At.tob I x) (Po I x) a0)) =
    calc (W0.Ix (At.tob J y)) {
        subst W0.V (\ t -> W0.Ix t) (G.A.tob J y) (At.tob J y) (Po J y) (G.A.tact J I f x y e a0)
      =< substTr (G.A.tob J y) (UU.fib0 J (cR J y)) (At.tob J y) (CC.Po J y) (YN.Po J y.1) (G.A.tact J I f x y e a0) >
        subst W0.V (\ t -> W0.Ix t) (UU.fib0 J (cR J y)) (At.tob J y) (YN.Po J y.1)
          (subst W0.V (\ t -> W0.Ix t) (G.A.tob J y) (UU.fib0 J (cR J y)) (CC.Po J y) (G.A.tact J I f x y e a0))
      =< apH (subst W0.V (\ t -> W0.Ix t) (UU.fib0 J (cR J y)) (At.tob J y) (YN.Po J y.1))
           (transH (CC.H1 J I f x y e a0)
              (EC.tactG-irr J I f (cR I x) (cR J y) (EC.Fam[RC, cR, cRnat].ep J I f x y e) (EC.Fam[yP X, YN.cY, cYnat].ep J I f x.1 y.1 eY) a1)) >
        subst W0.V (\ t -> W0.Ix t) (UU.fib0 J (cR J y)) (At.tob J y) (YN.Po J y.1) (EC.Fam[yP X, YN.cY, cYnat].ElTy.tact J I f x.1 y.1 eY a1)
      =< YN.H1 J I f x.1 y.1 eY a1 >
        F.1.tact J I f x.1 y.1 eY (subst W0.V (\ t -> W0.Ix t) (UU.fib0 I (cR I x)) (At.tob I x) (YN.Po I x.1) a1)
      =< apH (F.1.tact J I f x.1 y.1 eY) (symH (substTr (G.A.tob I x) (UU.fib0 I (cR I x)) (At.tob I x) (CC.Po I x) (YN.Po I x.1) a0)) >
        At.tact J I f x y e (subst W0.V (\ t -> W0.Ix t) (G.A.tob I x) (At.tob I x) (Po I x) a0) }
    where {
      eY : Id (Hom J X) (compH J I X x.1 f) y.1 = ntEq RC (yP X) R.inclRC J I f x y e ;
      a1 : W0.Ix (UU.fib0 I (cR I x)) = subst W0.V (\ t -> W0.Ix t) (G.A.tob I x) (UU.fib0 I (cR I x)) (CC.Po I x) a0 ; } ;

  opaque substTr ; opaque H1A ;

  ----------------------------------------------------------------------
  -- the glue data

  module TB = GPR.TyL[RC, G.B] ;
  module TGA = GPR.TyL[RC, G.A] ;
  module TA = GPR.TyL[RC, At] ;

  B (W : Ob) (f : Hom W X) (q : IsT (GGlueD.fl X ph W f)) : UU.U0 W = G.cB W (f, q) ;

  bn : DD.BNat X ph B = \ W' W chi f q f2 E q2 -> G.FB.ep W' W chi (f, q) (f2, q2) (R.pt-eq W' (R.act W' W chi (f, q)) (f2, q2) E) ;

  -- the side maps, moved into F
  al (W : Ob) (f : Hom W X) (q : IsT (GGlueD.fl X ph W f)) (b : W0.Ix (UU.fib0 W (B W f q))) : W0.Ix (F.1.tob W f) =
    subst W0.V (\ t -> W0.Ix t) (G.A.tob W (f, q)) (At.tob W (f, q)) (Po W (f, q)) (G.aOfq W (kapR W (f, q)) b) ;

  -- the glued map is natural, fibrewise
  gN (W' W : Ob) (chi : Hom W' W) (x : W0.Ix (R.ob W)) (y : W0.Ix (R.ob W')) (eR : Id (W0.Ix (R.ob W')) (R.act W' W chi x) y)
    (b : W0.Ix (G.B.tob W x))
    : Id (W0.Ix (G.A.tob W' y)) (G.aOfq W' (kapR W' y) (G.B.tact W' W chi x y eR b)) (G.A.tact W' W chi x y eR (G.aOfq W (kapR W x) b)) =
    TGA.pr-inj W' y _ _
      (calc (TGA.EI W') {
          (y, G.aOfq W' (kapR W' y) (G.B.tact W' W chi x y eR b))
        =< apH (G.al.mE W') (symH (TB.pr-tact W' W chi x y eR b)) >
          G.al.mE W' (TB.E.act W' W chi (x, b))
        =< G.al.mnat W' W chi (x, b) >
          TGA.E.act W' W chi (x, G.aOfq W (kapR W x) b)
        =< TGA.pr-tact W' W chi x y eR (G.aOfq W (kapR W x) b) >
          (y, G.A.tact W' W chi x y eR (G.aOfq W (kapR W x) b)) }) ;

  alnP (W' W : Ob) (chi : Hom W' W) (f : Hom W X) (q : IsT (GGlueD.fl X ph W f)) (f2 : Hom W' X)
    (E : Id (Hom W' X) (compH W' W X f chi) f2) (q2 : IsT (GGlueD.fl X ph W' f2)) (b : W0.Ix (UU.fib0 W (B W f q)))
    : Id (W0.Ix (F.1.tob W' f2)) (al W' f2 q2 (UU.tactG W' W chi (B W f q) (B W' f2 q2) (bn W' W chi f q f2 E q2) b))
                                 (F.1.tact W' W chi f f2 E (al W f q b)) =
    transH (apH (subst W0.V (\ t -> W0.Ix t) (G.A.tob W' (f2, q2)) (At.tob W' (f2, q2)) (Po W' (f2, q2))) (gN W' W chi (f, q) (f2, q2) eR b))
      (transH (H1A W' W chi (f, q) (f2, q2) eR (G.aOfq W (kapR W (f, q)) b))
              (tact-irr (yP X) F.1 W' W chi f f2 (ntEq RC (yP X) R.inclRC W' W chi (f, q) (f2, q2) eR) E (al W f q b)))
    where { eR : Id (W0.Ix (R.ob W')) (R.act W' W chi (f, q)) (f2, q2) = R.pt-eq W' (R.act W' W chi (f, q)) (f2, q2) E ; } ;

  aln : DD.AlNat X F ph B bn al = alnP ;

  opaque gN ; opaque alnP ;

  bd : DD.BD X F ph = (B, (bn, (al, aln))) ;

  ----------------------------------------------------------------------
  -- the triple of d_p is the glued triple

  module T0 = GEm.Tr[X, F, ph, bd] ;

  Gtri : GX.EqDat[RC].Tri = (G.B, (G.A, G.al)) ;

  TP : Id (GX.EqDat[RC].Tri) Gtri T0.tri =
    GL.TriL[RC].triExtPw G.B G.A G.al T0.Bt T0.At T0.al
      (\ Y x -> refl (T0.Bt.tob Y x))
      (\ Y' Y k x y e b -> EC.tactG-irr Y' Y k (G.cB Y x) (G.cB Y' y) (G.FB.ep Y' Y k x y e)
         (bn Y' Y k x.1 x.2 y.1 (apH (\ z -> z.1) e) y.2) b)
      Po H1A
      (\ Y w -> apH {W0.Ix (G.A.tob Y w.1)} {TA.EI Y} (\ z -> (w.1, subst W0.V (\ t -> W0.Ix t) (G.A.tob Y w.1) (At.tob Y w.1) (Po Y w.1) z))
         (symH (TGA.pr-inj Y w.1 _ _ (TGA.fromE-eq Y w.1 (G.al.mE Y w) (refl w.1))))) ;

  opaque TP ;

  eqOnP : GX.EqDat[RC].EqOn T0.tri = subst (GX.EqDat[RC].Tri) (GX.EqDat[RC].EqOn) Gtri T0.tri TP G2R.eqOn ;

  -- d_p's triple and structure are the glued ones
  glueES : Id (GEm.ES RC) (T0.tri, eqOnP) (Gtri, G2R.eqOn) = GEm.pairTr RC Gtri T0.tri TP G2R.eqOn ;

  -- the point of the problem
  dP : GEm.GD1 X = (F, (ph, (bd, eqOnP))) ;
} ;
