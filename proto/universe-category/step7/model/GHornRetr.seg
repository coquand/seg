-- GHornRetr.seg (inside IvBase, any base): composition gives extension
-- along a RETRACTION LINE (Gabriel-Zisman; the line form of BoxHorn.BH).
--
-- Data at X: a partial element hs of A at rho (sides on sieves H_l; the
-- horn: on Delta one side on the horn sieve, on posets one side per face);
-- a natural family r (W , f , i) : W -> X over the generalised points
-- (f , i) : W -> X * I (the retraction X * I -> X, curried: no product in
-- the base), with
--   R1  r (f , e') = f                       (r is a retraction at e')
--   R2  r (f , e) lands in H_l0              (the start lies in one side)
--   R3  f in H_l  =>  r (f , i) in H_l       (r maps H_l * I into H_l)
-- The problem: the line rho r in G, the start hs at r (id , e), for each l
-- a side on H_l whose line at f is hs_l read along r (f - , -).  Its
-- composite at e' lies over rho r (id , e') = rho and extends hs (cside at
-- (f , e'), R1).
--
--   RF.fill       the extension, an element of A over rho
--   RF.fill-side  it restricts to hs on H
--
-- Instances: Delta horns (DeltaRetr: the retractions of BoxHorn, for k = 0
-- and k > 0); posets (BoxHorn, one side per face QH m k y).

level lv ;
constraint a <= lv ;
open Base ;
open Prelude[lv+] ;
open Paths[lv+] ;
module W0 = V[lv] ;
open Arith[a] ;
module GPR = GPre[lv] ;
open GPR.PS ;
open GLine[lv] ;
module FM = GFam[lv] ;

module RF (G : PCtx) (A : PTy[G]) (e e' : IPt)
  (ca : CompAtP[FM.famPath, G, A, e, e'].CompAt)
  (X : Ob) (rho : W0.Ix (G.ob X))
  (hs : GCofib[lv].Partials[G, A].Partial[X, rho]) (l0 : Fin hs.pr)
  (r : (W : Ob) -> Hom W X -> Hom W Iv -> Hom W X)
  (rn : (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
        -> Id (Hom V X) (compH V W X (r W f i) g) (r V (compH V W X f g) (compH V W Iv i g)))
  (R1 : (W : Ob) (f : Hom W X) -> Id (Hom W X) (r W f (ptH W e')) f)
  (R2 : (W : Ob) (f : Hom W X) -> Lands W X (hs.ps l0).pQ (r W f (ptH W e)))
  (R3 : (l : Fin hs.pr) (W : Ob) (f : Hom W X) (i : Hom W Iv) -> Lands W X (hs.ps l).pQ f -> Lands W X (hs.ps l).pQ (r W f i)) {
  module CA = CompAtP[FM.famPath, G, A, e, e'] ;
  module KA = EndKit[FM.famPath, G, A, e] ;
  module KB = EndKit[FM.famPath, G, A, e'] ;
  module LA = LevKit[FM.famPath, FM.famConn, G, A, e] ;
  module LB = LevKit[FM.famPath, FM.famConn, G, A, e'] ;
  module TA = GPR.TyL[G, A] ;
  module GL = GPR.PshL[G] ;
  module HP = GCofib[lv].Partials[G, A] ;

  ----------------------------------------------------------------------
  -- the line rho r in G and the start hs (r (id , e))

  gt (W : Ob) (f : Hom W X) (i : Hom W Iv) : W0.Ix (G.ob W) = G.act W X (r W f i) rho ;

  gn : FM.famConn.FamNat G X gt = \ V W g f i ->
    transH (GL.actC V W X (r W f i) g rho) (apH (\ k -> G.act V X k rho) (rn V W g f i)) ;

  gam : W0.Ix ((FM.famPath.pth G).ob X) = FM.famConn.lam G X gt gn ;

  r0 : Hom X X = r X (idH X) (ptH X e) ;

  sE : TA.EI X = (hs.ps l0).pv X r0 (R2 X (idH X)) ;

  x0 : KA.TV.EI X = (gam, TA.fromE X (G.act X X r0 rho) sE ((hs.ps l0).ppt X r0 (R2 X (idH X)))) ;

  x0-E : Id (TA.EI X) (KA.endE X x0) sE = TA.fromE-eq X (G.act X X r0 rho) sE ((hs.ps l0).ppt X r0 (R2 X (idH X))) ;

  opaque x0-E ;

  ----------------------------------------------------------------------
  -- the side l: at f, the line hs_l (r (f - , -))

  module SideL (l : Fin hs.pr) {
    iS (V : Ob) (f : Hom V X) (i : Lands V X (hs.ps l).pQ f) (W : Ob) (g : Hom W V) (j : Hom W Iv)
      : Lands W X (hs.ps l).pQ (r W (compH W V X f g) j) =
      R3 l W (compH W V X f g) j (lands-comp W V X (hs.ps l).pQ f g i) ;

    t (V : Ob) (f : Hom V X) (i : Lands V X (hs.ps l).pQ f) : FM.famConn.FamA G A V = \ W g j ->
      (hs.ps l).pv W (r W (compH W V X f g) j) (iS V f i W g j) ;

    tp (V : Ob) (f : Hom V X) (i : Lands V X (hs.ps l).pQ f)
      : FM.famConn.FamAPt G A V ((FM.famPath.pth G).act V X f gam) (t V f i) = \ W g j ->
      (hs.ps l).ppt W (r W (compH W V X f g) j) (iS V f i W g j) ;

    -- (f g) g' = f (g g'), read along r
    tnHom (V : Ob) (f : Hom V X) (W' W : Ob) (g' : Hom W' W) (g : Hom W V) (j : Hom W Iv)
      : Id (Hom W' X) (compH W' W X (r W (compH W V X f g) j) g') (r W' (compH W' V X f (compH W' W V g g')) (compH W' W Iv j g')) =
      transH (rn W' W g' (compH W V X f g) j) (apH (\ k -> r W' k (compH W' W Iv j g')) (comp-assoc W' W V X f g g')) ;

    tn (V : Ob) (f : Hom V X) (i : Lands V X (hs.ps l).pQ f) : FM.famConn.FamANat G A V (t V f i) = \ W' W g' g j ->
      transH ((hs.ps l).pnat W' W g' (r W (compH W V X f g) j) (iS V f i W g j)
                (lands-comp W' W X (hs.ps l).pQ (r W (compH W V X f g) j) g' (iS V f i W g j)))
             (HP.pv-hom X rho (hs.ps l) W' (compH W' W X (r W (compH W V X f g) j) g') (r W' (compH W' V X f (compH W' W V g g')) (compH W' W Iv j g'))
                (tnHom V f W' W g' g j)
                (lands-comp W' W X (hs.ps l).pQ (r W (compH W V X f g) j) g' (iS V f i W g j))
                (iS V f i W' (compH W' W V g g') (compH W' W Iv j g'))) ;

    -- the line at (id , e) is the start, restricted along f
    t1Hom (V : Ob) (f : Hom V X)
      : Id (Hom V X) (r V (compH V V X f (idH V)) (ptH V e)) (compH V X X r0 f) =
      transH (apH (\ k -> r V k (ptH V e)) (transH (comp-idr V X f) (symH (comp-idl V X f))))
        (transH (apH (\ k -> r V (compH V X X (idH X) f) k) (symH (ptH-nat V X f e)))
                (symH (rn V X f (idH X) (ptH X e)))) ;

    -- at (id , e) the side l agrees with the start (side l0, by pcs)
    t1 (V : Ob) (f : Hom V X) (i : Lands V X (hs.ps l).pQ f)
      : Id (TA.EI V) (t V f i V (idH V) (ptH V e)) (KA.endE V (KA.TV.E.act V X f x0)) =
      transH (hs.pcs l l0 V (r V (compH V V X f (idH V)) (ptH V e)) (iS V f i V (idH V) (ptH V e)) (R2 V (compH V V X f (idH V))))
        (transH (HP.pv-hom X rho (hs.ps l0) V (r V (compH V V X f (idH V)) (ptH V e)) (compH V X X r0 f) (t1Hom V f)
                   (R2 V (compH V V X f (idH V))) (lands-comp V X X (hs.ps l0).pQ r0 f (R2 X (idH X))))
          (symH (transH (KA.endE-act V X f x0)
                  (transH (apH (TA.E.act V X f) x0-E)
                          ((hs.ps l0).pnat V X f r0 (R2 X (idH X)) (lands-comp V X X (hs.ps l0).pQ r0 f (R2 X (idH X)))))))) ;

    tr (V' V : Ob) (chi : Hom V' V) (f : Hom V X) (i : Lands V X (hs.ps l).pQ f) (i' : Lands V' X (hs.ps l).pQ (compH V' V X f chi))
      (W : Ob) (g : Hom W V') (j : Hom W Iv)
      : Id (TA.EI W) (t V' (compH V' V X f chi) i' W g j) (t V f i W (compH W V' V chi g) j) =
      HP.pv-hom X rho (hs.ps l) W (r W (compH W V' X (compH V' V X f chi) g) j) (r W (compH W V X f (compH W V' V chi g)) j)
        (apH (\ k -> r W k j) (comp-assoc W V' V X f chi g))
        (iS V' (compH V' V X f chi) i' W g j) (iS V f i W (compH W V' V chi g) j) ;

    module LS = GMapLine[lv].LineSide[FM.famPath, FM.famConn, G, A, e, X, x0, (hs.ps l).pQ, t, tp, tn, t1, tr] ;
  } ;

  -- two sides agree where both are defined: their lines are hs_l, hs_j
  -- along r, which agree by the compatibility of hs
  pcs : KA.PT.PCsTy X x0 hs.pr (\ l -> SideL[l].LS.side) = \ l j V f i i' ->
    LA.ts-ext V (SideL[l].LS.sv V f i) (SideL[j].LS.sv V f i')
      (transH (SideL[l].LS.sv-pt V f i) (symH (SideL[j].LS.sv-pt V f i')))
      (\ W g k -> transH (SideL[l].LS.sv-lev V f i W g k)
         (transH (hs.pcs l j W (r W (compH W V X f g) k) (SideL[l].iS V f i W g k) (SideL[j].iS V f i' W g k))
                 (symH (SideL[j].LS.sv-lev V f i' W g k)))) ;

  part : KA.PT.Partial[X, x0] = new KA.PT.Partial[X, x0, hs.pr, \ l -> SideL[l].LS.side, pcs] ;

  ----------------------------------------------------------------------
  -- the composite at e' is the extension

  c : CA.TV'.T X gam = ca.cop X x0 part ;

  rhoEq : Id (W0.Ix (G.ob X)) (G.act X X (r X (idH X) (ptH X e')) rho) rho = GL.actId X (r X (idH X) (ptH X e')) (R1 X (idH X)) rho ;

  fill : TA.T X rho = TA.fromE X rho (KB.endE X (gam, c)) rhoEq ;

  fill-E : Id (TA.EI X) (rho, fill) (KB.endE X (gam, c)) = TA.fromE-eq X rho (KB.endE X (gam, c)) rhoEq ;

  fill-side (l : Fin hs.pr) (W : Ob) (f : Hom W X) (i : Lands W X (hs.ps l).pQ f)
    : Id (TA.EI W) (TA.E.act W X f (rho, fill)) ((hs.ps l).pv W f i) =
    calc (TA.EI W) {
        TA.E.act W X f (rho, fill)
      =< apH (TA.E.act W X f) fill-E >
        TA.E.act W X f (KB.endE X (gam, c))
      =< symH (KB.endE-act W X f (gam, c)) >
        KB.endE W (KB.TV.E.act W X f (gam, c))
      =< apH (KB.endE W) (ca.cside X x0 part l W f i) >
        KB.endE W (CA.endL W (SideL[l].LS.sv W f i))
      =< LB.endL-lev W (KA.lineL W (SideL[l].LS.sv W f i)) >
        FM.famConn.levA G A W (KA.lineL W (SideL[l].LS.sv W f i)) W (idH W) (ptH W e')
      =< SideL[l].LS.sv-lev W f i W (idH W) (ptH W e') >
        SideL[l].t W f i W (idH W) (ptH W e')
      =< HP.pv-hom X rho (hs.ps l) W (r W (compH W W X f (idH W)) (ptH W e')) f
           (transH (apH (\ k -> r W k (ptH W e')) (comp-idr W X f)) (R1 W f))
           (SideL[l].iS W f i W (idH W) (ptH W e')) i >
        (hs.ps l).pv W f i } ;

  opaque fill ;
} ;
