-- DNormD.seg: the normalised fillers at every stage.
--
--   degP      (B) K' (s_j^* c) = s_j^* (K c): the first degeneracy i of
--             s_j^* c is j, or i < j and then c is degenerate along i
--             (DNormA.degTwo), and s_j' s_i = s_i s_j (DSimpId.ss)
--   states    the stages: K at [N] with its sides, codimension-2 agreement,
--             and (A) / (B) relating it to the stage below
--
-- Constructive.

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open DLvl[a, lz] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open Constr[a] ;
open Simp[a] ;
module DBm = DeltaBase[a] ;
module DB = DBm.DB ;
open DSimpId[a] ;
module DGm = DGlue[a, lz] ;
module DPS = DPrS[a] ;
open DCapBase[a] ;

module ND (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (e : El Iv) (eN : Nat) (eE : Id Tree e.1 (leaf eN))
  (tot : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> DB.GPre[lz].TyL[G, A].EI W)
  (tot-pt : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob W)) (tot N gt gn L0 W f j).1 (gt W f j))
  (tot-nat : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
         -> Id (DB.GPre[lz].TyL[G, A].EI V) (DB.GPre[lz].TyL[G, A].E.act V W g (tot N gt gn L0 W f j))
                                          (tot N gt gn L0 V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
  (tot-S0 : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (t : IsT ((S0 N eN).1 W f j))
         -> Id (DB.GPre[lz].TyL[G, A].EI W) (tot N gt gn L0 W f j) (L0.v W f j t))
  (deg : (N : Nat) (b : DStageA[a, lz].SA[G, A, e].Prob (suc N)) -> DNormA[a, lz].NA[G, A, e].DegFound N b) {
  module NCm = DNormC[a, lz].NC[G, A, e, eN, eE, tot, tot-pt, tot-nat, tot-S0, deg] ;
  open NCm ;
  open NBm ;
  open SAm ;
  open NAm ;

  -- after the value: s_i^* K (d_i^* (s_j^* c)) = s_j^* (K c)
  PD (N : Nat) (K : FillTy N) (c : Prob N) (j i : Nat) : U lz =
    Id (KA.TS.EI (suc N)) (KA.TS.E.act (suc N) N (dgH N i) (fillE N K (resP N (suc N) (dl N i) (resP (suc N) N (dgH N j) c))))
                          (KA.TS.E.act (suc N) N (dgH N j) (fillE N K c)) ;

  -- the composition, on abstract problems: c1 = s_j'^* e and c = s_i^* e
  -- two elements that are restrictions of one element along the two sides
  -- of a commuting square have equal restrictions along the other two sides
  sqE (Z Y X : Nat) (u v : Hom (lin Z) (lin Y)) (p q : Hom (lin Y) (lin X)) (x1 x2 : KA.TS.EI Y) (x : KA.TS.EI X)
    (e1 : Id (KA.TS.EI Y) x1 (KA.TS.E.act Y X p x)) (e2 : Id (KA.TS.EI Y) x2 (KA.TS.E.act Y X q x))
    (cm : Id (Hom (lin Z) (lin X)) (compH (lin Z) (lin Y) (lin X) p u) (compH (lin Z) (lin Y) (lin X) q v))
    : Id (KA.TS.EI Z) (KA.TS.E.act Z Y u x1) (KA.TS.E.act Z Y v x2) =
    transH (apH (KA.TS.E.act Z Y u) e1)
      (transH (KA.TS.PE.actC Z Y X p u x)
        (transH (apH (\ k -> KA.TS.E.act Z X k x) cm)
          (transH (symH (KA.TS.PE.actC Z Y X q v x)) (symH (apH (KA.TS.E.act Z Y v) e2))))) ;

  opaque sqE ;

  coreG (N' j' i : Nat) (K : FillTy (suc N')) (low : LowRel (suc N') K) (jN : IsT (leb j' N')) (ij : IsT (leb i j'))
    (c c1 : Prob (suc N')) (ee : Prob N')
    (E1 : Id (Prob (suc N')) c1 (resP (suc N') N' (dgH N' j') ee)) (E2 : Id (Prob (suc N')) c (resP (suc N') N' (dgH N' i) ee))
    : Id (KA.TS.EI (suc (suc N'))) (KA.TS.E.act (suc (suc N')) (suc N') (dgH (suc N') i) (fillE (suc N') K c1))
                                   (KA.TS.E.act (suc (suc N')) (suc N') (dgH (suc N') (suc j')) (fillE (suc N') K c)) =
    sqE (suc (suc N')) (suc N') N' (dgH (suc N') i) (dgH (suc N') (suc j')) (dgH N' j') (dgH N' i)
      (fillE (suc N') K c1) (fillE (suc N') K c) (fillE N' low.1 ee)
      (transH (fill-cong (suc N') K c1 (resP (suc N') N' (dgH N' j') ee) E1) (low.2.2 ee j' jN))
      (transH (fill-cong (suc N') K c (resP (suc N') N' (dgH N' i) ee) E2) (low.2.2 ee i (leb-trans i j' N' ij jN)))
      (ss N' i j' ij jN) ;

  opaque coreG ;

  core (N' j' : Nat) (K : FillTy (suc N')) (low : LowRel (suc N') K) (c : Prob (suc N')) (i : Nat) (jN : IsT (leb j' N'))
    (E : DegId (suc N') (resP (suc (suc N')) (suc N') (dgH (suc N') (suc j')) c) i) (ij : IsT (leb i j'))
    : PD (suc N') K c (suc j') i =
    coreG N' j' i K low jN ij c (resP (suc N') (suc (suc N')) (dl (suc N') i) (resP (suc (suc N')) (suc N') (dgH (suc N') (suc j')) c))
      (resP N' (suc N') (dl N' i) c) (one1 N' i j' ij jN c) (degTwo N' i j' ij jN c E) ;

  degLt : (N : Nat) (K : FillTy N) (low : LowRel N K) (c : Prob N) (j : Nat) (hj : IsT (leb j N)) (i : Nat)
    (E : DegId N (resP (suc N) N (dgH N j) c) i) (lt : IsT (ltb i j)) -> PD N K c j i = split {
    zero -> \ K low c j hj i E lt -> absurd _ (false-true (leb-trans (suc i) j zero lt hj)) ;
    suc N' -> \ K low c -> split {
      zero -> \ hj i E lt -> absurd _ (false-true lt) ;
      suc j' -> \ hj i E lt -> core N' j' K low c i hj E lt } } ;

  module Step2 (N : Nat) (K : FillTy N) (sidesK : SDm.Sides N K) (cmp2K : SBm.Cmp2 N K) (low : LowRel N K) {
    module S = Step[N, K, sidesK, cmp2K, low] ;

    degI (c : Prob N) (j : Nat) (hj : IsT (leb j N)) (i : Nat) (hi : IsT (leb i N)) (E : DegId N (resP (suc N) N (dgH N j) c) i)
      (mn : (i' : Nat) -> IsT (ltb i' i) -> DegId N (resP (suc N) N (dgH N j) c) i' -> Empty)
      : Id (KA.TS.EI (suc N)) ((resP (suc N) N (dgH N j) c).1, S.dv (resP (suc N) N (dgH N j) c) i E) (KA.TS.E.act (suc N) N (dgH N j) (fillE N K c)) =
      transH (S.dv-E (resP (suc N) N (dgH N j) c) i E)
        (ltbDecL (PD N K c j i) j i
           (\ lt -> absurd _ (mn j lt (deg-of N j hj c)))
           (\ ge -> eqNDecL (PD N K c j i) i j
              (\ q -> substH (\ x -> PD N K c j x) (symH q)
                         (apH (KA.TS.E.act (suc N) N (dgH N j)) (fill-cong N K (resP N (suc N) (dl N j) (resP (suc N) N (dgH N j) c)) c (ds-id0 N j (leb-step j N hj) c))))
              (\ nq -> degLt N K low c j hj i E (leb-neq i j ge nq)))) ;

    degC (c : Prob N) (j : Nat) (hj : IsT (leb j N)) : (v : DegFound N (resP (suc N) N (dgH N j) c))
      -> Id (KA.TS.EI (suc N)) ((resP (suc N) N (dgH N j) c).1, S.KC (resP (suc N) N (dgH N j) c) v) (KA.TS.E.act (suc N) N (dgH N j) (fillE N K c)) = split {
      inlL w -> degI c j hj w.1 w.2.1 w.2.2.1 w.2.2.2 ;
      inrL n -> absurd _ (n j hj (deg-of N j hj c)) } ;

    degP : DegPr N S.K' K = \ c j hj -> degC c j hj (deg N (resP (suc N) N (dgH N j) c)) ;

    cmp2' : SBm.Cmp2 (suc N) S.K' = SFm.C2[N, S.K', K, S.fp'].cmp2 ;

    low' : LowRel (suc N) S.K' = (K, (S.fp', degP)) ;
  } ;

  ----------------------------------------------------------------------
  -- all the stages

  State (N : Nat) : U lz = (K : FillTy N) * (SDm.Sides N K * (SBm.Cmp2 N K * LowRel N K)) ;

  step (N : Nat) (s : State N) : State (suc N) =
    (Step2[N, s.1, s.2.1, s.2.2.1, s.2.2.2].S.K',
     (Step2[N, s.1, s.2.1, s.2.2.1, s.2.2.2].S.sides',
      (Step2[N, s.1, s.2.1, s.2.2.1, s.2.2.2].cmp2', Step2[N, s.1, s.2.1, s.2.2.1, s.2.2.2].low'))) ;

  states : (N : Nat) -> State N = split {
    zero -> (SDm.St0.F, (SDm.St0.sides, (SFm.cmp2-0, tt))) ;
    suc N -> step N (states N) } ;

  K (N : Nat) : FillTy N = (states N).1 ;
  sidesK (N : Nat) : SDm.Sides N (K N) = (states N).2.1 ;
  -- (A) and (B) between consecutive stages
  faceK (N : Nat) : SDm.FPr N (K (suc N)) (K N) = (states (suc N)).2.2.2.2.1 ;
  degK (N : Nat) : DegPr N (K (suc N)) (K N) = (states (suc N)).2.2.2.2.2 ;
} ;
