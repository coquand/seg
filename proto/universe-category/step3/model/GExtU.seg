-- GExtU.seg (inside IvBase, any base; Step 2 probe): Ext on the universal
-- glue data.  A point D of GD1Ctx at stage I gives Ext data over y I:
--   psiD   the cofibration of y I generated by D's list (mkCof)
--   BD     D's B over the extent (Bt of GGlueE along toRC)
--   alD    D's alpha as a map of types over the extent
-- PhiExt I D is Ext of these data (GExt2, unchanged); Ext_U is the small
-- type over GD1Ctx of this family of local types (GYonTy), its naturality
-- Ext along y h (GExtSub6.tyEq) after one identification of the data.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
open GLine[a] ;
open Axioms[a+].FunExtLemmas[fe @(a+)] ;
module GP = GCofib[a] ;

-- the cofibration of y I generated by a list of sieves of I
psiD (I : Ob) (r : Nat) (ph : Fin r -> Phi I) : GP.Cof[yP I] =
  GP.mkCof (yP I) r (\ X g l -> pre X I g (ph l)) (\ Y X k g l -> symH (pre-comp Y X I k g (ph l))) ;

-- its extent is the extent of the list
toFl (I : Ob) (r : Nat) (ph : Fin r -> Phi I) (Y : Ob) (g : Hom Y I) (p : IsT (GP.CofL[yP I, psiD I r ph].full Y g))
  : IsT (GGlueD.fl I r ph Y g) =
  anyF-complete r (\ l -> allS Y (pre Y I g (ph l))) (GP.CofL[yP I, psiD I r ph].full-id Y g p).1
    (allS-complete Y (pre Y I g (ph (GP.CofL[yP I, psiD I r ph].full-id Y g p).1)) (GP.CofL[yP I, psiD I r ph].full-id Y g p).2) ;

opaque toFl ;

toRC (I : Ob) (r : Nat) (ph : Fin r -> Phi I) : PSub[GP.CofL[yP I, psiD I r ph].resCtx, GGlueE.RCm[I, r, ph].RC] =
  new PSub[GP.CofL[yP I, psiD I r ph].resCtx, GGlueE.RCm[I, r, ph].RC, \ Y w -> (w.1, toFl I r ph Y w.1 w.2),
    \ Y' Y k w -> GGlueE.RCm[I, r, ph].pt-eq Y' _ _ (refl (compH Y' Y I w.1 k))] ;

-- restriction along h, read on the extents
fullS (J I : Ob) (h : Hom J I) (r : Nat) (ph : Fin r -> Phi I) (X : Ob) (d : Hom X J)
  : Id Bool (GP.CofL[yP J, psiD J r (GGlueD.phR J I h r ph)].full X d) (GP.CofL[yP I, psiD I r ph].full X (compH X J I h d)) =
  bool-ext (GP.CofL[yP J, psiD J r (GGlueD.phR J I h r ph)].full X d) (GP.CofL[yP I, psiD I r ph].full X (compH X J I h d))
    (\ p -> GP.CofL[yP I, psiD I r ph].full-of-id X (compH X J I h d)
       ((GP.CofL[yP J, psiD J r (GGlueD.phR J I h r ph)].full-id X d p).1,
        lands-sub X X (pre X J d (pre J I h (ph (GP.CofL[yP J, psiD J r (GGlueD.phR J I h r ph)].full-id X d p).1)))
          (pre X I (compH X J I h d) (ph (GP.CofL[yP J, psiD J r (GGlueD.phR J I h r ph)].full-id X d p).1))
          (pre-comp X J I d h (ph (GP.CofL[yP J, psiD J r (GGlueD.phR J I h r ph)].full-id X d p).1)) (idH X)
          (GP.CofL[yP J, psiD J r (GGlueD.phR J I h r ph)].full-id X d p).2))
    (\ p -> GP.CofL[yP J, psiD J r (GGlueD.phR J I h r ph)].full-of-id X d
       ((GP.CofL[yP I, psiD I r ph].full-id X (compH X J I h d) p).1,
        lands-sub X X (pre X I (compH X J I h d) (ph (GP.CofL[yP I, psiD I r ph].full-id X (compH X J I h d) p).1))
          (pre X J d (pre J I h (ph (GP.CofL[yP I, psiD I r ph].full-id X (compH X J I h d) p).1)))
          (symH (pre-comp X J I d h (ph (GP.CofL[yP I, psiD I r ph].full-id X (compH X J I h d) p).1))) (idH X)
          (GP.CofL[yP I, psiD I r ph].full-id X (compH X J I h d) p).2)) ;

opaque fullS ;

module XU (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A)) {
  module UU = GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module DD = GGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module EE = GGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module YY = GYonTy.YT[Cl, clSub, clSub-id, clSub-o, encCl] ;

  ----------------------------------------------------------------------
  -- the Ext data over y I of glue data at stage I

  module Dat (I : Ob) (A : UU.U0 I) (r : Nat) (ph : Fin r -> Phi I) (bd : DD.BD I A r ph) {
    module CL = GP.CofL[yP I, psiD I r ph] ;
    module T = EE.Tr[I, A, r, ph, bd] ;

    BD : PTy[CL.resCtx] = subTy CL.resCtx T.R.RC T.Bt (toRC I r ph) ;

    AD : PTy[CL.resCtx] = subTy CL.resCtx (yP I) A.1 CL.inclR ;

    module TBD = GPR.TyL[CL.resCtx, BD] ;
    module TAD = GPR.TyL[CL.resCtx, AD] ;

    alE (Y : Ob) (w : TBD.EI Y) : TAD.EI Y = (w.1, bd.2.2.1 Y w.1.1 (toFl I r ph Y w.1.1 w.1.2) w.2) ;

    alN (Y' Y : Ob) (k : Hom Y' Y) (w : TBD.EI Y) : Id (TAD.EI Y') (alE Y' (TBD.E.act Y' Y k w)) (TAD.E.act Y' Y k (alE Y w)) =
      apH {W0.Ix (A.1.tob Y' (compH Y' Y I w.1.1 k))} {TAD.EI Y'} (\ z -> (CL.resCtx.act Y' Y k w.1, z))
        (transH (bd.2.2.2 Y' Y k w.1.1 (toFl I r ph Y w.1.1 w.1.2) (compH Y' Y I w.1.1 k)
                   (apH (\ z -> z.1) (ntEq CL.resCtx T.R.RC (toRC I r ph) Y' Y k w.1 (CL.resCtx.act Y' Y k w.1) (refl (CL.resCtx.act Y' Y k w.1))))
                   (toFl I r ph Y' (compH Y' Y I w.1.1 k) (CL.resCtx.act Y' Y k w.1).2) w.2)
           (tact-irr (yP I) A.1 Y' Y k w.1.1 (compH Y' Y I w.1.1 k)
              (apH (\ z -> z.1) (ntEq CL.resCtx T.R.RC (toRC I r ph) Y' Y k w.1 (CL.resCtx.act Y' Y k w.1) (refl (CL.resCtx.act Y' Y k w.1))))
              (ntEq CL.resCtx (yP I) CL.inclR Y' Y k w.1 (CL.resCtx.act Y' Y k w.1) (refl (CL.resCtx.act Y' Y k w.1)))
              (bd.2.2.1 Y w.1.1 (toFl I r ph Y w.1.1 w.1.2) w.2))) ;

    alD : PMap[CL.resCtx, BD, AD] = new PMap[CL.resCtx, BD, AD, alE, \ Y w -> refl w.1, alN] ;

    ExtD : PTy[yP I] = GExt2[a].ExtB2[yP I, A.1, psiD I r ph, BD, alD].ExtT ;
  } ;

  PhiExt (I : Ob) (D : EE.GD1 I) : PTy[yP I] = Dat[I, D.1, D.2.1, D.2.2.1, D.2.2.2.1].ExtD ;

  ----------------------------------------------------------------------
  -- helpers: El's action along paths of codes; alpha at two proofs of fullness

  tactGcong (V W : Ob) (g : Hom V W) (F1 F1' : UU.U0 W) (P : Id (UU.U0 W) F1 F1') (F2 F2' : UU.U0 V) (Q : Id (UU.U0 V) F2 F2')
    (e : Id (UU.U0 V) (UU.uAct V W g F1) F2) (e' : Id (UU.U0 V) (UU.uAct V W g F1') F2') (z : W0.Ix (UU.fib0 W F1))
    : Id (W0.Ix (UU.fib0 V F2')) (subst (UU.U0 V) (\ G' -> W0.Ix (UU.fib0 V G')) F2 F2' Q (UU.tactG V W g F1 F2 e z))
                                (UU.tactG V W g F1' F2' e' (subst (UU.U0 W) (\ G' -> W0.Ix (UU.fib0 W G')) F1 F1' P z)) =
    idJ (UU.U0 W) F1
      (\ F3 P3 -> (e3 : Id (UU.U0 V) (UU.uAct V W g F3) F2')
         -> Id (W0.Ix (UU.fib0 V F2')) (subst (UU.U0 V) (\ G' -> W0.Ix (UU.fib0 V G')) F2 F2' Q (UU.tactG V W g F1 F2 e z))
                                      (UU.tactG V W g F3 F2' e3 (subst (UU.U0 W) (\ G' -> W0.Ix (UU.fib0 W G')) F1 F3 P3 z)))
      (\ e3 -> idJ (UU.U0 V) F2
         (\ F4 Q4 -> (e4 : Id (UU.U0 V) (UU.uAct V W g F1) F4)
            -> Id (W0.Ix (UU.fib0 V F4)) (subst (UU.U0 V) (\ G' -> W0.Ix (UU.fib0 V G')) F2 F4 Q4 (UU.tactG V W g F1 F2 e z))
                                        (UU.tactG V W g F1 F4 e4 z))
         (\ e4 -> GSmall.tact-irr UU.UCtx UU.El V W g F1 F2 e e4 z) F2' Q e3)
      F1' P e' ;

  alq (I : Ob) (A : UU.U0 I) (r : Nat) (ph : Fin r -> Phi I) (bd : DD.BD I A r ph) (W : Ob) (f : Hom W I)
    (q q' : IsT (GGlueD.fl I r ph W f)) (P : Id (IsT (GGlueD.fl I r ph W f)) q q') (b : W0.Ix (UU.fib0 W (bd.1 W f q')))
    : Id (W0.Ix (A.1.tob W f)) (bd.2.2.1 W f q' b)
         (bd.2.2.1 W f q (subst W0.V (\ z -> W0.Ix z) (UU.fib0 W (bd.1 W f q')) (UU.fib0 W (bd.1 W f q))
                            (symH (ap (UU.U0 W) W0.V (UU.fib0 W) (bd.1 W f q) (bd.1 W f q') (apH (bd.1 W f) P))) b)) =
    idJ (IsT (GGlueD.fl I r ph W f)) q
      (\ q2 P2 -> (b2 : W0.Ix (UU.fib0 W (bd.1 W f q2)))
         -> Id (W0.Ix (A.1.tob W f)) (bd.2.2.1 W f q2 b2)
               (bd.2.2.1 W f q (subst W0.V (\ z -> W0.Ix z) (UU.fib0 W (bd.1 W f q2)) (UU.fib0 W (bd.1 W f q))
                                  (symH (ap (UU.U0 W) W0.V (UU.fib0 W) (bd.1 W f q) (bd.1 W f q2) (apH (bd.1 W f) P2))) b2)))
      (\ b2 -> refl (bd.2.2.1 W f q b2)) q' P b ;

  -- a pair (type , map into a fixed type) from a path of types and the maps agreeing through it
  pairEq (G : PCtx) (A2 : PTy[G]) (B B' : PTy[G]) (QB : Id (PTy[G]) B B') (al : PMap[G, B, A2]) (al' : PMap[G, B', A2])
    (Hm : (X : Ob) (w : GPR.TyL[G, B'].EI X) -> Id (GPR.TyL[G, A2].EI X) (al'.mE X w) (al.mE X (GEqLaws[a].TriL[G].trE X B' B (symH QB) w)))
    : Id ((B2 : PTy[G]) * PMap[G, B2, A2]) (B, al) (B', al') =
    idJ (PTy[G]) B
      (\ B3 Q3 -> (al3 : PMap[G, B3, A2])
         -> ((X : Ob) (w : GPR.TyL[G, B3].EI X) -> Id (GPR.TyL[G, A2].EI X) (al3.mE X w) (al.mE X (GEqLaws[a].TriL[G].trE X B3 B (symH Q3) w)))
         -> Id ((B2 : PTy[G]) * PMap[G, B2, A2]) (B, al) (B3, al3))
      (\ al3 H3 -> apH {PMap[G, B, A2]} {(B2 : PTy[G]) * PMap[G, B2, A2]} (\ z -> (B, z))
         (GEqLaws[a].TriL[G].pmap-ext B A2 al al3 (\ X w -> symH (H3 X w))))
      B' QB al' Hm ;

  opaque tactGcong ; opaque alq ; opaque pairEq ;

  ----------------------------------------------------------------------
  -- the naturality: Ext of the restricted data is Ext substituted along y h

  module Nat (J I : Ob) (h : Hom J I) (D : EE.GD1 I) {
    A : UU.U0 I = D.1 ;
    r : Nat = D.2.1 ;
    ph : Fin D.2.1 -> Phi I = D.2.2.1 ;
    module D0 = Dat[I, D.1, D.2.1, D.2.2.1, D.2.2.2.1] ;
    module M = DD.Act[J, I, h, D.1, D.2.1, D.2.2.1, D.2.2.2.1] ;
    module D1 = Dat[J, M.A', D.2.1, M.ph', M.res.2.2.2] ;
    module ES = GExtSub2.ExtSub[yP I, D.1.1, psiD I D.2.1 D.2.2.1, D0.BD, D0.alD, yP J, yH J I h, psiD J D.2.1 M.ph', fullS J I h D.2.1 D.2.2.1] ;
    module AS = GExtSub6.ActS[yP I, D.1.1, psiD I D.2.1 D.2.2.1, D0.BD, D0.alD, yP J, yH J I h, psiD J D.2.1 M.ph', fullS J I h D.2.1 D.2.2.1] ;

    -- the two proofs of fullness at h w
    qs (Y : Ob) (w : W0.Ix (D1.CL.resCtx.ob Y)) : IsT (GGlueD.fl I D.2.1 D.2.2.1 Y (compH Y J I h w.1)) =
      toFl I D.2.1 D.2.2.1 Y (compH Y J I h w.1) (ES.sRnt Y w).2 ;
    qh (Y : Ob) (w : W0.Ix (D1.CL.resCtx.ob Y)) : IsT (GGlueD.fl I D.2.1 D.2.2.1 Y (compH Y J I h w.1)) =
      GGlueD.fl-pre J I h D.2.1 D.2.2.1 Y w.1 (toFl J D.2.1 M.ph' Y w.1 w.2) ;
    PF (Y : Ob) (w : W0.Ix (D1.CL.resCtx.ob Y)) : Id (UU.U0 Y) (D.2.2.2.1.1 Y (compH Y J I h w.1) (qs Y w)) (D.2.2.2.1.1 Y (compH Y J I h w.1) (qh Y w)) =
      apH (D.2.2.2.1.1 Y (compH Y J I h w.1)) (isProp-IsT' (GGlueD.fl I D.2.1 D.2.2.1 Y (compH Y J I h w.1)) (qs Y w) (qh Y w)) ;

    Po (Y : Ob) (w : W0.Ix (D1.CL.resCtx.ob Y)) : Id W0.V (ES.B'.tob Y w) (D1.BD.tob Y w) =
      ap (UU.U0 Y) W0.V (UU.fib0 Y) (D.2.2.2.1.1 Y (compH Y J I h w.1) (qs Y w)) (D.2.2.2.1.1 Y (compH Y J I h w.1) (qh Y w)) (PF Y w) ;

    H1 (Y' Y : Ob) (k : Hom Y' Y) (x : W0.Ix (D1.CL.resCtx.ob Y)) (y : W0.Ix (D1.CL.resCtx.ob Y'))
      (e : Id (W0.Ix (D1.CL.resCtx.ob Y')) (D1.CL.resCtx.act Y' Y k x) y) (a0 : W0.Ix (ES.B'.tob Y x))
      : Id (W0.Ix (D1.BD.tob Y' y)) (subst W0.V (\ z -> W0.Ix z) (ES.B'.tob Y' y) (D1.BD.tob Y' y) (Po Y' y) (ES.B'.tact Y' Y k x y e a0))
                                    (D1.BD.tact Y' Y k x y e (subst W0.V (\ z -> W0.Ix z) (ES.B'.tob Y x) (D1.BD.tob Y x) (Po Y x) a0)) =
      transH (symH (UU.substF Y' (D.2.2.2.1.1 Y' (compH Y' J I h y.1) (qs Y' y)) (D.2.2.2.1.1 Y' (compH Y' J I h y.1) (qh Y' y)) (PF Y' y)
                      (ES.B'.tact Y' Y k x y e a0)))
        (transH (tactGcong Y' Y k (D.2.2.2.1.1 Y (compH Y J I h x.1) (qs Y x)) (D.2.2.2.1.1 Y (compH Y J I h x.1) (qh Y x)) (PF Y x)
                   (D.2.2.2.1.1 Y' (compH Y' J I h y.1) (qs Y' y)) (D.2.2.2.1.1 Y' (compH Y' J I h y.1) (qh Y' y)) (PF Y' y)
                   (D.2.2.2.1.2.1 Y' Y k (compH Y J I h x.1) (qs Y x) (compH Y' J I h y.1)
                      (apH (\ z -> z.1) (ntEq D0.CL.resCtx D0.T.R.RC (toRC I D.2.1 D.2.2.1) Y' Y k (ES.sRnt Y x) (ES.sRnt Y' y)
                         (ntEq D1.CL.resCtx D0.CL.resCtx ES.sR Y' Y k x y e))) (qs Y' y))
                   (M.bn' Y' Y k x.1 (toFl J D.2.1 M.ph' Y x.1 x.2) y.1
                      (apH (\ z -> z.1) (ntEq D1.CL.resCtx D1.T.R.RC (toRC J D.2.1 M.ph') Y' Y k x y e)) (toFl J D.2.1 M.ph' Y' y.1 y.2))
                   a0)
                (apH (\ z -> D1.BD.tact Y' Y k x y e z)
                   (UU.substF Y (D.2.2.2.1.1 Y (compH Y J I h x.1) (qs Y x)) (D.2.2.2.1.1 Y (compH Y J I h x.1) (qh Y x)) (PF Y x) a0))) ;

    module TE = GEqLaws[a].TyEqPw[D1.CL.resCtx, ES.B', D1.BD, Po, H1] ;

    QB : Id (PTy[D1.CL.resCtx]) ES.B' D1.BD = TE.tyEq ;

    vv (X : Ob) (w : GPR.TyL[D1.CL.resCtx, D1.BD].EI X) : GPR.TyL[D1.CL.resCtx, ES.B'].EI X =
      GEqLaws[a].TriL[D1.CL.resCtx].trE X D1.BD ES.B' (symH QB) w ;

    -- alpha of the substituted data, read in A
    alS (X : Ob) (v : GPR.TyL[D1.CL.resCtx, ES.B'].EI X)
      : Id (D1.TAD.EI X) (ES.al'.mE X v) (v.1, D.2.2.2.1.2.2.1 X (compH X J I h v.1.1) (qs X v.1) v.2) =
      transH (ES.al'-mE X v)
        (apH {W0.Ix (D.1.1.tob X (compH X J I h v.1.1))} {D1.TAD.EI X} (\ z -> (v.1, z))
           (D0.TAD.pr-inj X (ES.sRnt X v.1) (D0.TAD.fromE X (ES.sRnt X v.1) (D0.alE X (ES.sRnt X v.1, v.2)) (refl (ES.sRnt X v.1)))
              (D0.alE X (ES.sRnt X v.1, v.2)).2
              (D0.TAD.fromE-eq X (ES.sRnt X v.1) (D0.alE X (ES.sRnt X v.1, v.2)) (refl (ES.sRnt X v.1))))) ;

    Hm (X : Ob) (w : GPR.TyL[D1.CL.resCtx, D1.BD].EI X) : Id (D1.TAD.EI X) (D1.alD.mE X w) (ES.al'.mE X (vv X w)) =
      transH (apH {W0.Ix (D.1.1.tob X (compH X J I h w.1.1))} {D1.TAD.EI X} (\ b -> (w.1, b))
                (alq I D.1 D.2.1 D.2.2.1 D.2.2.2.1 X (compH X J I h w.1.1) (qs X w.1) (qh X w.1)
                   (isProp-IsT' (GGlueD.fl I D.2.1 D.2.2.1 X (compH X J I h w.1.1)) (qs X w.1) (qh X w.1)) w.2))
       (transH (apH (\ v -> (v.1, D.2.2.2.1.2.2.1 X (compH X J I h v.1.1) (qs X v.1) v.2))
                  (symH (GEqLaws[a].TriL[D1.CL.resCtx].trE-pw X D1.BD ES.B' (symH QB) (\ y -> symH (Po X y)) (symH TE.P) w)))
               (symH (alS X (vv X w)))) ;

    pq : Id ((B2 : PTy[D1.CL.resCtx]) * PMap[D1.CL.resCtx, B2, D1.AD]) (ES.B', ES.al') (D1.BD, D1.alD) =
      pairEq D1.CL.resCtx D1.AD ES.B' D1.BD QB ES.al' D1.alD Hm ;

    nat : Id (PTy[yP J]) (subTy (yP J) (yP I) D0.ExtD (yH J I h)) D1.ExtD =
      transH (symH AS.tyEq) (apH (\ z -> GExt2[a].ExtB2[yP J, ES.A', psiD J D.2.1 M.ph', z.1, z.2].ExtT) pq) ;

    opaque H1 ; opaque alS ; opaque Hm ; opaque nat ;
  } ;

  ----------------------------------------------------------------------
  -- Ext on the universal glue data, as a small type over GD1Ctx

  ExtU : GSmall.SPTy[EE.GD1Ctx] = YY.Y[EE.GD1Ctx, PhiExt, \ J I h D -> Nat[J, I, h, D].nat].yonTy ;
} ;
