-- TranspUData.seg: MODEL/Univ/TranspUData.agda.  The transport package
-- moved along an identification of its target with the lid type
-- (trPackIso, opaque), and assembled as univalence data over y X
-- (trUData), with every type written with base definitions.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open Constr[a] ; open PosB ; open PCyl ; open PSv ;
module BaseP = Constr[a].PosB ;
module PR = BaseP.GPre[a] ;
open PR.PS ;
module BXm = Box[a, a] ;
module FibM = Fib[a, a] ;
module CN = Conn[a] ;
open CN ;
open BaseP.GYon[a] ;
module CF = Cofib[a] ;
open CF ;
open Equiv[a] ;
open BaseP.GLine[a] ;
open EquivIso[a] ;
open UnivOp[a] ;
open TranspPack[a] ;
open PackRel[a] ;

trPackIso (D L : PCtx) (S : PTy[L])
  (ln : (W : Ob) -> W0.Ix (D.ob W) -> W0.Ix (L.ob (prodP W Iv)))
  (lnat : (W' W : Ob) (g : Hom W' W) (x : W0.Ix (D.ob W))
          -> Id (W0.Ix (L.ob (prodP W' Iv))) (L.act (prodP W' Iv) (prodP W Iv) (cylH W' W g) (ln W x)) (ln W' (D.act W' W g x)))
  (d : Bool) (fS : FibM.FillDef[L, S].FillOp[src d]) (f0 : FibM.FillDef[L, S].FillOp[e0]) (fT : FibM.FillDef[L, S].FillOp[tgt d])
  (fesiS : EsiFill[a, a].FesiDef[L, S].FESI (src d) fS) (fesiT : EsiFill[a, a].FesiDef[L, S].FESI (tgt d) fT)
  (A' : PTy[D])
  (Po : (I : Ob) (x : W0.Ix (D.ob I))
        -> Id W0.V (Transp[a].Tp[D, L, S, ln, lnat, d, fS].SA.tob I x) (A'.tob I x))
  (H1 : (J I : Ob) (f : Hom J I) (x : W0.Ix (D.ob I)) (y : W0.Ix (D.ob J)) (e : Id (W0.Ix (D.ob J)) (D.act J I f x) y)
        (a0 : W0.Ix (Transp[a].Tp[D, L, S, ln, lnat, d, fS].SA.tob I x))
        -> Id (W0.Ix (A'.tob J y))
              (subst W0.V (\ z -> W0.Ix z) (Transp[a].Tp[D, L, S, ln, lnat, d, fS].SA.tob J y) (A'.tob J y) (Po J y)
                 (Transp[a].Tp[D, L, S, ln, lnat, d, fS].SA.tact J I f x y e a0))
              (A'.tact J I f x y e
                 (subst W0.V (\ z -> W0.Ix z) (Transp[a].Tp[D, L, S, ln, lnat, d, fS].SA.tob I x) (A'.tob I x) (Po I x) a0)))
  : EqvPack D Transp[a].Tp[D, L, S, ln, lnat, d, fS].SB A' =
  EI[D, Transp[a].Tp[D, L, S, ln, lnat, d, fS].SB,
        Transp[a].Tp[D, L, S, ln, lnat, d, fS].SA, A', Po, H1].pack
    (trPack D L S ln lnat d fS f0 fT fesiS fesiT) ;


-- MODEL/Univ/PackMap.agda and PackKop.agda: lemmas that unfold trPackIso,
-- hence stated here, before `opaque trPackIso`.  k0 = trPack, k1 = trPackIso.
module PM (D L : PCtx) (S : PTy[L])
  (ln : (W : Ob) -> W0.Ix (D.ob W) -> W0.Ix (L.ob (prodP W Iv)))
  (lnat : (W' W : Ob) (g : Hom W' W) (x : W0.Ix (D.ob W))
          -> Id (W0.Ix (L.ob (prodP W' Iv))) (L.act (prodP W' Iv) (prodP W Iv) (cylH W' W g) (ln W x)) (ln W' (D.act W' W g x)))
  (d : Bool) (fS : FibM.FillDef[L, S].FillOp[src d]) (f0 : FibM.FillDef[L, S].FillOp[e0]) (fT : FibM.FillDef[L, S].FillOp[tgt d])
  (fesiS : EsiFill[a, a].FesiDef[L, S].FESI (src d) fS) (fesiT : EsiFill[a, a].FesiDef[L, S].FESI (tgt d) fT)
  (A' : PTy[D]) (Po : (I : Ob) (x : W0.Ix (D.ob I)) -> Id W0.V (Transp[a].Tp[D, L, S, ln, lnat, d, fS].SA.tob I x) (A'.tob I x))
  (H1 : H1Ty D Transp[a].Tp[D, L, S, ln, lnat, d, fS].SA A' Po) {
  module T = Transp[a].Tp[D, L, S, ln, lnat, d, fS] ;
  module PK0 = PK[D, T.SB, T.SA] ;

  k0 : EqvPack D T.SB T.SA = trPack D L S ln lnat d fS f0 fT fesiS fesiT ;
  k1 : EqvPack D T.SB A' = trPackIso D L S ln lnat d fS f0 fT fesiS fesiT A' Po H1 ;

  packMapAt (W : Ob) (w : PR.TyL[D, T.SB].EI W) : Id (PR.TyL[D, A'].EI W) (k1.1.mE W w) (coeE D T.SA A' Po W (k0.1.mE W w)) =
    EI[D, T.SB, T.SA, A', Po, H1].pack-map k0 W w ;

  hpullAt (W : Ob) (w : PR.TyL[D, T.SB].EI W)
    : Id (PR.TyL[D, T.SA].EI W) (k0.1.mE W w) (coeE D A' T.SA (symPo D T.SA A' Po) W (k1.1.mE W w)) =
    symH (transH (apH (coeE D A' T.SA (symPo D T.SA A' Po) W) (packMapAt W w))
                 (apH {W0.Ix (T.SA.tob W (k0.1.mE W w).1)} {PR.TyL[D, T.SA].EI W} (\ z -> ((k0.1.mE W w).1, z))
                      (substIx-sym-r (T.SA.tob W (k0.1.mE W w).1) (A'.tob W (k0.1.mE W w).1) (Po W (k0.1.mE W w).1) (k0.1.mE W w).2))) ;

  packKopAt (X : Ob) (w' : PR.TyL[D, A'].EI X) (p' : CF.GP.Partials[extP D A', FibTy[D, T.SB, A', k1.1].FibT].Partial[X, w'])
    : Id (FibTy[D, T.SB, A', k1.1].TF.EI X) (PK0.kopOf A' k1 X w' p')
         (MV[D, T.SB, T.SA, A', Po, H1, k0.1, k1.1, packMapAt].mapV X
            (PK0.kopOf T.SA k0 X (coeE D A' T.SA (symPo D T.SA A' Po) X w')
               (MV[D, T.SB, A', T.SA, symPo D T.SA A' Po, H1sym D T.SA A' Po H1, k1.1, k0.1, hpullAt].mapP X w' p'))) =
    PK0.packKopG A' (EI[D, T.SB, T.SA, A', Po, H1].tyEq) k0 Po (symPo D T.SA A' Po) H1 (H1sym D T.SA A' Po H1)
      packMapAt hpullAt X w' p' ;

  opaque packMapAt ; opaque hpullAt ; opaque packKopAt ;
} ;

opaque trPackIso ;

trUDataOn (X : Ob) (A : PTy[yP X]) (psi : GP.Cof[yP X]) (L : PCtx) (S : PTy[L])
  (ln : (W : Ob) -> W0.Ix (GP.CofL[yP X, psi].resCtx.ob W) -> W0.Ix (L.ob (prodP W Iv)))
  (lnat : (W' W : Ob) (g : Hom W' W) (x : W0.Ix (GP.CofL[yP X, psi].resCtx.ob W))
          -> Id (W0.Ix (L.ob (prodP W' Iv))) (L.act (prodP W' Iv) (prodP W Iv) (cylH W' W g) (ln W x))
                (ln W' (GP.CofL[yP X, psi].resCtx.act W' W g x)))
  (d : Bool) (fS : FibM.FillDef[L, S].FillOp[src d]) (f0 : FibM.FillDef[L, S].FillOp[e0]) (fT : FibM.FillDef[L, S].FillOp[tgt d])
  (fesiS : EsiFill[a, a].FesiDef[L, S].FESI (src d) fS) (fesiT : EsiFill[a, a].FesiDef[L, S].FESI (tgt d) fT)
  (c : BXm.Boxes[L, S].Comp) (ec : Esi[a, a].EsiDef[L, S].ESIC c)
  (Po : (I : Ob) (x : W0.Ix (GP.CofL[yP X, psi].resCtx.ob I))
        -> Id W0.V (Transp[a].Tp[GP.CofL[yP X, psi].resCtx, L, S, ln, lnat, d, fS].SA.tob I x)
                   ((subTy GP.CofL[yP X, psi].resCtx (yP X) A GP.CofL[yP X, psi].inclR).tob I x))
  (H1 : (J I : Ob) (f : Hom J I) (x : W0.Ix (GP.CofL[yP X, psi].resCtx.ob I)) (y : W0.Ix (GP.CofL[yP X, psi].resCtx.ob J))
        (e : Id (W0.Ix (GP.CofL[yP X, psi].resCtx.ob J)) (GP.CofL[yP X, psi].resCtx.act J I f x) y)
        (a0 : W0.Ix (Transp[a].Tp[GP.CofL[yP X, psi].resCtx, L, S, ln, lnat, d, fS].SA.tob I x))
        -> Id (W0.Ix ((subTy GP.CofL[yP X, psi].resCtx (yP X) A GP.CofL[yP X, psi].inclR).tob J y))
              (subst W0.V (\ z -> W0.Ix z)
                 (Transp[a].Tp[GP.CofL[yP X, psi].resCtx, L, S, ln, lnat, d, fS].SA.tob J y)
                 ((subTy GP.CofL[yP X, psi].resCtx (yP X) A GP.CofL[yP X, psi].inclR).tob J y) (Po J y)
                 (Transp[a].Tp[GP.CofL[yP X, psi].resCtx, L, S, ln, lnat, d, fS].SA.tact J I f x y e a0))
              ((subTy GP.CofL[yP X, psi].resCtx (yP X) A GP.CofL[yP X, psi].inclR).tact J I f x y e
                 (subst W0.V (\ z -> W0.Ix z)
                    (Transp[a].Tp[GP.CofL[yP X, psi].resCtx, L, S, ln, lnat, d, fS].SA.tob I x)
                    ((subTy GP.CofL[yP X, psi].resCtx (yP X) A GP.CofL[yP X, psi].inclR).tob I x) (Po I x) a0)))
  : UDataOn[X, A, psi] =
  new UDataOn[X, A, psi, trB GP.CofL[yP X, psi].resCtx L S ln lnat d fS c ec,
    (trPackIso GP.CofL[yP X, psi].resCtx L S ln lnat d fS f0 fT fesiS fesiT (subTy GP.CofL[yP X, psi].resCtx (yP X) A GP.CofL[yP X, psi].inclR) Po H1).1,
    (trPackIso GP.CofL[yP X, psi].resCtx L S ln lnat d fS f0 fT fesiS fesiT (subTy GP.CofL[yP X, psi].resCtx (yP X) A GP.CofL[yP X, psi].inclR) Po H1).2.1,
    (trPackIso GP.CofL[yP X, psi].resCtx L S ln lnat d fS f0 fT fesiS fesiT (subTy GP.CofL[yP X, psi].resCtx (yP X) A GP.CofL[yP X, psi].inclR) Po H1).2.2] ;

trUData (X : Ob) (A : PTy[yP X]) (psi : GP.Cof[yP X]) (L : PCtx) (S : PTy[L])
  (ln : (W : Ob) -> W0.Ix (GP.CofL[yP X, psi].resCtx.ob W) -> W0.Ix (L.ob (prodP W Iv)))
  (lnat : (W' W : Ob) (g : Hom W' W) (x : W0.Ix (GP.CofL[yP X, psi].resCtx.ob W))
          -> Id (W0.Ix (L.ob (prodP W' Iv))) (L.act (prodP W' Iv) (prodP W Iv) (cylH W' W g) (ln W x))
                (ln W' (GP.CofL[yP X, psi].resCtx.act W' W g x)))
  (d : Bool) (fS : FibM.FillDef[L, S].FillOp[src d]) (f0 : FibM.FillDef[L, S].FillOp[e0]) (fT : FibM.FillDef[L, S].FillOp[tgt d])
  (fesiS : EsiFill[a, a].FesiDef[L, S].FESI (src d) fS) (fesiT : EsiFill[a, a].FesiDef[L, S].FESI (tgt d) fT)
  (c : BXm.Boxes[L, S].Comp) (ec : Esi[a, a].EsiDef[L, S].ESIC c)
  (Po : (I : Ob) (x : W0.Ix (GP.CofL[yP X, psi].resCtx.ob I))
        -> Id W0.V (Transp[a].Tp[GP.CofL[yP X, psi].resCtx, L, S, ln, lnat, d, fS].SA.tob I x)
                   ((subTy GP.CofL[yP X, psi].resCtx (yP X) A GP.CofL[yP X, psi].inclR).tob I x))
  (H1 : (J I : Ob) (f : Hom J I) (x : W0.Ix (GP.CofL[yP X, psi].resCtx.ob I)) (y : W0.Ix (GP.CofL[yP X, psi].resCtx.ob J))
        (e : Id (W0.Ix (GP.CofL[yP X, psi].resCtx.ob J)) (GP.CofL[yP X, psi].resCtx.act J I f x) y)
        (a0 : W0.Ix (Transp[a].Tp[GP.CofL[yP X, psi].resCtx, L, S, ln, lnat, d, fS].SA.tob I x))
        -> Id (W0.Ix ((subTy GP.CofL[yP X, psi].resCtx (yP X) A GP.CofL[yP X, psi].inclR).tob J y))
              (subst W0.V (\ z -> W0.Ix z)
                 (Transp[a].Tp[GP.CofL[yP X, psi].resCtx, L, S, ln, lnat, d, fS].SA.tob J y)
                 ((subTy GP.CofL[yP X, psi].resCtx (yP X) A GP.CofL[yP X, psi].inclR).tob J y) (Po J y)
                 (Transp[a].Tp[GP.CofL[yP X, psi].resCtx, L, S, ln, lnat, d, fS].SA.tact J I f x y e a0))
              ((subTy GP.CofL[yP X, psi].resCtx (yP X) A GP.CofL[yP X, psi].inclR).tact J I f x y e
                 (subst W0.V (\ z -> W0.Ix z)
                    (Transp[a].Tp[GP.CofL[yP X, psi].resCtx, L, S, ln, lnat, d, fS].SA.tob I x)
                    ((subTy GP.CofL[yP X, psi].resCtx (yP X) A GP.CofL[yP X, psi].inclR).tob I x) (Po I x) a0)))
  : UData[X, A] =
  new UData[X, A, psi, trUDataOn X A psi L S ln lnat d fS f0 fT fesiS fesiT c ec Po H1] ;

