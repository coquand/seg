      OX.O2.eal', OX.O2.keal'] ;

  -- the classifying maps agree along sR (pcs)
  KP (W : Ob) (x : W0.Ix (DY.D.ob W)) : Id (UA.Q4 W) (DX.kap W (ES.sRnt W x)) (DY.kap W x) =
    p.pcs (DX.sel W (ES.sRnt W x)).1 (DY.sel W x).1 W (compH W Y X h x.1) (DX.sel W (ES.sRnt W x)).2
      (lands-pre W Y X h (p.ps (DY.sel W x).1).pQ x.1 (DY.sel W x).2) ;

  module KS = KR.S[N.FS, N.Q8.eqNat, KP] ;

  kunifQ : Id (KG.UA.Q4 Y) (KG.UA.q4Act Y X sY (F, OX.kop)) (KG.F', OY.kop) = KS.kunifQ ;

  opaque KP ;
} ;
