            tautCl D' (\ Y x -> c Y (s.nt Y x)) (\ Y' Y h x -> transH (apH (c Y') (s.nt-nat Y' Y h x)) (cnat Y' Y h (s.nt Y x)))))
  (Y : Ob) (h : Hom Y X) {
  module KG = K8G[Cl, clSub, clSub-id, clSub-o, encCl, cE, eE, kU0, kU1, kU0e, kU1e, X, F, p, tautCl, glueCl, glueCl-sub, tautCl-sub, Y, h,
    GCofib[a+].Partials[GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUnivEq.UaU[Cl, clSub, clSub-id, clSub-o, encCl].UaTy].restrictP Y X h F p] ;
  module UA = KG.UA ;
  module UU = KG.UU ;
  module OX = KG.OX ;
  module OY = KG.OY ;
  module DX = KG.DX ;
  module DY = KG.DY ;
  sY : PSub[yP Y, yP X] = KG.sY ;

  GQ (W : Ob) (g : Hom W Y) (l : Fin p.pr) : Id (Phi W) (OY.O1.psiQ W g l) (OX.O1.psi.cQ W (sY.nt W g) l) =
    pre-comp W Y X g h (p.ps l).pQ ;

  module PQ = GExtSub2.PQ[yP X, OX.O1.psi, yP Y, sY, OY.O1.psiQ, OY.O1.psiN, GQ] ;
  module KR = KG.R[PQ.fullS] ;
