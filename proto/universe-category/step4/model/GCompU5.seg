-- GCompU5.seg (inside IvBase.Cn): the fibrancy of the universe from
-- univalence (G7, cours6 "Comp(1, U)"), part 5.  From a univalence
-- operation ua (a contractibility structure on UaTy, GUaOp9 / PUaOp.ua), the
-- composite of a problem of U is the code part of ua's extension of p'
-- (GCompU4): its sides are, on each side of the problem, the code of the
-- side's line at the end (cside, by ua.kside and cPB), and it is uniform
-- (cunif, by ua.kunif).  With the KESI of ua (U6), it has line ESI.
--   fibU   UTy G is fibrant (FibEL), for any context G

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
module L1 = GPre[a+].PS ;
open GYon[a] ;
open Encode[a, a+] ;
open Trees[a] ;
open Arith[a] ;
open GLine[a] ;





module CU (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (cE : GFibE[a+].FE[GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Comp)
  (eE : GFibE[a+].FE[GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].ESIC cE)
  (ua : GCofib[a+].Partials[GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUnivEq.UaU[Cl, clSub, clSub-id, clSub-o, encCl].UaTy].ContrOp)
  (d : Bool) (G : L1.PCtx) {
  module P = GCompU4.PP[Cl, clSub, clSub-id, clSub-o, encCl, cE, eE, d, G] ;
  module SV = P.SV ;
  module UU = P.UU ;
  module CA = P.CA ;
  module PPa = P.PPa ;
  module TC = P.TC ;
  module EKs = GLine[a+].EndKit[GFam[a+].famPath, G, UU.UTy G, src d] ;
  module LKs = GLine[a+].LevKit[GFam[a+].famPath, GFam[a+].famConn, G, UU.UTy G, src d] ;

  cop (X : Ob) (x : CA.TV.EI X) (p : CA.PT.Partial[X, x]) : CA.TV'.T X x.1 = (ua.kop X x.2 (P.part X x p)).1 ;

  -- the code at src d of a side's line
  codeEndS (W : Ob) (u : CA.TS.EI W) : Id (UU.U0 W) (SV.Ln[W, P.lnC W (CA.EK.lineL W u)].Fe (src d)) (CA.endL W u).2 =
    apH (\ z -> z.2) (symH (LKs.endL-lev W (CA.EK.lineL W u))) ;

  cside (X : Ob) (x : CA.TV.EI X) (p : CA.PT.Partial[X, x]) (l : Fin p.pr) (W : Ob) (f : Hom W X) (i : Lands W X (p.ps l).pQ f)
    : Id (CA.TV'.EI W) (CA.TV'.E.act W X f (x.1, cop X x p)) (CA.endL W ((p.ps l).pv W f i)) =
    transH (apH {V1.Ix ((GFam[a+].famPath.pth G).ob W)} {CA.TV'.EI W} (\ z -> (z, UU.uAct W X f (cop X x p)))
              (transH (apH (\ z -> z.1) (symH ((p.ps l).ppt W f i)))
                      (symH ((GFam[a+].famPath.pevA G (UU.UTy G) (src d)).mpt W (CA.EK.lineL W ((p.ps l).pv W f i))))))
      (apH {UU.U0 W} {CA.TV'.EI W} (\ c -> ((CA.endL W ((p.ps l).pv W f i)).1, c))
         (transH (apH (\ z -> z.2.1) (ua.kside X x.2 (P.part X x p) l W f i))
           (transH SV.Ln[W, P.lnC W (CA.EK.lineL W ((p.ps l).pv W f i))].cPB (codeEndS W ((p.ps l).pv W f i))))) ;

  -- the moved problem of a restricted problem is the restricted moved problem
  partRes (Y X : Ob) (h : Hom Y X) (x : CA.TV.EI X) (p : CA.PT.Partial[X, x])
    : Id (PPa.Partial[Y, UU.uAct Y X h x.2]) (PPa.restrictP Y X h x.2 (P.part X x p)) (P.part Y (CA.TV.E.act Y X h x) (CA.PT.restrictP Y X h x p)) =
    PPa.partExtH Y (UU.uAct Y X h x.2) (UU.uAct Y X h x.2) (refl (UU.uAct Y X h x.2))
      (PPa.restrictP Y X h x.2 (P.part X x p)) (P.part Y (CA.TV.E.act Y X h x) (CA.PT.restrictP Y X h x p))
      (refl p.pr) (\ l -> refl (pre Y X h (p.ps l).pQ))
      (\ l V g i i' -> apH (P.val V) (CA.PT.pv-irr X x (p.ps l) V (compH V Y X h g)
                                       (lands-pre V Y X h (p.ps l).pQ g i) (lands-pre V Y X h (p.ps l).pQ g i'))) ;

  cunif (Y X : Ob) (h : Hom Y X) (x : CA.TV.EI X) (p : CA.PT.Partial[X, x])
    : Id (CA.TV'.EI Y) (CA.TV'.E.act Y X h (x.1, cop X x p)) ((CA.TV.E.act Y X h x).1, cop Y (CA.TV.E.act Y X h x) (CA.PT.restrictP Y X h x p)) =
    apH {UU.U0 Y} {CA.TV'.EI Y} (\ c -> ((CA.TV.E.act Y X h x).1, c))
      (transH (apH (\ z -> z.2.1) (ua.kunif Y X h x.2 (P.part X x p)))
              (apH (\ q -> (ua.kop Y (UU.uAct Y X h x.2) q).1) (partRes Y X h x p))) ;

  opaque codeEndS ; opaque cside ; opaque partRes ; opaque cunif ;

  compAt : CA.CompAt = new CA.CompAt[cop, cside, cunif] ;

  -- ESI, from the KESI of ua
  module PEU = GCofEsi[a+].PartialsEsi[UU.UCtx, P.UA.UaTy] ;

  insPart (X : Ob) (x : CA.TV.EI X) (k : Nat) (p p' : CA.PT.Partial[X, x]) (ins : CA.PEs.InsP[X, x, k, p, p'])
    : PEU.InsP[X, x.2, k, P.part X x p, P.part X x p'] =
    new PEU.InsP[X, x.2, k, P.part X x p, P.part X x p', ins.insp-r, ins.insp-k, ins.insp-e, ins.insp-Q,
      \ n h1 h' W f i i' -> apH (P.val W) (ins.insp-v n h1 h' W f i i')] ;

  cesi (uaKesi : PEU.KESI ua) : CA.CESI compAt = \ X x k p p' ins ->
    apH (\ z -> z.1) (uaKesi X x.2 k (P.part X x p) (P.part X x p') (insPart X x k p p' ins)) ;
} ;

-- the universe is fibrant (both directions; d = false: e0 -> e1)
module FibU (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (cE : GFibE[a+].FE[GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Comp)
  (eE : GFibE[a+].FE[GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].ESIC cE)
  (ua : GCofib[a+].Partials[GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUnivEq.UaU[Cl, clSub, clSub-id, clSub-o, encCl].UaTy].ContrOp)
  (uaKesi : GCofEsi[a+].PartialsEsi[GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, GUnivEq.UaU[Cl, clSub, clSub-id, clSub-o, encCl].UaTy].KESI ua)
  (G : L1.PCtx) {
  module C01 = CU[Cl, clSub, clSub-id, clSub-o, encCl, cE, eE, ua, false, G] ;
  module C10 = CU[Cl, clSub, clSub-id, clSub-o, encCl, cE, eE, ua, true, G] ;

  fibU : GFibE[a+].FibEL G = (GUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UTy G, ((C01.compAt, C10.compAt), (C01.cesi uaKesi, C10.cesi uaKesi))) ;
} ;
