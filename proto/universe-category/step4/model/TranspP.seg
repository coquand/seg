-- TranspP.seg: MODEL/Univ/TranspP.agda.  Transport is an equivalence,
-- part 4: the path component.
--
-- Over X * [1]_j, fill (in i, lid at i = s) the box with line
-- ln (X * [1]) (x pX) and
--   lid  (i = s)  : bnew, constant in j
--   side j = e0   : U0 = the transport filler of bnew      (V1 0)
--   side j = e1   : FEb = the filler of the B-box         (V1 1)
--   side Q_k      : omega (nu_k (f pX)) read along mF f    (V2 k)
--                   (mF f (w , i) = ((w , i) , j (f w)))
-- Its end at i = t is the new path p, from tr bnew (j = e0) to a (j = e1),
-- restricting to the given paths on Q_k.   FEp, pnewS, the box data LDp.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open Constr[a] ; open PosB ; open PCyl ; open PSv ;
open Simp[a] ;
open BoxBase[a] ;
module BaseP = Constr[a].PosB ;
module PR = BaseP.GPre[a] ;
open PR.PS ;
module BXm = Box[a, a] ;
module FibM = Fib[a, a] ;
module CN = Conn[a] ;
open CN ;
module CF = Cofib[a] ;
open CF ;
open Equiv[a] ;
open BaseP.GLine[a] ;
open ExtKit[a] ;

-- the end point of index n (0 |-> e0, otherwise e1)
jE : Nat -> El Iv = split { zero -> e0 ; suc n -> e1 } ;

el-irr (A B : Ob) (g : Hom A B) (x y : El A) (P : Id Tree x.1 y.1) : Id Tree (app A B g x).1 (app A B g y).1 =
  apH (\ z -> (app A B g z).1) (el-eq A x y P) ;

node2 {a a' b b' : Tree} (p : Id Tree a a') (q : Id Tree b b') : Id Tree (node a b) (node a' b') =
  transH (apH {Tree} {Tree} (\ z -> node z b) p) (apH {Tree} {Tree} (\ z -> node a' z) q) ;

-- (w , i) |-> ((w , i) , j (f w))
mF (X W : Ob) (f : Hom W (prodP X Iv)) : Hom (prodP W Iv) (prodP (prodP W Iv) Iv) =
  pairH (prodP W Iv) Iv (prodP W Iv) (idH (prodP W Iv)) (compH (prodP W Iv) (prodP X Iv) Iv (pr2 X Iv) (compH (prodP W Iv) W (prodP X Iv) f (pX W))) ;

module P2T (X : Ob) {
  G (t : Tree) : U a = (h : IsT (car (prodP X Iv) t)) -> Id Tree (app (prodP X Iv) Iv (pr2 X Iv) (t, h)).1 (pr2T t) ;
  aux : (t : Tree) -> G t = split {
    leaf n -> \ h -> absurd _ (false-true h) ;
    node u v -> \ h -> refl v } ;
} ;

pr2-T (X : Ob) (z : El (prodP X Iv)) : Id Tree (app (prodP X Iv) Iv (pr2 X Iv) z).1 (pr2T z.1) = P2T[X].aux z.1 z.2 ;

-- the characterising equation of mF:  mF f z = (z , j (f (pX z))),
-- as  id z = z  and  (pr2 (f pX)) z = pr2 (f (pX z)) = j (f (pX z))
app-mF1 (X W : Ob) (f : Hom W (prodP X Iv)) (z : El (prodP W Iv))
  : Id Tree (app (prodP W Iv) (prodP (prodP W Iv) Iv) (mF X W f) z).1
            (node z.1 (pr2T (app W (prodP X Iv) f (app (prodP W Iv) W (pX W) z)).1)) =
  node2 (app-idH1 (prodP W Iv) z)
    (transH (app-compH1 (prodP W Iv) (prodP X Iv) Iv (pr2 X Iv) (compH (prodP W Iv) W (prodP X Iv) f (pX W)) z)
     (transH (el-irr (prodP X Iv) Iv (pr2 X Iv) (app (prodP W Iv) (prodP X Iv) (compH (prodP W Iv) W (prodP X Iv) f (pX W)) z)
                (app W (prodP X Iv) f (app (prodP W Iv) W (pX W) z)) (app-compH1 (prodP W Iv) W (prodP X Iv) f (pX W) z))
             (pr2-T X (app W (prodP X Iv) f (app (prodP W Iv) W (pX W) z))))) ;

-- the characterising equation of evm:  evm psi w = (w , j (psi w))
app-evm1 (X W : Ob) (psi : Hom W (prodP X Iv)) (w : El W)
  : Id Tree (app W (prodP W Iv) (evm X W psi) w).1 (node w.1 (pr2T (app W (prodP X Iv) psi w).1)) =
  calc Tree {
      (app W (prodP W Iv) (evm X W psi) w).1
    =< node2 (app-idH1 W w) (app-compH1 W (prodP X Iv) Iv (pr2 X Iv) psi w) >
      node w.1 (app (prodP X Iv) Iv (pr2 X Iv) (app W (prodP X Iv) psi w)).1
    =< apH (\ y -> node w.1 y) (pr2-T X (app W (prodP X Iv) psi w)) >
      node w.1 (pr2T (app W (prodP X Iv) psi w).1) } ;

-- pX mF = id  and  pX evm = id  (first projections of pairs)
pX-mF (X W : Ob) (f : Hom W (prodP X Iv))
  : Id (Hom (prodP W Iv) (prodP W Iv)) (compH (prodP W Iv) (prodP (prodP W Iv) Iv) (prodP W Iv) (pX (prodP W Iv)) (mF X W f)) (idH (prodP W Iv)) =
  pr1-pair (prodP W Iv) Iv (prodP W Iv) (idH (prodP W Iv)) (compH (prodP W Iv) (prodP X Iv) Iv (pr2 X Iv) (compH (prodP W Iv) W (prodP X Iv) f (pX W))) ;

-- mF is natural: both sides send z to ((chi * [1]) z , j (f (chi (pX z))))
mF-nat (X W' W : Ob) (chi : Hom W' W) (f : Hom W (prodP X Iv))
  : PW (prodP W' Iv) (prodP (prodP W Iv) Iv)
       (compH (prodP W' Iv) (prodP (prodP W' Iv) Iv) (prodP (prodP W Iv) Iv) (cylH (prodP W' Iv) (prodP W Iv) (cylH W' W chi)) (mF X W' (compH W' W (prodP X Iv) f chi)))
       (compH (prodP W' Iv) (prodP W Iv) (prodP (prodP W Iv) Iv) (mF X W f) (cylH W' W chi)) =
  pw-cc (prodP W' Iv) (prodP (prodP W' Iv) Iv) (prodP W Iv) (prodP (prodP W Iv) Iv)
    (cylH (prodP W' Iv) (prodP W Iv) (cylH W' W chi)) (mF X W' (compH W' W (prodP X Iv) f chi)) (mF X W f) (cylH W' W chi) (\ z ->
  calc Tree {
      (app (prodP (prodP W' Iv) Iv) (prodP (prodP W Iv) Iv) (cylH (prodP W' Iv) (prodP W Iv) (cylH W' W chi)) (m z)).1
    =< app-cylH1 (prodP W' Iv) (prodP W Iv) (cylH W' W chi) (m z) >
      node (app (prodP W' Iv) (prodP W Iv) (cylH W' W chi) (p1 (prodP W' Iv) Iv (m z))).1 (p2 (prodP W' Iv) Iv (m z)).1
    =< node2 (el-irr (prodP W' Iv) (prodP W Iv) (cylH W' W chi) (p1 (prodP W' Iv) Iv (m z)) z
                (p1-node (prodP W' Iv) Iv (m z) z.1 (jz z) (app-mF1 X W' (compH W' W (prodP X Iv) f chi) z)))
             (transH (p2-node (prodP W' Iv) Iv (m z) z.1 (jz z) (app-mF1 X W' (compH W' W (prodP X Iv) f chi) z))
                     (apH (\ y -> pr2T y) (transH (app-compH1 W' W (prodP X Iv) f chi (app (prodP W' Iv) W' (pX W') z))
                        (el-irr W (prodP X Iv) f (app W' W chi (app (prodP W' Iv) W' (pX W') z)) (app (prodP W Iv) W (pX W) (c z))
                           (symH (p1-node W Iv (c z) (app W' W chi (p1 W' Iv z)).1 (p2 W' Iv z).1 (app-cylH1 W' W chi z))))))) >
      node (c z).1 (pr2T (app W (prodP X Iv) f (app (prodP W Iv) W (pX W) (c z))).1)
    =< symH (app-mF1 X W f (c z)) >
      (app (prodP W Iv) (prodP (prodP W Iv) Iv) (mF X W f) (c z)).1 })
 where {
   m (z : El (prodP W' Iv)) : El (prodP (prodP W' Iv) Iv) = app (prodP W' Iv) (prodP (prodP W' Iv) Iv) (mF X W' (compH W' W (prodP X Iv) f chi)) z ;
   c (z : El (prodP W' Iv)) : El (prodP W Iv) = app (prodP W' Iv) (prodP W Iv) (cylH W' W chi) z ;
   jz (z : El (prodP W' Iv)) : Tree = pr2T (app W' (prodP X Iv) (compH W' W (prodP X Iv) f chi) (app (prodP W' Iv) W' (pX W') z)).1 ; } ;

-- mF after a lid is the lid after evm: both send w to ((w , e) , j (f w))
mF-lid-evm (X W : Ob) (f : Hom W (prodP X Iv)) (e : El Iv)
  : PW W (prodP (prodP W Iv) Iv) (compH W (prodP W Iv) (prodP (prodP W Iv) Iv) (mF X W f) (lid W e))
                                 (compH W (prodP W Iv) (prodP (prodP W Iv) Iv) (cylH W (prodP W Iv) (lid W e)) (evm X W f)) =
  pw-cc W (prodP W Iv) (prodP W Iv) (prodP (prodP W Iv) Iv) (mF X W f) (lid W e) (cylH W (prodP W Iv) (lid W e)) (evm X W f) (\ w ->
  calc Tree {
      (app (prodP W Iv) (prodP (prodP W Iv) Iv) (mF X W f) (l w)).1
    =< app-mF1 X W f (l w) >
      node (l w).1 (pr2T (app W (prodP X Iv) f (app (prodP W Iv) W (pX W) (l w))).1)
    =< node2 (symH (el-irr W (prodP W Iv) (lid W e) (p1 W Iv (v w)) w (p1-node W Iv (v w) w.1 (jw w) (app-evm1 X W f w))))
             (transH (apH (\ y -> pr2T y) (el-irr W (prodP X Iv) f (app (prodP W Iv) W (pX W) (l w)) w (p1-node W Iv (l w) w.1 e.1 (app-lid1 W e w))))
                     (symH (p2-node W Iv (v w) w.1 (jw w) (app-evm1 X W f w)))) >
      node (app W (prodP W Iv) (lid W e) (p1 W Iv (v w))).1 (p2 W Iv (v w)).1
    =< symH (app-cylH1 W (prodP W Iv) (lid W e) (v w)) >
      (app (prodP W Iv) (prodP (prodP W Iv) Iv) (cylH W (prodP W Iv) (lid W e)) (v w)).1 })
 where {
   l (w : El W) : El (prodP W Iv) = app W (prodP W Iv) (lid W e) w ;
   v (w : El W) : El (prodP W Iv) = app W (prodP W Iv) (evm X W f) w ;
   jw (w : El W) : Tree = pr2T (app W (prodP X Iv) f w).1 ; } ;

-- on {j = e}, mF f is the lid e
module ML (X W : Ob) (e : El Iv) (f : Hom W (prodP X Iv)) (i : Lands W (prodP X Iv) (endQ e X) f) {
  G (t : Tree) : U a = (h : IsT (car (prodP W Iv) t))
    -> Id Tree (app (prodP W Iv) (prodP (prodP W Iv) Iv) (mF X W f) (t, h)).1 (app (prodP W Iv) (prodP (prodP W Iv) Iv) (lid (prodP W Iv) e) (t, h)).1 ;
  -- mF f z = (z , j (f (pX z))) = (z , e) = lid e z, as f lands in {j = e}
  ptEq (z : El (prodP W Iv))
    : Id Tree (app (prodP W Iv) (prodP (prodP W Iv) Iv) (mF X W f) z).1 (app (prodP W Iv) (prodP (prodP W Iv) Iv) (lid (prodP W Iv) e) z).1 =
    calc Tree {
        (app (prodP W Iv) (prodP (prodP W Iv) Iv) (mF X W f) z).1
      =< app-mF1 X W f z >
        node z.1 (pr2T (app W (prodP X Iv) f (app (prodP W Iv) W (pX W) z)).1)
      =< apH (\ y -> node z.1 (pr2T y)) (end-tree X e (app W (prodP X Iv) f (app (prodP W Iv) W (pX W) z)) (i (app (prodP W Iv) W (pX W) z))) >
        node z.1 e.1
      =< symH (app-lid1 (prodP W Iv) e z) >
        (app (prodP W Iv) (prodP (prodP W Iv) Iv) (lid (prodP W Iv) e) z).1 } ;
  aux : (t : Tree) -> G t = \ t h -> ptEq (t, h) ;
} ;

mF-lid (X W : Ob) (e : El Iv) (f : Hom W (prodP X Iv)) (i : Lands W (prodP X Iv) (endQ e X) f)
  : PW (prodP W Iv) (prodP (prodP W Iv) Iv) (mF X W f) (lid (prodP W Iv) e) = \ z -> ML[X, W, e, f, i].aux z.1 z.2 ;

module TP (D L : PCtx) (S : PTy[L])
  (ln : (W : Ob) -> W0.Ix (D.ob W) -> W0.Ix (L.ob (prodP W Iv)))
  (lnat : (W' W : Ob) (g : Hom W' W) (x : W0.Ix (D.ob W))
          -> Id (W0.Ix (L.ob (prodP W' Iv))) (L.act (prodP W' Iv) (prodP W Iv) (cylH W' W g) (ln W x)) (ln W' (D.act W' W g x)))
  (d : Bool) (fS : FibM.FillDef[L, S].FillOp[src d]) (f0 : FibM.FillDef[L, S].FillOp[e0])
  (fT : FibM.FillDef[L, S].FillOp[tgt d]) {
  open Transp[a].Tp[D, L, S, ln, lnat, d, fS] ;
  open TranspSq[a].Sq[D, L, S, ln, lnat, d, fS, f0] ;
  open TranspSqN[a].SqN[D, L, S, ln, lnat, d, fS, f0] ;
  open TranspB[a].TB[D, L, S, ln, lnat, d, fS, f0, fT] ;

  -- a side value depends on the map only up to equality (and not on the landing proof)
  pv-hom (X : Ob) (w : SEt.TD.EI X) (sd : PX.PSide[X, w]) (W : Ob) (f g : Hom W X) (E : Id (Hom W X) f g)
    (i : Lands W X sd.pQ f) (j : Lands W X sd.pQ g) : Id (FTr.TF.EI W) (sd.pv W f i) (sd.pv W g j) =
    idJ (Hom W X) f (\ g2 E2 -> (j2 : Lands W X sd.pQ g2) -> Id (FTr.TF.EI W) (sd.pv W f i) (sd.pv W g2 j2))
      (\ j2 -> apH (\ j3 -> sd.pv W f j3) (isProp-Lands W X sd.pQ f i j2)) g E j ;

  module PP (X : Ob) (w : SEt.TD.EI X) (p : PX.Partial[X, w]) {
    x : W0.Ix (D.ob X) = w.1 ;

    rhoP : W0.Ix (L.ob (prodP (prodP X Iv) Iv)) = ln (prodP X Iv) (D.act (prodP X Iv) X (pX X) x) ;

    bn : TS.EI X = bnewS X w p ;

    lwP : TS.EI (prodP X Iv) = ES.act (prodP X Iv) X (pX X) bn ;

    lwptP : Id (W0.Ix (L.ob (prodP X Iv))) lwP.1 (L.act (prodP X Iv) (prodP (prodP X Iv) Iv) (lid (prodP X Iv) s) rhoP) =
      symH (enNat s (prodP X Iv) X (pX X) x) ;

    U0 : TS.EI (prodP X Iv) = uF X x bn (refl (en s X x)) ;

    UU : Nat -> TS.EI (prodP X Iv) = split { zero -> U0 ; suc n -> FEb X w p } ;

    UU-lid : (n : Nat) -> Id (TS.EI X) (ES.act X (prodP X Iv) (lid X s) (UU n)) bn = split {
      zero -> uF-lid X x bn (refl (en s X x)) ;
      suc n -> refl bn } ;

    lnP (W : Ob) (f : Hom W (prodP X Iv))
      : Id (W0.Ix (L.ob (prodP W Iv))) (L.act (prodP W Iv) (prodP X Iv) (cylH W X (pXf W X f)) (ln X x))
                                       (L.act (prodP W Iv) (prodP (prodP X Iv) Iv) (cylH W (prodP X Iv) f) rhoP) =
      symH (transH (apH (L.act (prodP W Iv) (prodP (prodP X Iv) Iv) (cylH W (prodP X Iv) f)) (symH (lnat (prodP X Iv) X (pX X) x)))
                   (LL.actTri (prodP W Iv) (prodP (prodP X Iv) Iv) (prodP X Iv) (cylH (prodP X Iv) X (pX X)) (cylH W (prodP X Iv) f) (cylH W X (pXf W X f)) (hom-eq (prodP W Iv) (prodP X Iv) (compH (prodP W Iv) (prodP (prodP X Iv) Iv) (prodP X Iv) (cylH (prodP X Iv) X (pX X)) (cylH W (prodP X Iv) f)) (cylH W X (pXf W X f)) (pw-cyl-comp W (prodP X Iv) X (pX X) f)) (ln X x))) ;

    ------------------------------------------------------------------
    -- The sides j = e0, e1

    V1 (n : Nat) (W : Ob) (f : Hom W (prodP X Iv)) : TS.EI (prodP W Iv) = ES.act (prodP W Iv) (prodP X Iv) (cylH W X (pXf W X f)) (UU n) ;

    V1-pt : (n : Nat) (W : Ob) (f : Hom W (prodP X Iv))
      -> Id (W0.Ix (L.ob (prodP W Iv))) (V1 n W f).1 (L.act (prodP W Iv) (prodP (prodP X Iv) Iv) (cylH W (prodP X Iv) f) rhoP) = split {
      zero -> \ W f -> lnP W f ;
      suc n -> \ W f -> lnP W f } ;

    V1-nat (n : Nat) (W' W : Ob) (chi : Hom W' W) (f : Hom W (prodP X Iv))
      : Id (TS.EI (prodP W' Iv)) (V1 n W' (compH W' W (prodP X Iv) f chi)) (ES.act (prodP W' Iv) (prodP W Iv) (cylH W' W chi) (V1 n W f)) =
      symH (TS.PE.actTri (prodP W' Iv) (prodP W Iv) (prodP X Iv) (cylH W X (pXf W X f)) (cylH W' W chi) (cylH W' X (pXf W' X (compH W' W (prodP X Iv) f chi))) (hom-eq (prodP W' Iv) (prodP X Iv) (compH (prodP W' Iv) (prodP W Iv) (prodP X Iv) (cylH W X (pXf W X f)) (cylH W' W chi)) (cylH W' X (pXf W' X (compH W' W (prodP X Iv) f chi))) (\ z -> transH (pw-cyl-comp W' W X (pXf W X f) chi z)
                             (apH (\ k -> (app (prodP W' Iv) (prodP X Iv) (cylH W' X k) z).1) (pXf-comp W' W X f chi)))) (UU n)) ;

    V1-lid (n : Nat) (W : Ob) (f : Hom W (prodP X Iv))
      : Id (TS.EI W) (ES.act W (prodP W Iv) (lid W s) (V1 n W f)) (ES.act W (prodP X Iv) f lwP) =
      transH (TS.PE.actSq W (prodP W Iv) X (prodP X Iv) (cylH W X (pXf W X f)) (lid W s) (lid X s) (pXf W X f) (hom-eq W (prodP X Iv) (compH W (prodP W Iv) (prodP X Iv) (cylH W X (pXf W X f)) (lid W s)) (compH W X (prodP X Iv) (lid X s) (pXf W X f)) (\ z -> symH (pw-lid W X (pXf W X f) s z))) (UU n))
       (transH (apH (ES.act W X (pXf W X f)) (UU-lid n))
               (symH (TS.PE.actTri W (prodP X Iv) X (pX X) f (pXf W X f) (hom-eq W X (compH W (prodP X Iv) X (pX X) f) (pXf W X f) (\ z -> refl (app W X (pXf W X f) z).1)) bn))) ;

    F1 : LBs.LFam[prodP X Iv, rhoP, lwP, suc (suc zero)] = new LBs.LFam[prodP X Iv, rhoP, lwP, suc (suc zero),
      \ k -> endQ (jE k.1) X, \ k W f i -> V1 k.1 W f, \ k W f i -> V1-pt k.1 W f,
      \ k W' W chi f i i' -> V1-nat k.1 W' W chi f, \ k W f i -> V1-lid k.1 W f] ;

    C11 (n n' : Nat) : U a = (W : Ob) (f : Hom W (prodP X Iv)) -> Lands W (prodP X Iv) (endQ (jE n) X) f
      -> Lands W (prodP X Iv) (endQ (jE n') X) f -> Id (TS.EI (prodP W Iv)) (V1 n W f) (V1 n' W f) ;

    c11z : (n' : Nat) -> C11 zero n' = split {
      zero -> \ W f i i' -> refl (V1 zero W f) ;
      suc n' -> \ W f i i' -> absurd _ (end-disj W X f i i') } ;

    c11s (n : Nat) : (n' : Nat) -> C11 (suc n) n' = split {
      zero -> \ W f i i' -> absurd _ (end-disj W X f i' i) ;
      suc n' -> \ W f i i' -> refl (V1 (suc n) W f) } ;

    c11n : (n n' : Nat) -> C11 n n' = split { zero -> c11z ; suc n -> c11s n } ;

    ------------------------------------------------------------------
    -- The sides Q_k

    QP (k : Fin p.pr) : Subset (prodP X Iv) = pre (prodP X Iv) X (pX X) (p.ps k).pQ ;

    gOf (k : Fin p.pr) (W : Ob) (f : Hom W (prodP X Iv)) (i : Lands W (prodP X Iv) (QP k) f) : Lands W X (p.ps k).pQ (pXf W X f) =
      lands-pre W (prodP X Iv) X (pX X) (p.ps k).pQ f i ;

    nuP (k : Fin p.pr) (W : Ob) (f : Hom W (prodP X Iv)) (i : Lands W (prodP X Iv) (QP k) f) : FD[W] =
      nuOf X w p k W (pXf W X f) (gOf k W f i) ;

    -- the landing proof of (pX f) chi, from that of pX (f chi)
    gOfC (k : Fin p.pr) (W' W : Ob) (chi : Hom W' W) (f : Hom W (prodP X Iv))
      (i' : Lands W' (prodP X Iv) (QP k) (compH W' W (prodP X Iv) f chi)) : Lands W' X (p.ps k).pQ (compH W' W X (pXf W X f) chi) =
      substH (\ g -> Lands W' X (p.ps k).pQ g) (symH (pXf-comp W' W X f chi)) (gOf k W' (compH W' W (prodP X Iv) f chi) i') ;

    V2 (k : Fin p.pr) (W : Ob) (f : Hom W (prodP X Iv)) (i : Lands W (prodP X Iv) (QP k) f) : TS.EI (prodP W Iv) =
      ES.act (prodP W Iv) (prodP (prodP W Iv) Iv) (mF X W f) (omF W (nuP k W f i)) ;

    V2-pt (k : Fin p.pr) (W : Ob) (f : Hom W (prodP X Iv)) (i : Lands W (prodP X Iv) (QP k) f)
      : Id (W0.Ix (L.ob (prodP W Iv))) (V2 k W f i).1 (L.act (prodP W Iv) (prodP (prodP X Iv) Iv) (cylH W (prodP X Iv) f) rhoP) =
      transH (apH (L.act (prodP W Iv) (prodP (prodP W Iv) Iv) (mF X W f)) (omF-pt W (nuP k W f i)))
       (transH (LL.actTri (prodP W Iv) (prodP (prodP W Iv) Iv) (prodP W Iv) (pX (prodP W Iv)) (mF X W f) (idH (prodP W Iv)) (pX-mF X W f) (ln W (nuP k W f i).x'))
        (transH (L.act-id (prodP W Iv) (ln W (nuP k W f i).x'))
         (transH (apH (ln W) (apH (\ z -> z.1) ((p.ps k).ppt W (pXf W X f) (gOf k W f i))))
          (transH (symH (lnat W X (pXf W X f) x)) (lnP W f))))) ;

    V2-nat (k : Fin p.pr) (W' W : Ob) (chi : Hom W' W) (f : Hom W (prodP X Iv)) (i : Lands W (prodP X Iv) (QP k) f)
      (i' : Lands W' (prodP X Iv) (QP k) (compH W' W (prodP X Iv) f chi))
      : Id (TS.EI (prodP W' Iv)) (V2 k W' (compH W' W (prodP X Iv) f chi) i') (ES.act (prodP W' Iv) (prodP W Iv) (cylH W' W chi) (V2 k W f i)) =
      transH (apH (ES.act (prodP W' Iv) (prodP (prodP W' Iv) Iv) (mF X W' (compH W' W (prodP X Iv) f chi)))
               (transH (apH (\ v -> omF W' (fdOf W' v))
                          -- pX (f chi) = (pX f) chi, then naturality of the side
                          (transH (pv-hom X w (p.ps k) W' (pXf W' X (compH W' W (prodP X Iv) f chi)) (compH W' W X (pXf W X f) chi)
                                     (symH (pXf-comp W' W X f chi)) (gOf k W' (compH W' W (prodP X Iv) f chi) i') (gOfC k W' W chi f i'))
                                  (symH (pnatF X w (p.ps k) W' W chi (pXf W X f) (gOf k W f i) (gOfC k W' W chi f i')))))
                (transH (apH (omF W') (fdOf-act W' W chi ((p.ps k).pv W (pXf W X f) (gOf k W f i))))
                        (symH (omF-nat W' W chi (nuP k W f i))))))
             (TS.PE.actSq (prodP W' Iv) (prodP (prodP W' Iv) Iv) (prodP W Iv) (prodP (prodP W Iv) Iv) (cylH (prodP W' Iv) (prodP W Iv) (cylH W' W chi)) (mF X W' (compH W' W (prodP X Iv) f chi)) (mF X W f) (cylH W' W chi) (hom-eq (prodP W' Iv) (prodP (prodP W Iv) Iv) (compH (prodP W' Iv) (prodP (prodP W' Iv) Iv) (prodP (prodP W Iv) Iv) (cylH (prodP W' Iv) (prodP W Iv) (cylH W' W chi)) (mF X W' (compH W' W (prodP X Iv) f chi))) (compH (prodP W' Iv) (prodP W Iv) (prodP (prodP W Iv) Iv) (mF X W f) (cylH W' W chi)) (mF-nat X W' W chi f)) (omF W (nuP k W f i))) ;

    V2-lid (k : Fin p.pr) (W : Ob) (f : Hom W (prodP X Iv)) (i : Lands W (prodP X Iv) (QP k) f)
      : Id (TS.EI W) (ES.act W (prodP W Iv) (lid W s) (V2 k W f i)) (ES.act W (prodP X Iv) f lwP) =
      transH (TS.PE.actSq W (prodP W Iv) (prodP W Iv) (prodP (prodP W Iv) Iv) (mF X W f) (lid W s) (cylH W (prodP W Iv) (lid W s)) (evm X W f) (hom-eq W (prodP (prodP W Iv) Iv) (compH W (prodP W Iv) (prodP (prodP W Iv) Iv) (mF X W f) (lid W s)) (compH W (prodP W Iv) (prodP (prodP W Iv) Iv) (cylH W (prodP W Iv) (lid W s)) (evm X W f)) (mF-lid-evm X W f s)) (omF W (nuP k W f i)))
       (transH (apH (ES.act W (prodP W Iv) (evm X W f)) (omF-sideS W (nuP k W f i) W (lid W s) (lid-lands-self W s)))
        (transH (TS.PE.actTri W (prodP W Iv) W (compH (prodP W Iv) W W (pXf W W (lid W s)) (pX W)) (evm X W f) (idH W) pXlid-evm (nuP k W f i).bS)
         (transH (ES.act-id W (nuP k W f i).bS)
          (transH (symH (bnew-side X w p k W (pXf W X f) (gOf k W f i)))
                  (symH (TS.PE.actTri W (prodP X Iv) X (pX X) f (pXf W X f) (hom-eq W X (compH W (prodP X Iv) X (pX X) f) (pXf W X f) (\ z -> refl (app W X (pXf W X f) z).1)) bn))))))
     where {
       -- (pX (lid s)) pX evm = (pX (lid s)) id = pX (lid s) = id
       pXlid-evm : Id (Hom W W) (compH W (prodP W Iv) W (compH (prodP W Iv) W W (pXf W W (lid W s)) (pX W)) (evm X W f)) (idH W) =
         calc (Hom W W) {
             compH W (prodP W Iv) W (compH (prodP W Iv) W W (pXf W W (lid W s)) (pX W)) (evm X W f)
           =< comp-assoc W (prodP W Iv) W W (pXf W W (lid W s)) (pX W) (evm X W f) >
             compH W W W (pXf W W (lid W s)) (compH W (prodP W Iv) W (pX W) (evm X W f))
           =< apH (\ k -> compH W W W (pXf W W (lid W s)) k) (pX-evm X W f) >
             compH W W W (pXf W W (lid W s)) (idH W)
           =< comp-idr W W (pXf W W (lid W s)) >
             pXf W W (lid W s)
           =< pX-lid W s >
             idH W } ; } ;

    F2 : LBs.LFam[prodP X Iv, rhoP, lwP, p.pr] = new LBs.LFam[prodP X Iv, rhoP, lwP, p.pr, QP, V2, V2-pt, V2-nat, V2-lid] ;

    C12 (n : Nat) : U a = (k : Fin p.pr) (W : Ob) (f : Hom W (prodP X Iv)) -> Lands W (prodP X Iv) (endQ (jE n) X) f
      -> (i' : Lands W (prodP X Iv) (QP k) f) -> Id (TS.EI (prodP W Iv)) (V1 n W f) (V2 k W f i') ;

    c12n : (n : Nat) -> C12 n = split {
      zero -> \ k W f i i' ->
        transH (uF-unif W X (pXf W X f) x bn (refl (en s X x)) (symH (enNat s W X (pXf W X f) x)))
         (transH (uF-cong W (D.act W X (pXf W X f) x) (nuP k W f i').x' (symH (apH (\ z -> z.1) ((p.ps k).ppt W (pXf W X f) (gOf k W f i'))))
                    (ES.act W X (pXf W X f) bn) (nuP k W f i').bS (symH (enNat s W X (pXf W X f) x)) (nuP k W f i').bpt
                    (bnew-side X w p k W (pXf W X f) (gOf k W f i')))
          (transH (symH (omF-lid W (nuP k W f i')))
                  (TS.PE.actEq (prodP W Iv) (prodP (prodP W Iv) Iv) (lid (prodP W Iv) e0) (mF X W f) (hom-eq (prodP W Iv) (prodP (prodP W Iv) Iv) (lid (prodP W Iv) e0) (mF X W f) (pw-sym (prodP W Iv) (prodP (prodP W Iv) Iv) (mF X W f) (lid (prodP W Iv) e0) (mF-lid X W e0 f i))) (omF W (nuP k W f i'))))) ;
      suc n -> \ k W f i i' ->
        transH (FEb-side X w p k W (pXf W X f) (gOf k W f i'))
         (transH (omA-def W (nuP k W f i'))
                 (TS.PE.actEq (prodP W Iv) (prodP (prodP W Iv) Iv) (lid (prodP W Iv) e1) (mF X W f) (hom-eq (prodP W Iv) (prodP (prodP W Iv) Iv) (lid (prodP W Iv) e1) (mF X W f) (pw-sym (prodP W Iv) (prodP (prodP W Iv) Iv) (mF X W f) (lid (prodP W Iv) e1) (mF-lid X W e1 f i))) (omF W (nuP k W f i')))) } ;

    opaque lnP ; opaque V1-pt ; opaque V1-nat ; opaque V1-lid ; opaque V2-pt ; opaque V2-nat ; opaque V2-lid ; opaque c12n ;

    LDp : LBs.LData[prodP X Iv, rhoP, p.pr, suc (suc zero)] = new LBs.LData[prodP X Iv, rhoP, p.pr, suc (suc zero), lwP, lwptP, F2, F1,
      \ k k' W f i i' -> apH (\ v -> ES.act (prodP W Iv) (prodP (prodP W Iv) Iv) (mF X W f) (omF W (fdOf W v)))
                             (p.pcs k k' W (pXf W X f) (gOf k W f i) (gOf k' W f i')),
      \ k k' W f i i' -> symH (c12n k'.1 k W f i' i),
      \ k k' W f i i' -> c11n k.1 k'.1 W f i i'] ;
  } ;

  FEp (X : Ob) (w : SEt.TD.EI X) (p : PX.Partial[X, w]) : TS.EI (prodP (prodP X Iv) Iv) =
    LBs.FE (prodP X Iv) PP[X, w, p].rhoP p.pr (suc (suc zero)) PP[X, w, p].LDp ;

  pnewS (X : Ob) (w : SEt.TD.EI X) (p : PX.Partial[X, w]) : TS.EI (prodP X Iv) =
    ES.act (prodP X Iv) (prodP (prodP X Iv) Iv) (lid (prodP X Iv) t) (FEp X w p) ;
} ;
