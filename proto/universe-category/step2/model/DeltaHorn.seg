-- DeltaHorn.seg: horns on Delta and horn filling (cours6, "Definition des
-- types fibrants" (1); survey-slides 10).
--
--   faceS m y      the decidable sieve on [m+1] of the maps missing y
--   hornS m k      the horn Lambda^{m+1}_k: the maps missing some y /= k
--                  (one decidable sieve, DeltaBase.DS)
-- (horn filling itself, DH: isFib, is DHornFib.seg, at any level)
--
-- Constructive: no classical principle is used in this file.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Axioms[a+].FunExtLemmas[fe @(a+)] ;
module W0 = V[a] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open Constr[a] ;
open Simp[a] ;
open DeltaNat[a] ;
module DBm = DeltaBase[a] ;
module DB = DBm.DB ;
module DS = DBm.DS ;

------------------------------------------------------------------------
-- faces and horns

-- the vertices of [m+1] other than y
missQ (m y : Nat) : Subset (lin (suc m)) = \ t -> not (eqN (vnum t.1) y) ;

-- the maps missing y (on the poset side this is Simp.Miss, by definition)
faceS (m y : Nat) : DS.Phi (suc m) = DBm.subS (suc m) (lin (suc m)) (idH (lin (suc m))) (missQ m y) ;

face-miss (V m y : Nat) (g : Hom (lin V) (lin (suc m))) (i : DS.Lands V (suc m) (faceS m y) g) : Miss (lin V) m y g =
  PosB.lands-eq (lin V) (lin (suc m)) (missQ m y) (compH (lin V) (lin (suc m)) (lin (suc m)) (idH (lin (suc m))) g) g
    (comp-idl (lin V) (lin (suc m)) g)
    (DBm.isIn-sound V (lin (suc m)) (compH (lin V) (lin (suc m)) (lin (suc m)) (idH (lin (suc m))) g) (missQ m y) i) ;

miss-face (V m y : Nat) (g : Hom (lin V) (lin (suc m))) (ms : Miss (lin V) m y g) : DS.Lands V (suc m) (faceS m y) g =
  DBm.isIn-complete V (lin (suc m)) (compH (lin V) (lin (suc m)) (lin (suc m)) (idH (lin (suc m))) g) (missQ m y)
    (PosB.lands-eq (lin V) (lin (suc m)) (missQ m y) g (compH (lin V) (lin (suc m)) (lin (suc m)) (idH (lin (suc m))) g)
       (symH (comp-idl (lin V) (lin (suc m)) g)) ms) ;

-- the face y counts for the horn at k when y /= k
hfB (m k : Nat) (V : Nat) (g : Hom (lin V) (lin (suc m))) (y : Nat) : Bool = and (not (eqN y k)) ((faceS m y).1 V g) ;

hornS (m k : Nat) : DS.Phi (suc m) =
  (\ V g -> existsUp (suc m) (hfB m k V g),
   \ V' V g h i ->
     ex-i (suc m) (hfB m k V' (compH (lin V') (lin V) (lin (suc m)) g h)) (ex-e (suc m) (hfB m k V g) i).1
       (ex-e (suc m) (hfB m k V g) i).2.1
       (and-i (not (eqN (ex-e (suc m) (hfB m k V g) i).1 k))
              ((faceS m (ex-e (suc m) (hfB m k V g) i).1).1 V' (compH (lin V') (lin V) (lin (suc m)) g h))
          (and-l (not (eqN (ex-e (suc m) (hfB m k V g) i).1 k)) ((faceS m (ex-e (suc m) (hfB m k V g) i).1).1 V g)
             (ex-e (suc m) (hfB m k V g) i).2.2)
          ((faceS m (ex-e (suc m) (hfB m k V g) i).1).2 V' V g h
             (and-r (not (eqN (ex-e (suc m) (hfB m k V g) i).1 k)) ((faceS m (ex-e (suc m) (hfB m k V g) i).1).1 V g)
                (ex-e (suc m) (hfB m k V g) i).2.2)))) ;

-- a map missing a face y /= k lands in the horn
lands-horn (V m k y : Nat) (hy : IsT (leb y (suc m))) (ky : IsT (not (eqN y k)))
  (g : Hom (lin V) (lin (suc m))) (ms : Miss (lin V) m y g) : DS.Lands V (suc m) (hornS m k) g =
  ex-i (suc m) (hfB m k V g) y hy (and-i (not (eqN y k)) ((faceS m y).1 V g) ky (miss-face V m y g ms)) ;

-- a map in the horn misses a face y /= k
HornWit (V m k : Nat) (g : Hom (lin V) (lin (suc m))) : U a =
  (y : Nat) * (IsT (leb y (suc m)) * (IsT (not (eqN y k)) * Miss (lin V) m y g)) ;

horn-lands (V m k : Nat) (g : Hom (lin V) (lin (suc m))) (i : DS.Lands V (suc m) (hornS m k) g) : HornWit V m k g =
  ((ex-e (suc m) (hfB m k V g) i).1,
   ((ex-e (suc m) (hfB m k V g) i).2.1,
    (and-l (not (eqN (ex-e (suc m) (hfB m k V g) i).1 k)) ((faceS m (ex-e (suc m) (hfB m k V g) i).1).1 V g)
       (ex-e (suc m) (hfB m k V g) i).2.2,
     face-miss V m (ex-e (suc m) (hfB m k V g) i).1 g
       (and-r (not (eqN (ex-e (suc m) (hfB m k V g) i).1 k)) ((faceS m (ex-e (suc m) (hfB m k V g) i).1).1 V g)
          (ex-e (suc m) (hfB m k V g) i).2.2)))) ;

opaque hornS ;
