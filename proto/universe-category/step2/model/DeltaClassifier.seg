-- DeltaClassifier.seg: the fibrancy classifier of Delta for the universe
-- (GUniv.Univ; cours6, "Univers et definition des types fibrants"):
--
--   ClD G A     C(A) = the horn filling operation isFib (DeltaHorn.DH)
--   clSub       along a substitution s : D -> G: a horn problem for A[s]
--               at rho is moved to one for A at s rho (liftP), filled, and
--               the filler read back (liftInj)
--   clSub-id / clSub-o   the laws, in Sigma A. ClD G A, by isFibExt
--   encClD      its code one level up
--   DU          GUniv.Univ at this classifier: the universe of Delta
--
-- Constructive.  (El of DU is fibrant through Classical.DeltaFibIff,
-- which uses lem; not here.)

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Axioms[a+].FunExtLemmas[fe @(a+)] ;
module W0 = V[a] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open Constr[a] ;
module DBm = DeltaBase[a] ;
module DB = DBm.DB ;
module DS = DBm.DS ;
module DHm = DeltaHorn[a] ;
module PS = DB.GPre[a].PS ;

ClD (G : PS.PCtx) (A : PS.PTy[G]) : U a+ = DHornFib[a, a].DH[G, A].isFib ;

------------------------------------------------------------------------
-- substitution

module Sub (D G : PS.PCtx) (s : PS.PSub[D, G]) (A : PS.PTy[G]) (c : ClD G A) {
  module HD = DHornFib[a, a].DH[D, PS.subTy D G A s] ;
  module HG = DHornFib[a, a].DH[G, A] ;
  module TD = DB.GPre[a].TyL[D, PS.subTy D G A s] ;
  module TG = DB.GPre[a].TyL[G, A] ;

  L : PS.PSub[PS.extP D (PS.subTy D G A s), PS.extP G A] = PS.liftP D G A s ;

  -- an element of A[s] is determined by its point and its image
  liftInj (W : Nat) (w w' : TD.EI W) (p : Id (W0.Ix (D.ob W)) w.1 w'.1) (q : Id (TG.EI W) (L.nt W w) (L.nt W w')) : Id (TD.EI W) w w' =
    idJ (W0.Ix (D.ob W)) w.1
      (\ d P -> (a2 : W0.Ix (A.tob W (s.nt W d))) -> Id (TG.EI W) (L.nt W w) (s.nt W d, a2) -> Id (TD.EI W) w (d, a2))
      (\ a2 Q -> apH {W0.Ix (A.tob W (s.nt W w.1))} {TD.EI W} (\ z -> (w.1, z)) (TG.pr-inj W (s.nt W w.1) w.2 a2 Q))
      w'.1 p w'.2 q ;

  -- horn data moved along s
  mv (m k : Nat) (rho : W0.Ix (D.ob (suc m))) (h : HD.HornData m k rho) : HG.HornData m k (s.nt (suc m) rho) =
    (\ W f i -> L.nt W (h.1 W f i),
     (\ W f i -> transH (apH (s.nt W) (h.2.1 W f i)) (s.nt-nat W (suc m) f rho),
      \ W' W chi f i i' -> transH (symH (L.nt-nat W' W chi (h.1 W f i))) (apH (L.nt W') (h.2.2 W' W chi f i i')))) ;

  module E1 (m k : Nat) (hk : IsT (leb k (suc m))) (rho : W0.Ix (D.ob (suc m))) (h : HD.HornData m k rho) {
    ex : HG.Ext m k (s.nt (suc m) rho) (mv m k rho h) = c m k hk (s.nt (suc m) rho) (mv m k rho h) ;

    cond (W : Nat) (f : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (DHm.hornS m k) f)
      : Id (TD.EI W) (TD.E.act W (suc m) f (rho, ex.1)) (h.1 W f i) =
      liftInj W (TD.E.act W (suc m) f (rho, ex.1)) (h.1 W f i) (symH (h.2.1 W f i))
        (transH (L.nt-nat W (suc m) f (rho, ex.1)) (ex.2 W f i)) ;

    res : HD.Ext m k rho h = (ex.1, cond) ;
  } ;

  cl : ClD D (PS.subTy D G A s) = \ m k hk rho h -> E1[m, k, hk, rho, h].res ;
} ;

clSubD (D G : PS.PCtx) (s : PS.PSub[D, G]) (A : PS.PTy[G]) (c : ClD G A) : ClD D (PS.subTy D G A s) = Sub[D, G, s, A, c].cl ;

------------------------------------------------------------------------
-- extensionality: same objects part, pointwise equal actions, and the
-- same fillers on the same horn data

module FExt (G : PS.PCtx) (A : PS.PTy[G]) {
  module PP = DB.GCofib[a].Partials[G, A] ;
  module TA = DB.GPre[a].TyL[G, A] ;

  Pack : U a = (h : PS.TactTy G A.tob) * (PS.IdLaw G A.tob h * PS.OLaw G A.tob h) ;

  packOf : Pack = (A.tact, (A.tact-id, A.tact-o)) ;

  B (q : Pack) : PS.PTy[G] = PS.mkTy G A.tob q.1 q.2.1 q.2.2 ;

  -- the fillers agree on the same horn data (the naturality proofs are
  -- taken in each type)
  Agree (q : Pack) (c : ClD G A) (c' : ClD G (B q)) : U a =
    (m k : Nat) (hk : IsT (leb k (suc m))) (rho : W0.Ix (G.ob (suc m)))
    (v : PP.PvTy (suc m) (DHm.hornS m k)) (pp : PP.PptTy (suc m) rho (DHm.hornS m k) v)
    (pnA : PP.PnTy (suc m) (DHm.hornS m k) v) (pnB : DB.GCofib[a].Partials[G, B q].PnTy (suc m) (DHm.hornS m k) v)
    -> Id (W0.Ix (A.tob (suc m) rho)) (c m k hk rho (v, (pp, pnA))).1 (c' m k hk rho (v, (pp, pnB))).1 ;

  -- the side condition of an extension is a proposition
  isProp-cond (m k : Nat) (rho : W0.Ix (G.ob (suc m))) (h : DHornFib[a, a].DH[G, A].HornData m k rho) (a0 : W0.Ix (A.tob (suc m) rho))
    : isProp ((W : Nat) (f : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (DHm.hornS m k) f)
              -> Id (TA.EI W) (TA.E.act W (suc m) f (rho, a0)) (h.1 W f i)) =
    isProp-Pi Nat (\ W -> (f : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (DHm.hornS m k) f)
                          -> Id (TA.EI W) (TA.E.act W (suc m) f (rho, a0)) (h.1 W f i)) (\ W ->
    isProp-Pi (Hom (lin W) (lin (suc m))) (\ f -> (i : DS.Lands W (suc m) (DHm.hornS m k) f)
                          -> Id (TA.EI W) (TA.E.act W (suc m) f (rho, a0)) (h.1 W f i)) (\ f ->
    isProp-Pi (DS.Lands W (suc m) (DHm.hornS m k) f) (\ i -> Id (TA.EI W) (TA.E.act W (suc m) f (rho, a0)) (h.1 W f i)) (\ i ->
      W0.isSetIx (TA.E.ob W) (TA.E.act W (suc m) f (rho, a0)) (h.1 W f i)))) ;

  base (c c' : ClD G A) (H : Agree packOf c c') : Id ((A' : PS.PTy[G]) * ClD G A') (A, c) (A, c') =
    apH {ClD G A} {(A' : PS.PTy[G]) * ClD G A'} (\ z -> (A, z))
      (funext Nat (\ m -> (k : Nat) -> IsT (leb k (suc m)) -> (rho : W0.Ix (G.ob (suc m))) -> (h : DHornFib[a, a].DH[G, A].HornData m k rho) -> DHornFib[a, a].DH[G, A].Ext m k rho h) c c' (\ m ->
       funext Nat (\ k -> IsT (leb k (suc m)) -> (rho : W0.Ix (G.ob (suc m))) -> (h : DHornFib[a, a].DH[G, A].HornData m k rho) -> DHornFib[a, a].DH[G, A].Ext m k rho h) (c m) (c' m) (\ k ->
       funext (IsT (leb k (suc m))) (\ hk -> (rho : W0.Ix (G.ob (suc m))) -> (h : DHornFib[a, a].DH[G, A].HornData m k rho) -> DHornFib[a, a].DH[G, A].Ext m k rho h) (c m k) (c' m k) (\ hk ->
       funext (W0.Ix (G.ob (suc m))) (\ rho -> (h : DHornFib[a, a].DH[G, A].HornData m k rho) -> DHornFib[a, a].DH[G, A].Ext m k rho h) (c m k hk) (c' m k hk) (\ rho ->
       funext (DHornFib[a, a].DH[G, A].HornData m k rho) (\ h -> DHornFib[a, a].DH[G, A].Ext m k rho h) (c m k hk rho) (c' m k hk rho) (\ h ->
         Sigma-eq (W0.Ix (A.tob (suc m) rho))
           (\ a0 -> (W : Nat) (f : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (DHm.hornS m k) f)
                    -> Id (TA.EI W) (TA.E.act W (suc m) f (rho, a0)) (h.1 W f i))
           (c m k hk rho h).1 (c' m k hk rho h).1 (c m k hk rho h).2 (c' m k hk rho h).2
           (H m k hk rho h.1 h.2.1 h.2.2 h.2.2) (isProp-cond m k rho h (c' m k hk rho h).1))))))) ;

  core (c : ClD G A) (q : Pack) (Q : Id Pack packOf q) (c' : ClD G (B q)) (H : Agree q c c')
    : Id ((A' : PS.PTy[G]) * ClD G A') (A, c) (B q, c') =
    idJ Pack packOf (\ q2 Q2 -> (c2 : ClD G (B q2)) -> Agree q2 c c2 -> Id ((A' : PS.PTy[G]) * ClD G A') (A, c) (B q2, c2))
      (base c) q Q c' H ;

  isFibExt (c : ClD G A) (q : Pack) (Ht : PS.PtEq G A.tob A.tact q.1) (c' : ClD G (B q)) (H : Agree q c c')
    : Id ((A' : PS.PTy[G]) * ClD G A') (A, c) (B q, c') =
    core c q
      (Sigma-eq (PS.TactTy G A.tob) (\ h -> PS.IdLaw G A.tob h * PS.OLaw G A.tob h) A.tact q.1 (A.tact-id, A.tact-o) q.2
         (PS.tact-funext G A.tob A.tact q.1 Ht)
         (isProp-Sigma (PS.IdLaw G A.tob q.1) (\ z -> PS.OLaw G A.tob q.1) (PS.idLaw-prop G A.tob q.1) (\ z -> PS.oLaw-prop G A.tob q.1)))
      c' H ;

  -- horn data with the same values are equal
  hd-eq (m k : Nat) (rho : W0.Ix (G.ob (suc m))) (h h' : DHornFib[a, a].DH[G, A].HornData m k rho) (P : Id (PP.PvTy (suc m) (DHm.hornS m k)) h.1 h'.1)
    : Id (DHornFib[a, a].DH[G, A].HornData m k rho) h h' =
    Sigma-eq (PP.PvTy (suc m) (DHm.hornS m k))
      (\ v -> PP.PptTy (suc m) rho (DHm.hornS m k) v * PP.PnTy (suc m) (DHm.hornS m k) v) h.1 h'.1 h.2 h'.2 P
      (isProp-Sigma (PP.PptTy (suc m) rho (DHm.hornS m k) h'.1) (\ z -> PP.PnTy (suc m) (DHm.hornS m k) h'.1)
         (PP.isProp-Ppt (suc m) rho (DHm.hornS m k) h'.1) (\ z -> PP.isProp-Pn (suc m) (DHm.hornS m k) h'.1)) ;
} ;

------------------------------------------------------------------------
-- the laws

clSub-idD (G : PS.PCtx) (A : PS.PTy[G]) (c : ClD G A)
  : Id ((A' : PS.PTy[G]) * ClD G A') (A, c) (PS.subTy G G A (PS.idS G), clSubD G G (PS.idS G) A c) =
  FExt[G, A].isFibExt c ((PS.subTy G G A (PS.idS G)).tact, ((PS.subTy G G A (PS.idS G)).tact-id, (PS.subTy G G A (PS.idS G)).tact-o))
    (\ J I f x y e a -> PS.tact-irr G A J I f x y e (PS.ntEq G G (PS.idS G) J I f x y e) a)
    (clSubD G G (PS.idS G) A c)
    (\ m k hk rho v pp pnA pnB ->
       apH {DHornFib[a, a].DH[G, A].HornData m k rho} {W0.Ix (A.tob (suc m) rho)} (\ hd -> (c m k hk rho hd).1)
         (FExt[G, A].hd-eq m k rho (v, (pp, pnA)) (Sub[G, G, PS.idS G, A, c].mv m k rho (v, (pp, pnB))) (refl v))) ;

clSub-oD (T D G : PS.PCtx) (s : PS.PSub[D, G]) (s' : PS.PSub[T, D]) (A : PS.PTy[G]) (c : ClD G A)
  : Id ((A' : PS.PTy[T]) * ClD T A') (PS.subTy T G A (PS.oS T D G s s'), clSubD T G (PS.oS T D G s s') A c)
                                     (PS.subTy T D (PS.subTy D G A s) s', clSubD T D s' (PS.subTy D G A s) (clSubD D G s A c)) =
  FExt[T, PS.subTy T G A (PS.oS T D G s s')].isFibExt (clSubD T G (PS.oS T D G s s') A c)
    ((PS.subTy T D (PS.subTy D G A s) s').tact, ((PS.subTy T D (PS.subTy D G A s) s').tact-id, (PS.subTy T D (PS.subTy D G A s) s').tact-o))
    (\ J I f x y e a -> PS.tact-irr G A J I f (s.nt I (s'.nt I x)) (s.nt J (s'.nt J y)) _ _ a)
    (clSubD T D s' (PS.subTy D G A s) (clSubD D G s A c))
    (\ m k hk rho v pp pnA pnB ->
       apH {DHornFib[a, a].DH[G, A].HornData m k (s.nt (suc m) (s'.nt (suc m) rho))} {W0.Ix (A.tob (suc m) (s.nt (suc m) (s'.nt (suc m) rho)))}
         (\ hd -> (c m k hk (s.nt (suc m) (s'.nt (suc m) rho)) hd).1)
         (FExt[G, A].hd-eq m k (s.nt (suc m) (s'.nt (suc m) rho))
            (Sub[T, G, PS.oS T D G s s', A, c].mv m k rho (v, (pp, pnA)))
            (Sub[D, G, s, A, c].mv m k (s'.nt (suc m) rho) (Sub[T, D, s', PS.subTy D G A s, clSubD D G s A c].mv m k rho (v, (pp, pnB))))
            (refl (\ W f i -> (s.nt W (s'.nt W (v W f i).1), (v W f i).2))))) ;

------------------------------------------------------------------------
-- the code one level up: a horn filling operation is a function of
-- (m , k , rho , horn data), a horn datum is its values (the rest is
-- propositional), an extension is its filler (the rest is propositional)

module EN = Encode[a, a+] ;

module EncD (G : PS.PCtx) (A : PS.PTy[G]) {
  module EP = DB.GUnivL.EncP[G, A] ;
  module FX = FExt[G, A] ;
  module H = DHornFib[a, a].DH[G, A] ;

  encHD (m k : Nat) (rho : W0.Ix (G.ob (suc m))) : EN.Enc (H.HornData m k rho) =
    EN.encSig (FX.PP.PvTy (suc m) (DHm.hornS m k))
      (\ v -> FX.PP.PptTy (suc m) rho (DHm.hornS m k) v * FX.PP.PnTy (suc m) (DHm.hornS m k) v)
      (EP.encPv (suc m) (DHm.hornS m k))
      (\ v -> EN.encProp (FX.PP.PptTy (suc m) rho (DHm.hornS m k) v * FX.PP.PnTy (suc m) (DHm.hornS m k) v)
                (isProp-Sigma (FX.PP.PptTy (suc m) rho (DHm.hornS m k) v) (\ z -> FX.PP.PnTy (suc m) (DHm.hornS m k) v)
                   (FX.PP.isProp-Ppt (suc m) rho (DHm.hornS m k) v) (\ z -> FX.PP.isProp-Pn (suc m) (DHm.hornS m k) v))) ;

  encExt (m k : Nat) (rho : W0.Ix (G.ob (suc m))) (h : H.HornData m k rho) : EN.Enc (H.Ext m k rho h) =
    EN.encSig (W0.Ix (A.tob (suc m) rho))
      (\ a0 -> (W : Nat) (f : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (DHm.hornS m k) f)
               -> Id (FX.TA.EI W) (FX.TA.E.act W (suc m) f (rho, a0)) (h.1 W f i))
      (EN.encIx0 (A.tob (suc m) rho))
      (\ a0 -> EN.encProp ((W : Nat) (f : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (DHm.hornS m k) f)
                           -> Id (FX.TA.EI W) (FX.TA.E.act W (suc m) f (rho, a0)) (h.1 W f i))
                 (FX.isProp-cond m k rho h a0)) ;

  enc : EN.Enc (ClD G A) =
    EN.encPi0 Nat (\ m -> (k : Nat) -> IsT (leb k (suc m)) -> (rho : W0.Ix (G.ob (suc m))) -> (h : H.HornData m k rho) -> H.Ext m k rho h)
      DB.GUnivL.encNat (\ m ->
    EN.encPi0 Nat (\ k -> IsT (leb k (suc m)) -> (rho : W0.Ix (G.ob (suc m))) -> (h : H.HornData m k rho) -> H.Ext m k rho h)
      DB.GUnivL.encNat (\ k ->
    EN.encPi0 (IsT (leb k (suc m))) (\ hk -> (rho : W0.Ix (G.ob (suc m))) -> (h : H.HornData m k rho) -> H.Ext m k rho h)
      (EN.encProp (IsT (leb k (suc m))) (isProp-IsT' (leb k (suc m)))) (\ hk ->
    EN.encPi0 (W0.Ix (G.ob (suc m))) (\ rho -> (h : H.HornData m k rho) -> H.Ext m k rho h)
      (EN.encIx0 (G.ob (suc m))) (\ rho ->
    EN.encPi0 (H.HornData m k rho) (\ h -> H.Ext m k rho h) (encHD m k rho) (\ h -> encExt m k rho h))))) ;
} ;

encClD (G : PS.PCtx) (A : PS.PTy[G]) : EN.Enc (ClD G A) = EncD[G, A].enc ;

opaque encClD ;

------------------------------------------------------------------------
-- the universe of Delta

module DU = DB.GUniv.Univ[ClD, clSubD, clSub-idD, clSub-oD, \ X A -> encClD (DB.GYon[a].yP X) A] ;
