-- DeltaForall.seg: forall of a UNION of lines on Delta (the instance of
-- IvBase.FaU for simplicial sets).
--
-- The prism [m] * Delta[1] is not representable; it is the union of its
-- m + 1 shuffles P_k : [m+1] -> [m] * [1] (Simp.pmap).  Every simplex
-- (g , j) : [p] -> [m] * [1] factors through one of them (Fact: k is the
-- largest g i with j i = 0, h i = g i or g i + 1), so IvBase.PrismCov
-- decides "covered by the union" on the shuffles (DCov).  Since the sieves
-- of Delta are decidable sieves (DeltaBase), forall of a list of lines over
-- [n] is ONE sieve: f is in it iff at every shuffle of [W] * [1] some line
-- holds (testB, forallS); FaU's list has one element.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open Constr[a] ;
open Simp[a] ;
open DeltaNat[a] ;
module DBm = DeltaBase[a] ;
module DB = DBm.DB ;

------------------------------------------------------------------------
-- points of [n], read as numbers

leafElim (n : Nat) (P : El (lin n) -> U a) (k : (i : Nat) (h : IsT (leb i n)) -> P (leaf i, h)) (s : El (lin n)) : P s = aux s.1 s.2
 where { aux : (t : Tree) (h : IsT (car (lin n) t)) -> P (t, h) = split {
           leaf i -> \ h -> k i h ;
           node c d -> \ h -> absurd (P (node c d, h)) (false-true h) } ; } ;

valP (p n : Nat) (f : Hom (lin p) (lin n)) (i : Nat) (hi : IsT (leb i p)) : Nat = vnum (app (lin p) (lin n) f (leaf i, hi)).1 ;

valP-tree (p n : Nat) (f : Hom (lin p) (lin n)) (i : Nat) (hi : IsT (leb i p))
  : Id Tree (app (lin p) (lin n) f (leaf i, hi)).1 (leaf (valP p n f i hi)) =
  lin-leaf n (app (lin p) (lin n) f (leaf i, hi)).1 (app (lin p) (lin n) f (leaf i, hi)).2 ;

valP-range (p n : Nat) (f : Hom (lin p) (lin n)) (i : Nat) (hi : IsT (leb i p)) : IsT (leb (valP p n f i hi) n) =
  vnum-range n (app (lin p) (lin n) f (leaf i, hi)).1 (app (lin p) (lin n) f (leaf i, hi)).2 ;

valP-eq (p n : Nat) (f : Hom (lin p) (lin n)) (i i' : Nat) (e : Id Nat i i') (hi : IsT (leb i p)) (hi' : IsT (leb i' p))
  : Id Nat (valP p n f i hi) (valP p n f i' hi') =
  apH (\ s -> vnum (app (lin p) (lin n) f s).1) (el-eq (lin p) (leaf i, hi) (leaf i', hi') (lf i i' e)) ;

valP-mono (p n : Nat) (f : Hom (lin p) (lin n)) (i i' : Nat) (hi : IsT (leb i p)) (hi' : IsT (leb i' p)) (l : IsT (leb i i'))
  : IsT (leb (valP p n f i hi) (valP p n f i' hi')) =
  substH (\ t -> IsT (le (lin n) t (leaf (valP p n f i' hi')))) (valP-tree p n f i hi)
    (substH (\ t -> IsT (le (lin n) (app (lin p) (lin n) f (leaf i, hi)).1 t)) (valP-tree p n f i' hi')
       (mono (lin p) (lin n) f (leaf i, hi) (leaf i', hi') l)) ;

-- i clamped to [0 , n] (monotone)
clampN (n i : Nat) : Nat = ifB (leb i n) i n ;

clampOk (n i : Nat) : (c : Bool) -> Id Bool (leb i n) c -> IsT (leb (ifB c i n) n) = split {
  true -> \ e -> e ;
  false -> \ e -> leb-refl n } ;

clamp-ok (n i : Nat) : IsT (leb (clampN n i) n) = clampOk n i (leb i n) (refl (leb i n)) ;

clamp-eq (n i : Nat) (hi : IsT (leb i n)) : Id Nat (clampN n i) i = ifB-t (leb i n) i n hi ;

clampMono (n i i' : Nat) (l : IsT (leb i i')) : (c c' : Bool) -> Id Bool (leb i n) c -> Id Bool (leb i' n) c'
  -> IsT (leb (ifB c i n) (ifB c' i' n)) = split {
  true -> split { true -> \ e e' -> l ; false -> \ e e' -> e } ;
  false -> split {
    true -> \ e e' -> tf-absurd (IsT (leb n i')) (leb i n) (leb-trans i i' n l e') e ;
    false -> \ e e' -> leb-refl n } } ;

clamp-mono (n i i' : Nat) (l : IsT (leb i i')) : IsT (leb (clampN n i) (clampN n i')) =
  clampMono n i i' l (leb i n) (leb i' n) (refl (leb i n)) (refl (leb i' n)) ;

-- the values of a map, as a total monotone function
valT (p n : Nat) (f : Hom (lin p) (lin n)) (i : Nat) : Nat = valP p n f (clampN p i) (clamp-ok p i) ;

valT-eq (p n : Nat) (f : Hom (lin p) (lin n)) (i : Nat) (hi : IsT (leb i p)) : Id Nat (valT p n f i) (valP p n f i hi) =
  valP-eq p n f (clampN p i) i (clamp-eq p i hi) (clamp-ok p i) hi ;

valT-mono (p n : Nat) (f : Hom (lin p) (lin n)) (i i' : Nat) (l : IsT (leb i i')) : IsT (leb (valT p n f i) (valT p n f i')) =
  valP-mono p n f (clampN p i) (clampN p i') (clamp-ok p i) (clamp-ok p i') (clamp-mono p i i' l) ;

valT-range (p n : Nat) (f : Hom (lin p) (lin n)) (i : Nat) : IsT (leb (valT p n f i) n) =
  valP-range p n f (clampN p i) (clamp-ok p i) ;

valT-tree (p n : Nat) (f : Hom (lin p) (lin n)) (i : Nat) (hi : IsT (leb i p))
  : Id Tree (app (lin p) (lin n) f (leaf i, hi)).1 (leaf (valT p n f i)) =
  transH (valP-tree p n f i hi) (lf (valP p n f i hi) (valT p n f i) (symH (valT-eq p n f i hi))) ;

-- a value <= 1 that is not 0 is 1
one-of : (x : Nat) -> IsT (leb x (suc zero)) -> Id Bool (eqN x zero) false -> Id Nat x (suc zero) = split {
  zero -> \ h e -> absurd (Id Nat zero (suc zero)) (false-true (symH e)) ;
  suc x -> \ h e -> apH (\ y -> suc y) (leb-zero x h) } ;

------------------------------------------------------------------------
-- the shuffles of [m] * [1]

gkD (m k : Nat) : Hom (lin (suc m)) (lin m) = linH (suc m) m (pc m k) (\ i h -> pc-range m k i h) (pc-mono m k) ;
jkD (m k : Nat) : Hom (lin (suc m)) Iv = linH (suc m) (suc zero) (pl m k) (\ i h -> pl-range m k i) (pl-mono m k) ;

-- every simplex (g , j) : [V] -> [m] * [1] factors through a shuffle
module Fact (m V : Nat) (g : Hom (lin V) (lin m)) (j : Hom (lin V) Iv) {
  gn (i : Nat) : Nat = valT V m g i ;
  jn (i : Nat) : Nat = valT V (suc zero) j i ;

  z (i : Nat) : Nat = ifB (eqN (jn i) zero) (gn i) zero ;

  kk : Nat = maxUp V z ;

  zle (x : Nat) (hx : IsT (leb x m)) : (c : Bool) -> IsT (leb (ifB c x zero) m) = split { true -> hx ; false -> refl true } ;

  kk-le : IsT (leb kk m) = maxUp-le V z m (\ i hi -> zle (gn i) (valT-range V m g i) (eqN (jn i) zero)) ;

  hfN (i : Nat) : Nat = ifB (eqN (jn i) zero) (gn i) (suc (gn i)) ;

  hr (x : Nat) (hx : IsT (leb x m)) : (c : Bool) -> IsT (leb (ifB c x (suc x)) (suc m)) = split {
    true -> leb-step x m hx ;
    false -> hx } ;

  hmono (i i' : Nat) (l : IsT (leb i i')) : (c c' : Bool) -> Id Bool (eqN (jn i) zero) c -> Id Bool (eqN (jn i') zero) c'
    -> IsT (leb (ifB c (gn i) (suc (gn i))) (ifB c' (gn i') (suc (gn i')))) = split {
    true -> split {
      true -> \ e e' -> valT-mono V m g i i' l ;
      false -> \ e e' -> leb-step (gn i) (gn i') (valT-mono V m g i i' l) } ;
    false -> split {
      true -> \ e e' -> tf-absurd (IsT (leb (suc (gn i)) (gn i'))) (eqN (jn i) zero)
                         (substH (\ y -> IsT (eqN y zero)) (symH (leb-zero (jn i)
                            (substH (\ y -> IsT (leb (jn i) y)) (eqN-sound (jn i') zero e') (valT-mono V (suc zero) j i i' l))))
                            (refl true)) e ;
      false -> \ e e' -> valT-mono V m g i i' l } } ;

  h : Hom (lin V) (lin (suc m)) =
    linH V (suc m) hfN (\ i hi -> hr (gn i) (valT-range V m g i) (eqN (jn i) zero))
      (\ i i' l -> hmono i i' l (eqN (jn i) zero) (eqN (jn i') zero) (refl (eqN (jn i) zero)) (refl (eqN (jn i') zero))) ;

  -- for j i = 1: kk <= g i (the points with j = 0 come before i)
  kk-low (i : Nat) (e : Id Bool (eqN (jn i) zero) false) : IsT (leb kk (gn i)) =
    maxUp-le V z (gn i) (\ i' hi' ->
      bcase (IsT (leb (z i') (gn i))) (eqN (jn i') zero)
        (\ t -> substH (\ y -> IsT (leb y (gn i))) (symH (ifB-t (eqN (jn i') zero) (gn i') zero t))
                  (ltb-dec (IsT (leb (gn i') (gn i))) i' i
                     (\ lt -> valT-mono V m g i' i (ltb-leb i' i lt))
                     (\ ge -> tf-absurd (IsT (leb (gn i') (gn i))) (eqN (jn i) zero)
                                (substH (\ y -> IsT (eqN y zero)) (symH (leb-zero (jn i)
                                   (substH (\ y -> IsT (leb (jn i) y)) (eqN-sound (jn i') zero t) (valT-mono V (suc zero) j i i' ge))))
                                   (refl true)) e)))
        (\ f -> substH (\ y -> IsT (leb y (gn i))) (symH (ifB-f (eqN (jn i') zero) (gn i') zero f)) (refl true))) ;

  pc-eq (i : Nat) (hi : IsT (leb i V)) : Id Nat (pc m kk (hfN i)) (gn i) =
    bcase (Id Nat (pc m kk (hfN i)) (gn i)) (eqN (jn i) zero)
      (\ t -> transH (apH (pc m kk) (ifB-t (eqN (jn i) zero) (gn i) (suc (gn i)) t))
                (pc-low kk m (gn i)
                   (substH (\ y -> IsT (leb y kk)) (ifB-t (eqN (jn i) zero) (gn i) zero t) (le-maxUp V z i hi))
                   (valT-range V m g i)))
      (\ f -> transH (apH (pc m kk) (ifB-f (eqN (jn i) zero) (gn i) (suc (gn i)) f))
                (pc-high kk m (gn i) (kk-low i f) (valT-range V m g i))) ;

  pl-eq (i : Nat) (hi : IsT (leb i V)) : Id Nat (pl m kk (hfN i)) (jn i) =
    bcase (Id Nat (pl m kk (hfN i)) (jn i)) (eqN (jn i) zero)
      (\ t -> transH (apH (pl m kk) (ifB-t (eqN (jn i) zero) (gn i) (suc (gn i)) t))
                (transH (pl-low kk m (gn i)
                           (substH (\ y -> IsT (leb y kk)) (ifB-t (eqN (jn i) zero) (gn i) zero t) (le-maxUp V z i hi))
                           (valT-range V m g i))
                        (symH (eqN-sound (jn i) zero t))))
      (\ f -> transH (apH (pl m kk) (ifB-f (eqN (jn i) zero) (gn i) (suc (gn i)) f))
                (transH (pl-high kk m (gn i) (kk-low i f) (valT-range V m g i))
                        (symH (one-of (jn i) (valT-range V (suc zero) j i) f)))) ;

  eqG : Id (Hom (lin V) (lin m)) (compH (lin V) (lin (suc m)) (lin m) (gkD m kk) h) g =
    hom-eq (lin V) (lin m) (compH (lin V) (lin (suc m)) (lin m) (gkD m kk) h) g
      (pwl V (lin m) (compH (lin V) (lin (suc m)) (lin m) (gkD m kk) h) g (\ i hi ->
         transH (app-compH1 (lin V) (lin (suc m)) (lin m) (gkD m kk) h (leaf i, hi))
           (transH (lf (pc m kk (hfN i)) (gn i) (pc-eq i hi)) (symH (valT-tree V m g i hi))))) ;

  eqJ : Id (Hom (lin V) Iv) (compH (lin V) (lin (suc m)) Iv (jkD m kk) h) j =
    hom-eq (lin V) Iv (compH (lin V) (lin (suc m)) Iv (jkD m kk) h) j
      (pwl V Iv (compH (lin V) (lin (suc m)) Iv (jkD m kk) h) j (\ i hi ->
         transH (app-compH1 (lin V) (lin (suc m)) Iv (jkD m kk) h (leaf i, hi))
           (transH (lf (pl m kk (hfN i)) (jn i) (pl-eq i hi)) (symH (valT-tree V (suc zero) j i hi))))) ;

  res : (k : Fin (suc m)) * ((h' : Hom (lin V) (lin (suc m)))
          * (Id (Hom (lin V) (lin m)) (compH (lin V) (lin (suc m)) (lin m) (gkD m k.1) h') g
             * Id (Hom (lin V) Iv) (compH (lin V) (lin (suc m)) Iv (jkD m k.1) h') j)) =
    ((kk, kk-le), (h, (eqG, eqJ))) ;
} ;

-- the prism cover of [W] * Delta[1] by its shuffles
module DCov (W : Nat) {
  module C = DB.PrismCov[W, suc W, \ k -> suc W, \ k -> gkD W k.1, \ k -> jkD W k.1, \ V g j -> Fact[W, V, g, j].res] ;
} ;

------------------------------------------------------------------------
-- forall of a list of lines over [X]: ONE sieve, the maps f : [W] -> [X]
-- covered by the union (HoldsU), decided on the shuffles of [W] * [1]
-- (PrismCov): at each shuffle k some line l is total.

-- the test at f
testB (X n : Nat) (Ls : Fin n -> DB.PhiL X) (W : Nat) (f : Hom (lin W) (lin X)) : Bool =
  forallUp W (\ k -> existsF n (\ l hl ->
    ((Ls (l, hl)).1 (suc W) (compH (lin (suc W)) (lin W) (lin X) f (gkD W k)) (jkD W k)).1 (suc W) (idH (lin (suc W))))) ;

module TB (X n : Nat) (Ls : Fin n -> DB.PhiL X) (W : Nat) (f : Hom (lin W) (lin X)) {
  module C = DCov[W].C ;

  -- the line holding at the shuffle k
  P (k : Nat) (l : Nat) (hl : IsT (ltb l n)) : Bool =
    ((Ls (l, hl)).1 (suc W) (compH (lin (suc W)) (lin W) (lin X) f (gkD W k)) (jkD W k)).1 (suc W) (idH (lin (suc W))) ;

  wit (t : IsT (testB X n Ls W f)) (k : Fin (suc W)) : (l : Nat) * ((hl : IsT (ltb l n)) * IsT (P k.1 l hl)) =
    exF-e n (P k.1) (fa-e W (\ k' -> existsF n (P k')) t k.1 k.2) ;

  toTests (t : IsT (testB X n Ls W f)) : C.AtTests X n Ls f = \ k ->
    (((wit t k).1, (wit t k).2.1), (wit t k).2.2) ;

  ofTests (a : C.AtTests X n Ls f) : IsT (testB X n Ls W f) =
    fa-i W (\ k -> existsF n (\ l hl -> ((Ls (l, hl)).1 (suc W) (compH (lin (suc W)) (lin W) (lin X) f (gkD W k)) (jkD W k)).1 (suc W) (idH (lin (suc W)))))
      (\ k hk -> exF-i n (\ l hl -> ((Ls (l, hl)).1 (suc W) (compH (lin (suc W)) (lin W) (lin X) f (gkD W k)) (jkD W k)).1 (suc W) (idH (lin (suc W))))
                    (a (k, hk)).1.1 (a (k, hk)).1.2 (a (k, hk)).2) ;

  sound (t : IsT (testB X n Ls W f)) : DB.HoldsU X n Ls W f = C.tests-holdsU X n Ls f (toTests t) ;

  complete (h : DB.HoldsU X n Ls W f) : IsT (testB X n Ls W f) = ofTests (C.holdsU-tests X n Ls f h) ;
} ;

-- being covered is stable under precomposition
holdsU-pre (X n : Nat) (Ls : Fin n -> DB.PhiL X) (W' W : Nat) (f : Hom (lin W) (lin X)) (g : Hom (lin W') (lin W))
  (h : DB.HoldsU X n Ls W f) : DB.HoldsU X n Ls W' (compH (lin W') (lin W) (lin X) f g) = \ V g' j ->
  ((h V (compH (lin V) (lin W') (lin W) g g') j).1,
   substH (\ k -> IsT (((Ls (h V (compH (lin V) (lin W') (lin W) g g') j).1).1 V k j).1 V (idH (lin V))))
     (symH (comp-assoc (lin V) (lin W') (lin W) (lin X) f g g')) (h V (compH (lin V) (lin W') (lin W) g g') j).2) ;

forallS (X n : Nat) (Ls : Fin n -> DB.PhiL X) : DBm.DS.Phi X =
  (testB X n Ls,
   \ W' W f g t -> TB[X, n, Ls, W', compH (lin W') (lin W) (lin X) f g].complete
                      (holdsU-pre X n Ls W' W f g (TB[X, n, Ls, W, f].sound t))) ;

------------------------------------------------------------------------
-- the instances: forall of a union (a one-element list), and of one line

-- forall commutes with restriction (one sieve on both sides)
forallS-pre (Y X : Nat) (h : Hom (lin Y) (lin X)) (n : Nat) (Ls : Fin n -> DB.PhiL X)
  : Id (DBm.DS.Phi Y) (DBm.DS.pre Y X h (forallS X n Ls)) (forallS Y n (\ l -> DB.restrL Y X h (Ls l))) =
  DBm.DS.phi-ext Y (DBm.DS.pre Y X h (forallS X n Ls)) (forallS Y n (\ l -> DB.restrL Y X h (Ls l)))
    (\ W g i -> TB[Y, n, \ l -> DB.restrL Y X h (Ls l), W, g].complete (\ V g' j ->
       ((TB[X, n, Ls, W, compH (lin W) (lin Y) (lin X) h g].sound i V g' j).1,
        substH (\ k -> IsT (((Ls (TB[X, n, Ls, W, compH (lin W) (lin Y) (lin X) h g].sound i V g' j).1).1 V k j).1 V (idH (lin V))))
          (comp-assoc (lin V) (lin W) (lin Y) (lin X) h g g') (TB[X, n, Ls, W, compH (lin W) (lin Y) (lin X) h g].sound i V g' j).2)))
    (\ W g i -> TB[X, n, Ls, W, compH (lin W) (lin Y) (lin X) h g].complete (\ V g' j ->
       ((TB[Y, n, \ l -> DB.restrL Y X h (Ls l), W, g].sound i V g' j).1,
        substH (\ k -> IsT (((Ls (TB[Y, n, \ l -> DB.restrL Y X h (Ls l), W, g].sound i V g' j).1).1 V k j).1 V (idH (lin V))))
          (symH (comp-assoc (lin V) (lin W) (lin Y) (lin X) h g g')) (TB[Y, n, \ l -> DB.restrL Y X h (Ls l), W, g].sound i V g' j).2))) ;

-- inserting an everywhere-empty line does not change forall of the union
-- (FaU.forallU-ins, first case: the same single sieve)
module FIns (X k j : Nat) (hj : IsT (leb j k)) (Ls : Fin k -> DB.PhiL X) (Ls' : Fin (suc k) -> DB.PhiL X)
  (eE : (h : IsT (ltb j (suc k))) (W : Nat) (f : Hom (lin W) (lin X)) (i : Hom (lin W) (lin (suc zero)))
        -> Id (DBm.DS.Phi W) ((Ls' (j, h)).1 W f i) (DBm.DS.emptyS W))
  (eQ : (n : Nat) (h : IsT (ltb n k)) (h' : IsT (ltb (skipN j n) (suc k))) -> Id (DB.PhiL X) (Ls' (skipN j n, h')) (Ls (n, h))) {

  LdTy (V : Nat) (fg : Hom (lin V) (lin X)) (jj : Hom (lin V) (lin (suc zero))) (L : DB.PhiL X) : U a =
    DBm.DS.Lands V V (L.1 V fg jj) (idH (lin V)) ;

  -- a line of Ls' holding somewhere is not the empty one: it is one of Ls
  back (V : Nat) (fg : Hom (lin V) (lin X)) (jj : Hom (lin V) (lin (suc zero))) (l' : Fin (suc k)) (ld : LdTy V fg jj (Ls' l'))
    : (l : Fin k) * LdTy V fg jj (Ls l) =
    eqN-dec ((l : Fin k) * LdTy V fg jj (Ls l)) l'.1 j
      (\ e -> absurd _ (DBm.DS.empty-lands V V (idH (lin V))
         (substH (\ R -> DBm.DS.Lands V V R (idH (lin V))) (eE (substH (\ z -> IsT (ltb z (suc k))) e l'.2) V fg jj)
            (substH (\ z -> LdTy V fg jj (Ls' z)) (fin-eq (suc k) l' (j, substH (\ z -> IsT (ltb z (suc k))) e l'.2) e) ld))))
      (\ ne -> ((unsk j l'.1, unsk-lt j l'.1 k hj l'.2 ne),
         substH (\ L -> LdTy V fg jj L)
           (transH (apH Ls' (fin-eq (suc k) l' (skipN j (unsk j l'.1), skipN-lt j (unsk j l'.1) k hj (unsk-lt j l'.1 k hj l'.2 ne))
                               (symH (skipN-unsk j l'.1 ne))))
                   (eQ (unsk j l'.1) (unsk-lt j l'.1 k hj l'.2 ne) (skipN-lt j (unsk j l'.1) k hj (unsk-lt j l'.1 k hj l'.2 ne))))
           ld)) ;

  fwd (V : Nat) (fg : Hom (lin V) (lin X)) (jj : Hom (lin V) (lin (suc zero))) (l : Fin k) (ld : LdTy V fg jj (Ls l))
    : (l' : Fin (suc k)) * LdTy V fg jj (Ls' l') =
    ((skipN j l.1, skipN-lt j l.1 k hj l.2),
     substH (\ L -> LdTy V fg jj L) (symH (eQ l.1 l.2 (skipN-lt j l.1 k hj l.2))) ld) ;

  S : Id (DBm.DS.Phi X) (forallS X (suc k) Ls') (forallS X k Ls) =
    DBm.DS.phi-ext X (forallS X (suc k) Ls') (forallS X k Ls)
      (\ W f i -> TB[X, k, Ls, W, f].complete (\ V g jj ->
         back V (compH (lin V) (lin W) (lin X) f g) jj (TB[X, suc k, Ls', W, f].sound i V g jj).1 (TB[X, suc k, Ls', W, f].sound i V g jj).2))
      (\ W f i -> TB[X, suc k, Ls', W, f].complete (\ V g jj ->
         fwd V (compH (lin V) (lin W) (lin X) f g) jj (TB[X, k, Ls, W, f].sound i V g jj).1 (TB[X, k, Ls, W, f].sound i V g jj).2)) ;

  res : DB.GensIns X (suc zero) (\ b -> forallS X k Ls) (suc zero) (\ b -> forallS X (suc k) Ls') =
    inl (refl (suc zero), \ n h h' -> S) ;
} ;

module DFaU = DB.FaU[\ n -> suc zero, \ X n Ls b -> forallS X n Ls,
  \ W X n Ls f i -> TB[X, n, Ls, W, f].sound i.2,
  \ W X n Ls f h -> ((zero, refl true), TB[X, n, Ls, W, f].complete h),
  \ Y X h n Ls l -> forallS-pre Y X h n Ls,
  \ X k j hj Ls Ls' eE eQ -> FIns[X, k, j, hj, Ls, Ls', eE, eQ].res] ;

module DFa = DB.Fa[\ X L -> forallS X (suc zero) (\ b -> L),
  \ W X L f i -> \ V g j -> (TB[X, suc zero, \ b -> L, W, f].sound i V g j).2,
  \ W X L f h -> TB[X, suc zero, \ b -> L, W, f].complete (\ V g j -> ((zero, refl true), h V g j))] ;

------------------------------------------------------------------------
-- PROBES (forall does not distribute over unions on Delta): the two
-- triangles T1 = {x <= e}, T2 = {e <= x} of the prism Delta[1] * Delta[1]
-- (DeltaBase.tri).  forall T1 holds at the vertex 0 only, forall T2 at the
-- vertex 1 only, so the edge id [1] lands in neither, though its prism is
-- T1 u T2: forall of the union contains the edge.

vtx (e : El Iv) : Hom (lin zero) (lin (suc zero)) = constH (lin zero) Iv e ;

-- the probes compute: composition is unlocked for them only
transparent compH ; transparent idH ;

triL (l : Fin (suc (suc zero))) : DB.PhiL (suc zero) = DBm.lineD (suc zero) (DBm.tri (eqN l.1 zero)) ;

probe-T1-0 : Id Bool ((DFa.forallL (suc zero) (DBm.lineD (suc zero) (DBm.tri true))).1 zero (vtx e0)) true = refl true ;
probe-T1-1 : Id Bool ((DFa.forallL (suc zero) (DBm.lineD (suc zero) (DBm.tri true))).1 zero (vtx e1)) false = refl false ;
probe-T2-0 : Id Bool ((DFa.forallL (suc zero) (DBm.lineD (suc zero) (DBm.tri false))).1 zero (vtx e0)) false = refl false ;
probe-T2-1 : Id Bool ((DFa.forallL (suc zero) (DBm.lineD (suc zero) (DBm.tri false))).1 zero (vtx e1)) true = refl true ;

probe-U-0 : Id Bool ((forallS (suc zero) (suc (suc zero)) triL).1 zero (vtx e0)) true = refl true ;
probe-U-1 : Id Bool ((forallS (suc zero) (suc (suc zero)) triL).1 zero (vtx e1)) true = refl true ;

-- the edge id [1]: in forall of the union, in neither forall alone
probe-U-edge : Id Bool ((forallS (suc zero) (suc (suc zero)) triL).1 (suc zero) (idH (lin (suc zero)))) true = refl true ;
probe-U-edge-T1 : Id Bool ((DFa.forallL (suc zero) (DBm.lineD (suc zero) (DBm.tri true))).1 (suc zero) (idH (lin (suc zero)))) false = refl false ;
probe-U-edge-T2 : Id Bool ((DFa.forallL (suc zero) (DBm.lineD (suc zero) (DBm.tri false))).1 (suc zero) (idH (lin (suc zero)))) false = refl false ;

opaque compH ; opaque idH ;
