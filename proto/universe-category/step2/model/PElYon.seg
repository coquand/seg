-- PElYon.seg: El of the poset universe at a Yoneda code is the code
-- (step (C) of the univalence plan, ElYonCl).  For F : U_L Z, El along
-- the Yoneda code map y Z -> U_L (cY g = F along g) is F.1 (GElC.Yon.elYon)
-- and its fibration structure (EGen's, moved down by GTransfer) is F.2:
-- El's composite of a problem over y Z is, by construction (GLocal3: pull
-- to the diagonal; PElL: along the pairing, F along the line's generic
-- point x^, whose composition is F's along x^ by selEq), F's composite of
-- the problem moved along x^ o pair o diagonal, which is the problem
-- itself pointwise (GProbEq).

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open Constr[a] ; open PosB ; open PCyl ;
module W0 = V[a] ;
open Arith[a] ;
module V1 = V[a+] ;
module BaseP = Constr[a].PosB ;
module PR = BaseP.GPre[a] ;
open PR.PS ;
module L1 = BaseP.GPre[a+] ;
open BaseP.GYon[a] ;
module UL = BaseP.GUnivL.UL ;
module PE0 = PElL[a] ;
module PE2 = PElL2[a] ;

-- transport of fibres along paths of codes (PElL.cV)
cV-trans (u v w : W0.V) (p : Id W0.V u v) (q : Id W0.V v w) (b : W0.Ix u)
  : Id (W0.Ix w) (PE0.cV v w q (PE0.cV u v p b)) (PE0.cV u w (transH p q) b) =
  idJ W0.V v (\ w2 q2 -> Id (W0.Ix w2) (PE0.cV v w2 q2 (PE0.cV u v p b)) (PE0.cV u w2 (transH p q2) b))
    (transH (UL.loopV v (refl v) (PE0.cV u v p b))
            (apH (\ r -> PE0.cV u v r b) (W0.isSetV u v p (transH p (refl v))))) w q ;

-- two transports of one element, into the fibres of F.1 at equal points
module CVP (Z : Ob) (A : PTy[yP Z]) (X : Ob) {
  module TA = PR.TyL[yP Z, A] ;

  cVpair (k1 k2 : Hom X Z) (r : Id (Hom X Z) k1 k2) (T : W0.V) (P1 : Id W0.V T (A.tob X k1)) (P2 : Id W0.V T (A.tob X k2)) (b : W0.Ix T)
    : Id (TA.EI X) (k1, PE0.cV T (A.tob X k1) P1 b) (k2, PE0.cV T (A.tob X k2) P2 b) =
    idJ (Hom X Z) k1
      (\ k3 r3 -> (P3 : Id W0.V T (A.tob X k3)) -> Id (TA.EI X) (k1, PE0.cV T (A.tob X k1) P1 b) (k3, PE0.cV T (A.tob X k3) P3 b))
      (\ P3 -> apH {W0.Ix (A.tob X k1)} {TA.EI X} (\ z -> (k1, z))
                 (apH (\ r4 -> PE0.cV T (A.tob X k1) r4 b) (W0.isSetV T (A.tob X k1) P1 P3)))
      k2 r P2 ;

  -- the converse: equal total elements, read back into one fibre
  cVback (k1 k2 : Hom X Z) (v1 : W0.Ix (A.tob X k1)) (v2 : W0.Ix (A.tob X k2)) (E : Id (TA.EI X) (k1, v1) (k2, v2))
    (T : W0.V) (P1 : Id W0.V (A.tob X k1) T) (P2 : Id W0.V (A.tob X k2) T)
    : Id (W0.Ix T) (PE0.cV (A.tob X k1) T P1 v1) (PE0.cV (A.tob X k2) T P2 v2) =
    idJ (TA.EI X) (k1, v1)
      (\ z E2 -> (P3 : Id W0.V (A.tob X z.1) T) -> Id (W0.Ix T) (PE0.cV (A.tob X k1) T P1 v1) (PE0.cV (A.tob X z.1) T P3 z.2))
      (\ P3 -> apH (\ r4 -> PE0.cV (A.tob X k1) T r4 v1) (W0.isSetV (A.tob X k1) T P1 P3))
      (k2, v2) E P2 ;

  opaque cVpair ; opaque cVback ;
} ;

-- coercion in El's fibres along a path of codes is transport of fibres
coeEG (X : Ob) (c1 c2 : UL.U0 X) (P : Id (UL.U0 X) c1 c2) (b : W0.Ix (UL.fib0 X c1))
  : Id (W0.Ix (UL.fib0 X c2)) (L1.TyL[UL.UCtx, UL.EGen].coeT X c1 c2 P b) (PE0.cV (UL.fib0 X c1) (UL.fib0 X c2) (apH (UL.fib0 X) P) b) =
  idJ (UL.U0 X) c1
    (\ c3 P3 -> Id (W0.Ix (UL.fib0 X c3)) (L1.TyL[UL.UCtx, UL.EGen].coeT X c1 c3 P3 b) (PE0.cV (UL.fib0 X c1) (UL.fib0 X c3) (apH (UL.fib0 X) P3) b))
    (refl b) c2 P ;

opaque cV-trans ; opaque coeEG ;

module EC = BaseP.GElC.ElC[BaseP.GUnivL.ClL, BaseP.GUnivL.clSubL, BaseP.GUnivL.clSub-idL, BaseP.GUnivL.clSub-oL,
  \ X A -> BaseP.GUnivL.encClL (yP X) A, PE2.fibEGen.2.1, PE2.fibEGen.2.2] ;

module EY (Z : Ob) (F : UL.U0 Z) {
  cYnat (Y' Y : Ob) (h : Hom Y' Y) (g : Hom Y Z) : Id (UL.U0 Y') (UL.uAct Y' Z (compH Y' Y Z g h) F) (UL.uAct Y' Y h (UL.uAct Y Z g F)) =
    UL.uAct-o Y' Y Z g h F ;

  module YN = EC.Yon[Z, F, cYnat] ;
  module FC = EC.Fam[yP Z, YN.cY, cYnat] ;
  module TF = PR.TyL[yP Z, F.1] ;
  module TL = PR.TyL[yP Z, FC.ElTy] ;

  -- El's fibres read in F (along Po)
  idN (V W : Ob) (g : Hom V W) (d : Hom W Z) : Id (Hom V Z) ((yP Z).act V W g d) ((yP Z).act V W g d) = refl ((yP Z).act V W g d) ;

  phPo (W : Ob) (d : Hom W Z) (b : W0.Ix (UL.fib0 W (YN.cY W d))) : W0.Ix (F.1.tob W d) =
    PE0.cV (UL.fib0 W (YN.cY W d)) (F.1.tob W d) (YN.Po W d) b ;
  psPo (W : Ob) (d : Hom W Z) (b : W0.Ix (F.1.tob W d)) : W0.Ix (UL.fib0 W (YN.cY W d)) =
    PE0.cV (F.1.tob W d) (UL.fib0 W (YN.cY W d)) (symH (YN.Po W d)) b ;
  ph-psPo (W : Ob) (d : Hom W Z) (b : W0.Ix (F.1.tob W d)) : Id (W0.Ix (F.1.tob W d)) (phPo W d (psPo W d b)) b =
    PE0.cV-sym-r (UL.fib0 W (YN.cY W d)) (F.1.tob W d) (YN.Po W d) b ;
  ps-phPo (W : Ob) (d : Hom W Z) (b : W0.Ix (UL.fib0 W (YN.cY W d))) : Id (W0.Ix (UL.fib0 W (YN.cY W d))) (psPo W d (phPo W d b)) b =
    PE0.cV-sym-l (UL.fib0 W (YN.cY W d)) (F.1.tob W d) (YN.Po W d) b ;
  PhNPo (V W : Ob) (g : Hom V W) (w : TL.EI W)
    : Id (TF.EI V) ((TL.E.act V W g w).1, phPo V (TL.E.act V W g w).1 (TL.E.act V W g w).2) (TF.E.act V W g (w.1, phPo W w.1 w.2)) =
    apH {W0.Ix (F.1.tob V ((yP Z).act V W g w.1))} {TF.EI V} (\ v -> ((yP Z).act V W g w.1, v))
      (YN.H1 V W g w.1 ((yP Z).act V W g w.1) (refl ((yP Z).act V W g w.1)) w.2) ;

  module TE = L1.TyL[UL.UCtx, UL.EGen] ;

  -- a value read in El at the code of a generalised point, moved to F
  sideVal (V : Ob) (kp k0 : Hom V Z) (r : Id (Hom V Z) kp k0) (cl : UL.U0 V) (Pl : Id W0.V (UL.fib0 V cl) (F.1.tob V kp))
    (c1 : UL.U0 V) (b1 : W0.Ix (UL.fib0 V c1)) (qq : Id (UL.U0 V) c1 cl) (b0 : W0.Ix (UL.fib0 V (YN.cY V k0)))
    (E : Id (TE.EI V) (c1, b1) (YN.cY V k0, b0))
    : Id (TF.EI V) (kp, PE0.cV (UL.fib0 V cl) (F.1.tob V kp) Pl (TE.coeT V c1 cl qq b1)) (k0, phPo V k0 b0) =
    transH (apH {W0.Ix (F.1.tob V kp)} {TF.EI V} (\ v -> (kp, v))
              (transH (apH (PE0.cV (UL.fib0 V cl) (F.1.tob V kp) Pl) (coeEG V c1 cl qq b1))
                      (cV-trans (UL.fib0 V c1) (UL.fib0 V cl) (F.1.tob V kp) (apH (UL.fib0 V) qq) Pl b1)))
      (idJ (TE.EI V) (YN.cY V k0, b0)
         (\ z E2 -> (qq2 : Id (UL.U0 V) z.1 cl)
            -> Id (TF.EI V) (kp, PE0.cV (UL.fib0 V z.1) (F.1.tob V kp) (transH (apH (UL.fib0 V) qq2) Pl) z.2) (k0, phPo V k0 b0))
         (\ qq2 -> CVP[Z, F.1, V].cVpair kp k0 r (UL.fib0 V (YN.cY V k0)) (transH (apH (UL.fib0 V) qq2) Pl) (YN.Po V k0) b0)
         (c1, b1) (symH E) qq) ;

  opaque sideVal ;

  module Dir (e e' : BaseP.IPt)
    (sel : (Z1 : Ob) (F1 : UL.U0 Z1) -> BaseP.GLine[a].CompAtP[BaseP.GFam[a].famPath, yP Z1, F1.1, e, e'].CompAt)
    (selEq : (Z' Z1 : Ob) (g : Hom Z' Z1) (F1 : UL.U0 Z1)
       -> Id (BaseP.GLine[a].CompAtP[BaseP.GFam[a].famPath, yP Z', (UL.uAct Z' Z1 g F1).1, e, e'].CompAt)
             (sel Z' (UL.uAct Z' Z1 g F1)) (BaseP.GSubst[a].SubC[yP Z', yP Z1, yH Z' Z1 g, F1.1, e, e', sel Z1 F1].compAt)) {
    module EF = PE2.ElFib[e, e', sel, selEq] ;
    module TrEl = FC.T[e, e', EF.compAt].TR ;
    module CD = TrEl.CD ;
    module TrF = BaseP.GTransfer[a, a, a].Tr[yP Z, FC.ElTy, yP Z, F.1, \ W d -> d, BaseP.GTransferSub.TrId[yP Z, F.1, F.2.1].idNat, phPo, psPo, ph-psPo, ps-phPo, PhNPo, e, e', sel Z F] ;

    module At (X : Ob) (x : CD.TV.EI X) (p : CD.PT.Partial[X, x]) {
      y : TrEl.M.CD0.TV.EI X = TrEl.M.tvN X x ;
      q : TrEl.M.CD0.PT.Partial[X, y] = TrEl.M.mapP X x p ;
      module LA = EF.LCm.At[X, y] ;
      l : V1.Ix ((BaseP.GFam[a+].FC[UL.UCtx]).ob X) = y.1 ;
      xh : Hom (prodP X Iv) Z = x.1.1 (prodP X Iv) (pr1 X Iv) (pr2 X Iv) ;
      module EP = PE0.ElP[X, l, PE0.FC X l, PE0.QdC X l] ;
      module TRP = EP.T[e, e', sel (prodP X Iv) (PE0.FC X l)].TR ;

      probe : Id (CD.TV'.T X x.1) (TrEl.cop X x p) (TRP.cop X LA.PP.x0 (LA.PP.part q)) = refl (TrEl.cop X x p) ;

      -- the problem moved along x^ o pair o diagonal, and the problem read in F
      module SC = BaseP.GSubst[a].SubC[yP (prodP X Iv), yP Z, yH (prodP X Iv) Z xh, F.1, e, e', sel Z F] ;
      module MP = SC.M.MP ;
      P1 : TRP.M.CD0.TV.EI X = TRP.M.tvN X LA.PP.x0 ;
      Q1 : TRP.M.CD0.PT.Partial[X, P1] = TRP.M.mapP X LA.PP.x0 (LA.PP.part q) ;
      P2 : MP.CG.TV.EI X = MP.tvN X P1 ;
      Q2 : MP.CG.PT.Partial[X, P2] = MP.MN.mapP X P1 Q1 ;
      Pz : TrF.M.CD0.TV.EI X = TrF.M.tvN X x ;
      Qz : TrF.M.CD0.PT.Partial[X, Pz] = TrF.M.mapP X x p ;

      -- the points: x^ o pair (f , i) = x (f , i)
      Hl (W : Ob) (f : Hom W X) (i : Hom W Iv) : Id (Hom W Z) (P2.1.1 W f i) (Pz.1.1 W f i) =
        transH (x.1.2 W (prodP X Iv) (pairH X Iv W f i) (pr1 X Iv) (pr2 X Iv))
          (transH (apH (\ k -> x.1.1 W k (compH W (prodP X Iv) Iv (pr2 X Iv) (pairH X Iv W f i))) (pr1-pair X Iv W f i))
                  (apH (\ k -> x.1.1 W f k) (pr2-pair X Iv W f i))) ;

      -- the ends: one element of El's fibre, transported twice
      kx : Hom X Z = x.1.1 X (idH X) (ptH X e) ;
      pq : Id (UL.U0 X) (y.1.1 X (idH X) (ptH X e)) (y.1.1 X (idH X) (ptH X e)) =
        symH (apH (\ k -> k.1 X (idH X) (ptH X e)) LA.qx) ;
      Pend : Id W0.V (UL.fib0 X (YN.cY X kx)) (F.1.tob X (P2.1.1 X (idH X) (ptH X e))) =
        transH (apH (UL.fib0 X) pq) (symH (EP.Pv X (idH X, ptH X e))) ;

      He : Id (TF.EI X) (P2.1.1 X (idH X) (ptH X e), P2.2) (Pz.1.1 X (idH X) (ptH X e), Pz.2) =
        transH (apH {W0.Ix (F.1.tob X (P2.1.1 X (idH X) (ptH X e)))} {TF.EI X} (\ v -> (P2.1.1 X (idH X) (ptH X e), v))
                  (transH (apH (PE0.cV (UL.fib0 X (YN.cY X kx)) (F.1.tob X (P2.1.1 X (idH X) (ptH X e))) (symH (EP.Pv X (idH X, ptH X e))))
                             (coeEG X (YN.cY X kx) (YN.cY X kx) pq x.2))
                          (cV-trans (UL.fib0 X (YN.cY X kx)) (UL.fib0 X (YN.cY X kx)) (F.1.tob X (P2.1.1 X (idH X) (ptH X e)))
                             (apH (UL.fib0 X) pq) (symH (EP.Pv X (idH X, ptH X e))) x.2)))
          (CVP[Z, F.1, X].cVpair (P2.1.1 X (idH X) (ptH X e)) kx (Hl X (idH X) (ptH X e)) (UL.fib0 X (YN.cY X kx)) Pend (YN.Po X kx) x.2) ;

      -- the sides: their values, read in F, agree
      module SV (k : Fin p.pr) (W : Ob) (f : Hom W X) (i : Lands W X (p.ps k).pQ f) (i' : Lands W X (p.ps k).pQ f)
        (V : Ob) (g : Hom V W) (j : Hom V Iv) {
        u0 : CD.TS.EI W = (p.ps k).pv W f i ;
        u : TrEl.M.CD0.TS.EI W = TrEl.M.tsN W u0 ;
        pu : Id (TrEl.M.CD0.TV.EI W) u.1 (TrEl.M.CD0.TV.E.act W X f y) = ((q.ps k).ppt W f i) ;
        u2 : TRP.M.CD.TS.EI W = LA.PP.res W f u pu ;
        u3 : TRP.M.CD0.TS.EI W = TRP.M.tsN W u2 ;
        fg : Hom V X = compH V W X f g ;
        k0 : Hom V Z = (u0.2.1.1.1 V g j).1 ;

        r : Id (Hom V Z) (compH V (prodP X Iv) Z xh (pairH X Iv V fg j)) k0 =
          transH (Hl V fg j)
            (symH (transH (apH (\ z -> z.1 V g j) u0.2.1.2) (apH (\ z -> z.1.1 V g j) ((p.ps k).ppt W f i)))) ;

        u2r : TRP.M.TB.EI V = u2.2.1.1.1 V g j ;
        u3r : TRP.M.TB0.EI V = u3.2.1.1.1 V g j ;
        ur : TE.EI V = u.2.1.1.1 V g j ;

        qgP : Id (UL.U0 V) ur.1 (l.1 V fg j) = LA.PL.TSP[X, BaseP.GLocal[a+].dg X, y, LA.qx, W, f, u, pu].qg V g j ;
        kp : Hom V Z = compH V (prodP X Iv) Z xh (pairH X Iv V fg j) ;

        m0 : TF.EI V = BaseP.GFam[a].famConn.levA (yP Z) F.1 W (MP.CG.EK.lineL W (MP.tsN W u3)) V g j ;
        m1 : TF.EI V = (compH V (prodP X Iv) Z xh u3r.1, u3r.2) ;
        m2 : TF.EI V = (compH V (prodP X Iv) Z xh (EP.sg V u2r.1), EP.ph V u2r.1 u2r.2) ;
        m3 : TF.EI V = (kp, PE0.cV (UL.fib0 V (l.1 V fg j)) (F.1.tob V kp) (symH (EP.Pv V (fg, j))) (TE.coeT V ur.1 (l.1 V fg j) qgP ur.2)) ;
        m4 : TF.EI V = (k0, phPo V k0 (u0.2.1.1.1 V g j).2) ;
        m5 : TF.EI V = BaseP.GFam[a].famConn.levA (yP Z) F.1 W (TrF.M.CD0.EK.lineL W (TrF.M.tsN W ((p.ps k).pv W f i'))) V g j ;

        h1 : Id (TF.EI V) m0 m1 = MP.TSN[W, u3].res-lev V g j ;

        h2 : Id (TF.EI V) m1 m2 =
          ap (TRP.M.TB0.EI V) (TF.EI V) (\ z -> (compH V (prodP X Iv) Z xh z.1, z.2)) u3r (TRP.M.PhE V u2r) (TRP.M.TSN[W, u2].res-lev V g j) ;

        h3 : Id (TF.EI V) m2 m3 =
          ap (TRP.M.TB.EI V) (TF.EI V) (\ z -> (compH V (prodP X Iv) Z xh (EP.sg V z.1), EP.ph V z.1 z.2))
            u2r (LA.PL.TSP[X, BaseP.GLocal[a+].dg X, y, LA.qx, W, f, u, pu].t V g j) (LA.PP.res-val W f u pu V g j) ;

        h4 : Id (TF.EI V) m3 m4 =
          sideVal V kp k0 r (l.1 V fg j) (symH (EP.Pv V (fg, j))) ur.1 ur.2 qgP (u0.2.1.1.1 V g j).2 (TrEl.M.TSN[W, u0].res-lev V g j) ;

        h5 : Id (TF.EI V) m4 m5 =
          sym (TF.EI V) m5 m4
            (trans (TF.EI V) m5 (TrF.M.PhE V (((p.ps k).pv W f i').2.1.1.1 V g j)) m4
               (TrF.M.TSN[W, (p.ps k).pv W f i'].res-lev V g j)
               (ap (CD.TS.EI W) (TF.EI V) (\ w -> ((w.2.1.1.1 V g j).1, phPo V (w.2.1.1.1 V g j).1 (w.2.1.1.1 V g j).2))
                  ((p.ps k).pv W f i') u0 (CD.PT.pv-irr X x (p.ps k) W f i' i))) ;

        Hv : Id (TF.EI V) m0 m5 =
          trans (TF.EI V) m0 m1 m5 h1 (trans (TF.EI V) m1 m2 m5 h2 (trans (TF.EI V) m2 m3 m5 h3 (trans (TF.EI V) m3 m4 m5 h4 h5))) ;

        opaque h1 ; opaque h2 ; opaque h3 ; opaque h4 ; opaque h5 ;
      } ;

      -- the composites: F's at the moved problem and at the problem read in F
      kx' : Hom X Z = x.1.1 X (idH X) (ptH X e') ;

      copPE : Id (MP.CG.TV'.EI X) (P2.1, (sel Z F).cop X P2 Q2) (Pz.1, (sel Z F).cop X Pz Qz) =
        BaseP.GProbEq[a].ProbEq[yP Z, F.1, e, e', X].cop-eq (sel Z F) P2 Pz Hl He Q2 Qz (refl p.pr) (\ k -> refl (p.ps k).pQ)
          (\ k W f i i' V g j -> SV[k, W, f, i, i', V, g, j].Hv) ;

      copA : Id (W0.Ix (F.1.tob X (P2.1.1 X (idH X) (ptH X e'))))
                ((sel (prodP X Iv) (PE0.FC X l)).cop X P1 Q1) ((sel Z F).cop X P2 Q2) =
        apH (\ c -> c.cop X P1 Q1) (selEq (prodP X Iv) Z xh F) ;

      copEq : Id (CD.TV'.T X x.1) (TrEl.cop X x p) (TrF.cop X x p) =
        transH (apH (EP.ps X (idH X, ptH X e')) copA)
          (CVP[Z, F.1, X].cVback (P2.1.1 X (idH X) (ptH X e')) kx' ((sel Z F).cop X P2 Q2) ((sel Z F).cop X Pz Qz)
             (apH (MP.KG'.endE X) copPE) (UL.fib0 X (YN.cY X kx')) (EP.Pv X (idH X, ptH X e')) (symH (YN.Po X kx'))) ;

      opaque copPE ; opaque copEq ;
    } ;
  } ;
} ;
