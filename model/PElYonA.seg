-- PElYonA.seg: El of the poset universe at a Yoneda code is the code,
-- the composites (split from PElYon for time): at a problem p over y Z,
-- El's composite (TrEl) is F's composite of p moved along x^ o pair o
-- diagonal (copA, selEq), which is p itself pointwise (copPE, GProbEq:
-- the points Hl / He, the side values SV.Hv); so TrEl.cop = TrF.cop (copEq).
level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open Constr[a] ; open PosS[a] ; open PSB ; open PSCyl ;
module W0 = V[a] ;
open Arith[a] ;
module V1 = V[a+] ;
module BaseP = PosS[a].PSB ;
module PR = BaseP.GPre[a] ;
open PR.PS ;
module L1 = BaseP.GPre[a+] ;
open BaseP.GYon[a] ;
module UL = BaseP.GUnivL.UL ;
module PE0 = PElL[a] ;
module PE2 = PElL2[a] ;
module PY0 = PElYon[a] ;

module At (Z : Ob) (F : UL.U0 Z) (e e' : BaseP.IPt)
  (sel : (Z1 : Ob) (F1 : UL.U0 Z1) -> BaseP.GLine[a].CompAtP[BaseP.GFam[a].famPath, yP Z1, F1.1, e, e'].CompAt)
  (selEq : (Z' Z1 : Ob) (g : Hom Z' Z1) (F1 : UL.U0 Z1)
     -> Id (BaseP.GLine[a].CompAtP[BaseP.GFam[a].famPath, yP Z', (UL.uAct Z' Z1 g F1).1, e, e'].CompAt)
           (sel Z' (UL.uAct Z' Z1 g F1)) (BaseP.GSubst[a].SubC[yP Z', yP Z1, yH Z' Z1 g, F1.1, e, e', sel Z1 F1].compAt))
  (X : Ob) (x : PY0.EY[Z, F].Dir[e, e', sel, selEq].CD.TV.EI X)
  (p : PY0.EY[Z, F].Dir[e, e', sel, selEq].CD.PT.Partial[X, x]) {
  module EY0 = PY0.EY[Z, F] ;
  module DR = EY0.Dir[e, e', sel, selEq] ;
  y : DR.TrEl.M.CD0.TV.EI X = DR.TrEl.M.tvN X x ;
  q : DR.TrEl.M.CD0.PT.Partial[X, y] = DR.TrEl.M.mapP X x p ;
  module LA = DR.EF.LCm.At[X, y] ;
  l : V1.Ix ((BaseP.GFam[a+].FC[UL.UCtx]).ob X) = y.1 ;
  xh : Hom (prodP X Iv) Z = x.1.1 (prodP X Iv) (pr1 X Iv) (pr2 X Iv) ;
  module EP = PE0.ElP[X, l, PE0.FC X l, PE0.QdC X l] ;
  module TRP = EP.T[e, e', sel (prodP X Iv) (PE0.FC X l)].TR ;

  -- the problem moved along x^ o pair o diagonal, and the problem read in F
  module SC = BaseP.GSubst[a].SubC[yP (prodP X Iv), yP Z, yH (prodP X Iv) Z xh, F.1, e, e', sel Z F] ;
  module MP = SC.M.MP ;
  P1 : TRP.M.CD0.TV.EI X = TRP.M.tvN X LA.PP.x0 ;
  Q1 : TRP.M.CD0.PT.Partial[X, P1] = TRP.M.mapP X LA.PP.x0 (LA.PP.part q) ;
  P2 : MP.CG.TV.EI X = MP.tvN X P1 ;
  Q2 : MP.CG.PT.Partial[X, P2] = MP.MN.mapP X P1 Q1 ;
  Pz : DR.TrF.M.CD0.TV.EI X = DR.TrF.M.tvN X x ;
  Qz : DR.TrF.M.CD0.PT.Partial[X, Pz] = DR.TrF.M.mapP X x p ;

  -- the points: x^ o pair (f , i) = x (f , i)
  Hl (W : Ob) (f : Hom W X) (i : Hom W Iv) : Id (Hom W Z) (P2.1.1 W f i) (Pz.1.1 W f i) =
    transH (x.1.2 W (prodP X Iv) (pairH X Iv W f i) (pr1 X Iv) (pr2 X Iv))
      (transH (apH (\ k -> x.1.1 W k (compH W (prodP X Iv) Iv (pr2 X Iv) (pairH X Iv W f i))) (pr1-pair X Iv W f i))
              (apH (\ k -> x.1.1 W f k) (pr2-pair X Iv W f i))) ;

  -- the ends: one element of El's fibre, transported twice
  kx : Hom X Z = x.1.1 X (idH X) (ptH X e) ;
  pq : Id (UL.U0 X) (y.1.1 X (idH X) (ptH X e)) (y.1.1 X (idH X) (ptH X e)) =
    symH (apH (\ k -> k.1 X (idH X) (ptH X e)) LA.qx) ;
  Pend : Id W0.V (UL.fib0 X (EY0.YN.cY X kx)) (F.1.tob X (P2.1.1 X (idH X) (ptH X e))) =
    transH (apH (UL.fib0 X) pq) (symH (EP.Pv X (idH X, ptH X e))) ;

  He : Id (EY0.TF.EI X) (P2.1.1 X (idH X) (ptH X e), P2.2) (Pz.1.1 X (idH X) (ptH X e), Pz.2) =
    transH (apH {W0.Ix (F.1.tob X (P2.1.1 X (idH X) (ptH X e)))} {EY0.TF.EI X} (\ v -> (P2.1.1 X (idH X) (ptH X e), v))
              (transH (apH (PE0.cV (UL.fib0 X (EY0.YN.cY X kx)) (F.1.tob X (P2.1.1 X (idH X) (ptH X e))) (symH (EP.Pv X (idH X, ptH X e))))
                         (PE0.coeEG X (EY0.YN.cY X kx) (EY0.YN.cY X kx) pq x.2))
                      (PY0.cV-trans (UL.fib0 X (EY0.YN.cY X kx)) (UL.fib0 X (EY0.YN.cY X kx)) (F.1.tob X (P2.1.1 X (idH X) (ptH X e)))
                         (apH (UL.fib0 X) pq) (symH (EP.Pv X (idH X, ptH X e))) x.2)))
      (PY0.CVP[Z, F.1, X].cVpair (P2.1.1 X (idH X) (ptH X e)) kx (Hl X (idH X) (ptH X e)) (UL.fib0 X (EY0.YN.cY X kx)) Pend (EY0.YN.Po X kx) x.2) ;

  -- the sides: their values, read in F, agree
  module SV (k : Fin p.pr) (W : Ob) (f : Hom W X) (i : Lands W X (p.ps k).pQ f) (i' : Lands W X (p.ps k).pQ f)
    (V : Ob) (g : Hom V W) (j : Hom V Iv) {
    u0 : DR.CD.TS.EI W = (p.ps k).pv W f i ;
    u : DR.TrEl.M.CD0.TS.EI W = DR.TrEl.M.tsN W u0 ;
    pu : Id (DR.TrEl.M.CD0.TV.EI W) u.1 (DR.TrEl.M.CD0.TV.E.act W X f y) = ((q.ps k).ppt W f i) ;
    u2 : TRP.M.CD.TS.EI W = LA.PP.res W f u pu ;
    u3 : TRP.M.CD0.TS.EI W = TRP.M.tsN W u2 ;
    fg : Hom V X = compH V W X f g ;
    k0 : Hom V Z = (u0.2.1.1.1 V g j).1 ;

    r : Id (Hom V Z) (compH V (prodP X Iv) Z xh (pairH X Iv V fg j)) k0 =
      transH (Hl V fg j)
        (symH (transH (apH (\ z -> z.1 V g j) u0.2.1.2) (apH (\ z -> z.1.1 V g j) ((p.ps k).ppt W f i)))) ;

    u2r : TRP.M.TB.EI V = u2.2.1.1.1 V g j ;
    u3r : TRP.M.TB0.EI V = u3.2.1.1.1 V g j ;
    ur : EY0.TE.EI V = u.2.1.1.1 V g j ;

    qgP : Id (UL.U0 V) ur.1 (l.1 V fg j) = LA.PL.TSP[X, BaseP.GLocal[a+].dg X, y, LA.qx, W, f, u, pu].qg V g j ;
    kp : Hom V Z = compH V (prodP X Iv) Z xh (pairH X Iv V fg j) ;

    m0 : EY0.TF.EI V = BaseP.GFam[a].famConn.levA (yP Z) F.1 W (MP.CG.EK.lineL W (MP.tsN W u3)) V g j ;
    m1 : EY0.TF.EI V = (compH V (prodP X Iv) Z xh u3r.1, u3r.2) ;
    m2 : EY0.TF.EI V = (compH V (prodP X Iv) Z xh (EP.sg V u2r.1), EP.ph V u2r.1 u2r.2) ;
    m3 : EY0.TF.EI V = (kp, PE0.cV (UL.fib0 V (l.1 V fg j)) (F.1.tob V kp) (symH (EP.Pv V (fg, j))) (EY0.TE.coeT V ur.1 (l.1 V fg j) qgP ur.2)) ;
    m4 : EY0.TF.EI V = (k0, EY0.phPo V k0 (u0.2.1.1.1 V g j).2) ;
    m5 : EY0.TF.EI V = BaseP.GFam[a].famConn.levA (yP Z) F.1 W (DR.TrF.M.CD0.EK.lineL W (DR.TrF.M.tsN W ((p.ps k).pv W f i'))) V g j ;

    h1 : Id (EY0.TF.EI V) m0 m1 = MP.TSN[W, u3].res-lev V g j ;

    h2 : Id (EY0.TF.EI V) m1 m2 =
      ap (TRP.M.TB0.EI V) (EY0.TF.EI V) (\ z -> (compH V (prodP X Iv) Z xh z.1, z.2)) u3r (TRP.M.PhE V u2r) (TRP.M.TSN[W, u2].res-lev V g j) ;

    h3 : Id (EY0.TF.EI V) m2 m3 =
      ap (TRP.M.TB.EI V) (EY0.TF.EI V) (\ z -> (compH V (prodP X Iv) Z xh (EP.sg V z.1), EP.ph V z.1 z.2))
        u2r (LA.PL.TSP[X, BaseP.GLocal[a+].dg X, y, LA.qx, W, f, u, pu].t V g j) (LA.PP.res-val W f u pu V g j) ;

    h4 : Id (EY0.TF.EI V) m3 m4 =
      EY0.sideVal V kp k0 r (l.1 V fg j) (symH (EP.Pv V (fg, j))) ur.1 ur.2 qgP (u0.2.1.1.1 V g j).2 (DR.TrEl.M.TSN[W, u0].res-lev V g j) ;

    h5 : Id (EY0.TF.EI V) m4 m5 =
      sym (EY0.TF.EI V) m5 m4
        (trans (EY0.TF.EI V) m5 (DR.TrF.M.PhE V (((p.ps k).pv W f i').2.1.1.1 V g j)) m4
           (DR.TrF.M.TSN[W, (p.ps k).pv W f i'].res-lev V g j)
           (ap (DR.CD.TS.EI W) (EY0.TF.EI V) (\ w -> ((w.2.1.1.1 V g j).1, EY0.phPo V (w.2.1.1.1 V g j).1 (w.2.1.1.1 V g j).2))
              ((p.ps k).pv W f i') u0 (DR.CD.PT.pv-irr X x (p.ps k) W f i' i))) ;

    Hv : Id (EY0.TF.EI V) m0 m5 =
      trans (EY0.TF.EI V) m0 m1 m5 h1 (trans (EY0.TF.EI V) m1 m2 m5 h2 (trans (EY0.TF.EI V) m2 m3 m5 h3 (trans (EY0.TF.EI V) m3 m4 m5 h4 h5))) ;

    opaque h1 ; opaque h2 ; opaque h3 ; opaque h4 ; opaque h5 ;
  } ;
} ;
