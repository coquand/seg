+-- the fields of a record: its body-less units that are not head parameters
+recordFieldNames :: Mod -> [Name]
+recordFieldNames md = case modKind md of
+  SRecord hs -> [ x | x <- termParams (modUnits md), x `notElem` hs ]
+  SModule    -> []
