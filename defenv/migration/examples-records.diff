+-- fixedfields.seg: partially fixed record types R[ps][x := e] (RECORDS.md §4).
+-- A fixed field is known from the TYPE at the point where a projection is
+-- checked: t.x is elaborated to e.  Conversion stays untyped, so this is
+-- stable under substitution; forgetting the refinement forgets it.
+
+level a ;
+data N = zero | suc (n : N) ;
+
+-- a fixed field enters the types of the later projections
+record Pack { A : U a ; value : A ; } ;
+pv (p : Pack[A := N]) : N = p.value ;
+pvSuc (p : Pack[A := N]) : N = suc p.value ;
+pA (p : Pack[A := N]) : Id (U a) p.A N = refl N ;
+
+record Mon (l : Level) { A : U l ; op : A -> A -> A ; e : A ; sq (x : A) : A = op x x ; } ;
+
+-- on a variable and on a neutral application alike
+viaVar (M : Mon[a, N]) : Id (U a) M.A N = refl N ;
+viaApp (S : N -> Mon[a, N]) : Id (U a) (S zero).A N = refl N ;
+-- the types of derived members see the fixed field
+sqN (M : Mon[a, N]) (x : N) : N = M.sq x ;
+
+-- forgetting the refinement forgets its computation; Id keeps the equality
+pass (M : Mon[a, N]) : Mon[a] = M ;
+#fails { lost (M : Mon[a, N]) : Id (U a) (pass M).A N = refl N ; } ;
+kept : (M : Mon[a, N]) -> Id (U a) (pass M).A N = split { Mon A op e -> refl N } ;
+
+-- elements: the same constructor, the fixed value must agree
+m0 : Mon[a, N] = new Mon[a, N, \ x y -> x, zero] ;
+#fails { bad : Mon[a, N] = new Mon[a, N -> N, \ f g -> f, \ x -> x] ; } ;
+-- subtyping: more fields fixed is a subtype, not the converse
+up (M : Mon[a, N]) : Mon[a] = M ;
+#fails { down (M : Mon[a]) : Mon[a, N] = M ; } ;
+
+-- formation: a fixed field's type may mention only fixed fields
+#fails { badForm : U a = Mon[a, e := zero] ; } ;
