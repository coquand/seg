-- Two leaves, with monoids S1 and S2. Over the product monoid S1 S2
-- both monic generators generate the row ideal, so they are equal.
-- Hence the cleared numerators satisfy, in A[X],
--   u v (d2 p1 - d1 p2) = 0   for some u in S1, v in S2.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R)
 (n : Nat) (ys : Fin n -> List A.R)
 (S1 : A.R -> U l) (one1 : S1 A.o) (product1 : (s t : A.R) -> S1 s -> S1 t -> S1 (A.mul s t))
 (S2 : A.R -> U l) (one2 : S2 A.o) (product2 : (s t : A.R) -> S2 s -> S2 t -> S2 (A.mul s t)) {
 module Tr = Truncation[l] ;
 module Pow = AffinePowers[l].Over[A] ;
 Witness (x : A.R) : U l = (u : A.R) * (v : A.R) * S1 u * S2 v * Id A.R x (A.mul u v) ;
 unit : Witness A.o = (A.o,A.o,one1,one2,sym (A.mulO A.o)) ;
 multiply (x x1 : A.R) (wx : Witness x) (wy : Witness x1) : Witness (A.mul x x1) =
  (A.mul wx.1 wy.1,A.mul wx.2.1 wy.2.1,
   product1 wx.1 wy.1 wx.2.2.1 wy.2.2.1,product2 wx.2.1 wy.2.1 wx.2.2.2.1 wy.2.2.2.1,
   trans (cong2 A.R A.mul _ _ _ _ wx.2.2.2.2 wy.2.2.2.2)
    (MonoidBranch[l].Over[A,setA].shuffle wx.1 wx.2.1 wy.1 wy.2.1)) ;
 module One = LeafClearing[l].Over[A,setA,n,ys,S1,one1,product1] ;
 module Two = LeafClearing[l].Over[A,setA,n,ys,S2,one2,product2] ;
 module Both = LeafClearing[l].Over[A,setA,n,ys,Witness,unit,multiply] ;
 module LP = Both.L ;
 module B = Both.B ;
 module DP = Both.D ;
 left-unit (s : A.R) (hs : S1 s) : RL[LP.ring].unit (LP.inclusion.1 s) =
  LP.inverse s (s,A.o,hs,one2,sym (A.mulO s)) ;
 right-unit (s : A.R) (hs : S2 s) : RL[LP.ring].unit (LP.inclusion.1 s) =
  LP.inverse s (A.o,s,one1,hs,sym (Pow.one-left s)) ;
 module LeftMap = MonoidLocalizationMap[l].Over[A,S1,one1,product1,LP.ring,LP.set,LP.inclusion,left-unit] ;
 module RightMap = MonoidLocalizationMap[l].Over[A,S2,one2,product2,LP.ring,LP.set,LP.inclusion,right-unit] ;
 module PL = PolynomialMap[l].Over[One.L.ring,LP.ring,One.L.set,LP.set,LeftMap.hom] ;
 module PR = PolynomialMap[l].Over[Two.L.ring,LP.ring,Two.L.set,LP.set,RightMap.hom] ;
 module TL = PolynomialMapComposition[l].Over[A,One.L.ring,LP.ring,setA,One.L.set,LP.set,
  One.L.inclusion,LeftMap.hom,LP.inclusion,LeftMap.constants] ;
 module TR = PolynomialMapComposition[l].Over[A,Two.L.ring,LP.ring,setA,Two.L.set,LP.set,
  Two.L.inclusion,RightMap.hom,LP.inclusion,RightMap.constants] ;
 module SP = FiniteIdeal[l].Sums[DP.ring] ;
 module SB = FiniteIdeal[l].Sums[B.ring] ;
 module MapL = StandardOpens[l].SumMap[One.D.ring,DP.ring,PL.hom] ;
 module MapR = StandardOpens[l].SumMap[Two.D.ring,DP.ring,PR.hom] ;
 y (i : Fin n) : DP.Carrier = Both.y i ;
 -- y = h b and sum y c = g give g = h (sum b c).
 factor-out (h : DP.Carrier) (b c : Fin n -> DP.Carrier)
  (hy : (i : Fin n) -> Id DP.Carrier (y i) (DP.mulQ h (b i)))
  (g : DP.Carrier) (hg : Id DP.Carrier (SP.lin n y c) g) :
  Id DP.Carrier g (DP.mulQ h (SP.lin n b c)) =
  trans (sym hg)
   (trans (SP.sum-cong n (\ i -> DP.mulQ (y i) (c i)) (\ i -> DP.mulQ h (DP.mulQ (b i) (c i)))
     (\ i -> trans (ap (\ t -> DP.mulQ t (c i)) (hy i)) (sym (DP.mul-assoc h (b i) (c i)))))
    (SP.sum-scale h n (\ i -> DP.mulQ (b i) (c i)))) ;
 Compatible (d1 d2 : A.R) (p1 p2 : B.Carrier) : U l =
  (u : A.R) * (v : A.R) * S1 u * S2 v *
  Id B.Carrier (B.mulQ (B.constant (A.mul u v))
   (B.addQ (B.mulQ (B.constant d2) p1) (B.negQ (B.mulQ (B.constant d1) p2)))) B.zeroQ ;
 module Compare (c1 : One.Cleared) (c2 : Two.Cleared) {
  local1 : One.LocalPrincipal = c1.1 ;
  local2 : Two.LocalPrincipal = c2.1 ;
  lower1 : List LP.Carrier = PL.coefficients local1.1 ;
  lower2 : List LP.Carrier = PR.coefficients local2.1 ;
  monic1 : Id DP.Carrier (PL.hom.1 (One.HC.monic local1.1)) (Both.HC.monic lower1) = PL.monic local1.1 ;
  monic2 : Id DP.Carrier (PR.hom.1 (Two.HC.monic local2.1)) (Both.HC.monic lower2) = PR.monic local2.1 ;
  c1' (i : Fin n) : DP.Carrier = PL.hom.1 (local1.2.1 i) ;
  b1' (i : Fin n) : DP.Carrier = PL.hom.1 (local1.2.2.1 i) ;
  c2' (i : Fin n) : DP.Carrier = PR.hom.1 (local2.2.1 i) ;
  b2' (i : Fin n) : DP.Carrier = PR.hom.1 (local2.2.2.1 i) ;
  y1 (i : Fin n) : Id DP.Carrier (PL.hom.1 (One.y i)) (y i) = TL.pointwise (One.yB i) ;
  y2 (i : Fin n) : Id DP.Carrier (PR.hom.1 (Two.y i)) (y i) = TR.pointwise (Two.yB i) ;
  generated1 : Id DP.Carrier (SP.lin n y c1') (Both.HC.monic lower1) =
   trans (SP.sum-cong n (\ i -> DP.mulQ (y i) (c1' i)) (\ i -> DP.mulQ (PL.hom.1 (One.y i)) (c1' i))
     (\ i -> ap (\ t -> DP.mulQ t (c1' i)) (sym (y1 i))))
    (trans (sym (MapL.combination n One.y local1.2.1)) (trans (ap PL.hom.1 local1.2.2.2.1) monic1)) ;
  generated2 : Id DP.Carrier (SP.lin n y c2') (Both.HC.monic lower2) =
   trans (SP.sum-cong n (\ i -> DP.mulQ (y i) (c2' i)) (\ i -> DP.mulQ (PR.hom.1 (Two.y i)) (c2' i))
     (\ i -> ap (\ t -> DP.mulQ t (c2' i)) (sym (y2 i))))
    (trans (sym (MapR.combination n Two.y local2.2.1)) (trans (ap PR.hom.1 local2.2.2.2.1) monic2)) ;
  divides1 (i : Fin n) : Id DP.Carrier (y i) (DP.mulQ (Both.HC.monic lower1) (b1' i)) =
   trans (sym (y1 i))
    (trans (ap PL.hom.1 (local1.2.2.2.2 i))
     (trans (PL.hom.2.2.2 (One.HC.monic local1.1) (local1.2.2.1 i))
      (ap (\ t -> DP.mulQ t (b1' i)) monic1))) ;
  divides2 (i : Fin n) : Id DP.Carrier (y i) (DP.mulQ (Both.HC.monic lower2) (b2' i)) =
   trans (sym (y2 i))
    (trans (ap PR.hom.1 (local2.2.2.2.2 i))
     (trans (PR.hom.2.2.2 (Two.HC.monic local2.1) (local2.2.2.1 i))
      (ap (\ t -> DP.mulQ t (b2' i)) monic2))) ;
  module Unique = MonicUniqueness[l].Over[LP.ring,LP.set].Mutual[lower1,lower2,
   SP.lin n b1' c2',SP.lin n b2' c1',
   factor-out (Both.HC.monic lower1) b1' c2' divides1 (Both.HC.monic lower2) generated2,
   factor-out (Both.HC.monic lower2) b2' c1' divides2 (Both.HC.monic lower1) generated1] ;
  same : Id DP.Carrier (Both.HC.monic lower1) (Both.HC.monic lower2) = Unique.equality ;
  d1 : A.R = c1.2.1 ;
  d2 : A.R = c2.2.1 ;
  p1 : B.Carrier = SB.lin n One.yB c1.2.2.2.1 ;
  p2 : B.Carrier = SB.lin n Two.yB c2.2.2.2.1 ;
  scalar1 (a : A.R) : Id DP.Carrier (PL.hom.1 (One.Clearing.scalar a)) (Both.Clearing.scalar a) =
   trans (PL.Extension.on-constants (One.L.constant a)) (ap DP.constant (LeftMap.constants a)) ;
  scalar2 (a : A.R) : Id DP.Carrier (PR.hom.1 (Two.Clearing.scalar a)) (Both.Clearing.scalar a) =
   trans (PR.Extension.on-constants (Two.L.constant a)) (ap DP.constant (RightMap.constants a)) ;
  image1 : Id DP.Carrier (Both.hom p1) (DP.mulQ (Both.Clearing.scalar d1) (Both.HC.monic lower1)) =
   trans (sym (TL.pointwise p1))
    (trans (ap PL.hom.1 c1.2.2.2.2.1)
     (trans (PL.hom.2.2.2 (One.Clearing.scalar d1) (One.HC.monic local1.1))
      (cong2 DP.Carrier DP.mulQ _ _ _ _ (scalar1 d1) monic1))) ;
  image2 : Id DP.Carrier (Both.hom p2) (DP.mulQ (Both.Clearing.scalar d2) (Both.HC.monic lower1)) =
   trans (sym (TR.pointwise p2))
    (trans (ap PR.hom.1 c2.2.2.2.2.1)
     (trans (PR.hom.2.2.2 (Two.Clearing.scalar d2) (Two.HC.monic local2.1))
      (cong2 DP.Carrier DP.mulQ _ _ _ _ (scalar2 d2) (trans monic2 (sym same))))) ;
  first : B.Carrier = B.mulQ (B.constant d2) p1 ;
  second : B.Carrier = B.mulQ (B.constant d1) p2 ;
  difference : B.Carrier = B.addQ first (B.negQ second) ;
  agree : Id DP.Carrier (Both.hom first) (Both.hom second) =
   trans (Both.Clearing.on-scaled d2 p1)
    (trans (ap (DP.mulQ (Both.Clearing.scalar d2)) image1)
     (trans (RL[DP.ring].mul-swap (Both.Clearing.scalar d2) (Both.Clearing.scalar d1) (Both.HC.monic lower1))
      (sym (trans (Both.Clearing.on-scaled d1 p2) (ap (DP.mulQ (Both.Clearing.scalar d1)) image2))))) ;
  vanish : Id DP.Carrier (Both.hom difference) DP.zeroQ =
   trans (Both.Change.hom.2.2.1 first (B.negQ second))
    (trans (ap (DP.addQ (Both.hom first)) (RingHom[l].negation B.ring DP.ring Both.Change.hom second))
     (trans (ap (\ t -> DP.addQ t (DP.negQ (Both.hom second))) agree)
      (DP.add-neg (Both.hom second)))) ;
  from-kernel (k : Both.Clearing.Kernel difference) : Compatible d1 d2 p1 p2 =
   (k.2.1.1,k.2.1.2.1,k.2.1.2.2.1,k.2.1.2.2.2.1,
    trans (ap (\ s -> B.mulQ (B.constant s) difference) (sym k.2.1.2.2.2.2)) k.2.2) ;
  result : Tr.Trunc[Compatible d1 d2 p1 p2].carrier =
   Tr.Trunc[Both.Clearing.Kernel difference].induction @l
    (\ x -> Tr.Trunc[Compatible d1 d2 p1 p2].carrier)
    (\ x -> Tr.Trunc[Compatible d1 d2 p1 p2].proposition)
    (\ k -> Tr.Trunc[Compatible d1 d2 p1 p2].inc (from-kernel k))
    (Both.Clearing.kernel difference vanish) ;
 } ;
} ;
