-- Small rearrangements in an arbitrary commutative ring.
level l ; open Ring[l] ; open Presentations[l] ;
-- (a b)(x w) = (b x)(a w).
four (Rg : CRing) (a b x w : Rg.R) :
 Id Rg.R (Rg.mul (Rg.mul a b) (Rg.mul x w)) (Rg.mul (Rg.mul b x) (Rg.mul a w)) =
 trans (sym (Rg.mulA a b (Rg.mul x w)))
  (trans (ap (Rg.mul a) (Rg.mulA b x w))
   (RL[Rg].mul-swap a (Rg.mul b x) w)) ;
-- k (x - w) = 0 gives k x = k w.
cancel-difference (Rg : CRing) (k x w : Rg.R) (h : Id Rg.R (Rg.mul k (Rg.add x (Rg.neg w))) Rg.z) :
 Id Rg.R (Rg.mul k x) (Rg.mul k w) =
 let { h2 : Id Rg.R (Rg.add (Rg.mul k x) (Rg.neg (Rg.mul k w))) Rg.z =
        trans (sym (trans (Rg.dist k x (Rg.neg w)) (ap (Rg.add (Rg.mul k x)) (RL[Rg].mul-neg k w)))) h ; } in
 calc Rg.R {
  Rg.mul k x
   =< sym (Rg.addZ (Rg.mul k x)) > Rg.add (Rg.mul k x) Rg.z
   =< ap (Rg.add (Rg.mul k x)) (sym (trans (Rg.addC (Rg.neg (Rg.mul k w)) (Rg.mul k w)) (Rg.addN (Rg.mul k w))))
   > Rg.add (Rg.mul k x) (Rg.add (Rg.neg (Rg.mul k w)) (Rg.mul k w))
   =< Rg.addA (Rg.mul k x) (Rg.neg (Rg.mul k w)) (Rg.mul k w)
   > Rg.add (Rg.add (Rg.mul k x) (Rg.neg (Rg.mul k w))) (Rg.mul k w)
   =< ap (\ t -> Rg.add t (Rg.mul k w)) h2 > Rg.add Rg.z (Rg.mul k w)
   =< RL[Rg].zl (Rg.mul k w) > Rg.mul k w } ;
-- (a b)(c e) = (a c)(b e).
shuffle (Rg : CRing) (a b c e : Rg.R) :
 Id Rg.R (Rg.mul (Rg.mul a b) (Rg.mul c e)) (Rg.mul (Rg.mul a c) (Rg.mul b e)) =
 trans (sym (Rg.mulA a b (Rg.mul c e)))
  (trans (ap (Rg.mul a) (RL[Rg].mul-swap b c e)) (Rg.mulA a c (Rg.mul b e))) ;
