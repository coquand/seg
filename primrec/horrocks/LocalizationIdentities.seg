   =< (sym (Pr.ap R R (\ hole -> (add hole (mul (mul a (mul c (mul s t))) (mul s (mul t r))))) (mul (mul a (mul b (mul s r))) (mul s (mul t r))) (mul a (mul (mul b (mul s r)) (mul s (mul t r)))) (sym (mulA a (mul b (mul s r)) (mul s (mul t r)))))) > (add (mul (mul a (mul b (mul s r))) (mul s (mul t r))) (mul (mul a (mul c (mul s t))) (mul s (mul t r))))
   =< (sym (dist-left (mul a (mul b (mul s r))) (mul a (mul c (mul s t))) (mul s (mul t r)))) > (mul (add (mul a (mul b (mul s r))) (mul a (mul c (mul s t)))) (mul s (mul t r)))
   =< (sym (Pr.ap R R (\ hole -> (mul (add (mul a (mul b (mul s r))) hole) (mul s (mul t r)))) (mul (mul a c) (mul s t)) (mul a (mul c (mul s t))) (sym (mulA a c (mul s t))))) > (mul (add (mul a (mul b (mul s r))) (mul (mul a c) (mul s t))) (mul s (mul t r)))
   =< (sym (Pr.ap R R (\ hole -> (mul (add hole (mul (mul a c) (mul s t))) (mul s (mul t r)))) (mul (mul a b) (mul s r)) (mul a (mul b (mul s r))) (sym (mulA a b (mul s r))))) > (mul (add (mul (mul a b) (mul s r)) (mul (mul a c) (mul s t))) (mul s (mul t r)))
 } ;
 constant-add (a b c s t r : R) : Id R (mul (add a b) (mul o o)) (mul (add (mul a o) (mul b o)) o) = calc R {
  (mul (add a b) (mul o o))
   =< (Pr.ap R R (\ hole -> (mul (add a b) hole)) (mul o o) o (mulO o)) > (mul (add a b) o)
   =< (mulO (add a b)) > (add a b)
   =< (sym (mulO (add a b))) > (mul (add a b) o)
   =< (sym (Pr.ap R R (\ hole -> (mul (add a hole) o)) (mul b o) b (mulO b))) > (mul (add a (mul b o)) o)
   =< (sym (Pr.ap R R (\ hole -> (mul (add hole (mul b o)) o)) (mul a o) a (mulO a))) > (mul (add (mul a o) (mul b o)) o)
 } ;
 constant-mul (a b c s t r : R) : Id R (mul (mul a b) (mul o o)) (mul (mul a b) o) = calc R {
  (mul (mul a b) (mul o o))
   =< (Pr.ap R R (\ hole -> (mul (mul a b) hole)) (mul o o) o (mulO o)) > (mul (mul a b) o)
   =< (mulO (mul a b)) > (mul a b)
   =< (sym (mulO (mul a b))) > (mul (mul a b) o)
 } ;
 inverse (a b c s t r : R) : Id R (mul (mul a o) o) (mul o (mul o a)) = calc R {
  (mul (mul a o) o)
   =< (Pr.ap R R (\ hole -> (mul hole o)) (mul a o) a (mulO a)) > (mul a o)
   =< (mulO a) > a
   =< (sym (trans (mulC o a) (mulO a))) > (mul o a)
   =< (sym (Pr.ap R R (\ hole -> (mul o hole)) (mul o a) a (trans (mulC o a) (mulO a)))) > (mul o (mul o a))
 } ;
} ;
